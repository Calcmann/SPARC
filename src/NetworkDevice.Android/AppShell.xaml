<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="NetworkDevice.Android.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:NetworkDevice.Android.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="SPARC Mobile">

    <TabBar>
        <Tab Title="Ativação">
            <ShellContent ContentTemplate="{DataTemplate views:ProvisioningPage}" Route="ProvisioningPage" />
        </Tab>
        <Tab Title="Console CLI">
            <ShellContent ContentTemplate="{DataTemplate views:TerminalPage}" Route="TerminalPage" />
        </Tab>
        <Tab Title="Firmware &amp; WAN">
            <ShellContent ContentTemplate="{DataTemplate views:FirmwarePage}" Route="FirmwarePage" />
        </Tab>
        <Tab Title="Quebra Senha">
            <ShellContent ContentTemplate="{DataTemplate views:RecoveryPage}" Route="RecoveryPage" />
        </Tab>
        <Tab x:Name="TabY1564" Title="Y.1564 / SLA" IsVisible="False">
            <ShellContent ContentTemplate="{DataTemplate views:Y1564Page}" Route="Y1564Page" />
        </Tab>
        <Tab Title="Histórico">
            <ShellContent ContentTemplate="{DataTemplate views:ReportsHistoryPage}" Route="ReportsHistoryPage" />
        </Tab>
    </TabBar>

</Shell>

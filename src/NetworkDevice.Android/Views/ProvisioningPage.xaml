<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NetworkDevice.Android.Views.ProvisioningPage"
             Title="Ativação"
             BackgroundColor="#18181B">
    <Grid>
        <!-- ========================================================================= -->
        <!-- 1. TELA INICIAL: DEFINIÇÃO DE INSUMOS DO CIRCUITO                          -->
        <!-- ========================================================================= -->
        <ScrollView x:Name="ViewTelaInicial" IsVisible="True">
            <VerticalStackLayout Padding="14" Spacing="12">
                <!-- CABEÇALHO CLARO S.A. -->
                <Frame BackgroundColor="#27272A" BorderColor="#52525B" CornerRadius="10" Padding="12" HasShadow="False">
                    <VerticalStackLayout Spacing="6">
                        <!-- Badge Beta -->
                        <Border BackgroundColor="#881337" Stroke="#B91C1C" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10, 4" HorizontalOptions="Center">
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="🔴" FontSize="11" VerticalOptions="Center" />
                                <Label Text="VERSÃO BETA — CLARO S.A. — ATIVAÇÃO SC" FontSize="11" FontAttributes="Bold" TextColor="#FFFFFF" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                        <Label x:Name="TitleSparcMobileLabel" Text="SPARC Mobile" FontSize="20" FontAttributes="Bold" TextColor="#EE1C25" HorizontalTextAlignment="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTitleSparcMobileTapped" NumberOfTapsRequired="1" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Label Text="Configure o equipamento, informe os dados e escolha como deseja executar o provisionamento."
                               FontSize="11.5" TextColor="#A1A1AA" HorizontalTextAlignment="Center" />

                        <!-- Identificação do Técnico e Atalhos Rápidos -->
                        <Border BackgroundColor="#18181B" Stroke="#3F3F46" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="8, 4" Margin="0, 4, 0, 0">
                            <Grid ColumnDefinitions="Auto, *">
                                <Label Grid.Column="0" x:Name="TechnicianBadgeLabel" Text="👤 Técnico" FontSize="11" FontAttributes="Bold" TextColor="#4ADE80" VerticalOptions="Center" Margin="0,0,6,0" />
                                <Label Grid.Column="1" x:Name="TechnicianDetailsLabel" Text="Identificação pendente" FontSize="10.5" TextColor="#94A3B8" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                            </Grid>
                        </Border>

                        <Grid ColumnDefinitions="*, *, *" ColumnSpacing="6" Margin="0, 2, 0, 0">
                            <Button Grid.Column="0" Text="📑 Histórico" Clicked="OnNavigateHistoricoClicked" BackgroundColor="#1E293B" TextColor="#38BDF8" CornerRadius="6" FontSize="11" HeightRequest="30" Padding="4,0" />
                            <Button Grid.Column="1" Text="🔄 Atualizar" Clicked="OnCheckAppUpdateClicked" BackgroundColor="#1E293B" TextColor="#FBBF24" CornerRadius="6" FontSize="11" HeightRequest="30" Padding="4,0" />
                            <Button Grid.Column="2" Text="👤 Perfil" Clicked="OnNavigateActivationClicked" BackgroundColor="#1E293B" TextColor="#4ADE80" CornerRadius="6" FontSize="11" HeightRequest="30" Padding="4,0" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- ======================================================== -->
                <!-- PASSO 1: EQUIPAMENTO & PORTA SERIAL                      -->
                <!-- ======================================================== -->
                <Frame BackgroundColor="#27272A" BorderColor="#52525B" CornerRadius="8" Padding="14" HasShadow="False">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Border Grid.Column="0" BackgroundColor="#B91C1C" StrokeShape="RoundRectangle 12" WidthRequest="24" HeightRequest="24" Margin="0,0,8,0">
                                <Label Text="1" FontAttributes="Bold" FontSize="12" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="Equipamento &amp; Porta Serial" FontAttributes="Bold" FontSize="13.5" TextColor="#EE1C25" />
                                <Label Text="• Conexão OTG e modelo do hardware" FontSize="11" TextColor="#71717A" />
                            </VerticalStackLayout>
                            <Border Grid.Column="2" BackgroundColor="#3B1818" StrokeShape="RoundRectangle 4" Padding="6, 2" VerticalOptions="Center">
                                <Label x:Name="TxtBadgeStep1" Text="🔴 Pendente" FontSize="10.5" FontAttributes="Bold" TextColor="#FCA5A5" />
                            </Border>
                        </Grid>

                        <!-- Seletor de USB OTG -->
                        <Label Text="Porta Serial USB (OTG):" FontSize="11" FontAttributes="Bold" TextColor="#A1A1AA" />
                        <Picker x:Name="UsbDevicePicker" Title="Selecione o Adaptador Serial USB" TextColor="White" TitleColor="#94A3B8" BackgroundColor="#18181B" FontSize="12" />

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                            <Button Grid.Column="0" Text="🔄 Escanear USB" Clicked="OnScanUsbClicked" BackgroundColor="#3F3F46" TextColor="White" CornerRadius="6" FontSize="12" HeightRequest="36" />
                            <Button Grid.Column="1" x:Name="ConnectUsbBtn" Text="🔌 Conectar USB" Clicked="OnConnectUsbClicked" BackgroundColor="#059669" TextColor="White" CornerRadius="6" FontAttributes="Bold" FontSize="12" HeightRequest="36" />
                        </Grid>

                        <Label x:Name="UsbStatusLabel" Text="Conecte o cabo USB OTG ao roteador e clique em Escanear." FontSize="10.5" TextColor="#71717A" />

                        <!-- Seletor de Modelo Homologado -->
                        <Label Text="Modelo do Equipamento:" FontSize="11" FontAttributes="Bold" TextColor="#A1A1AA" Margin="0, 4, 0, 0" />
                        <Picker x:Name="ModelPicker" Title="— Selecione o modelo do equipamento —" TextColor="White" TitleColor="#94A3B8" BackgroundColor="#18181B" FontSize="12" SelectedIndexChanged="OnModelPickerSelectedIndexChanged">
                            <Picker.Items>
                                <x:String>🖧 HPE MSR 954 / 958 (Ctrl+B @ 9600 - BootWare)</x:String>
                                <x:String>🖧 HPE MSR 930 / 931 / 935 (Ctrl+B @ 9600 - BootWare)</x:String>
                                <x:String>🖧 HPE MSR 1002 / 1003 (Ctrl+B @ 9600 - BootWare)</x:String>
                                <x:String>🖧 Cisco Série 1900 / 1921 / 1941 / 1905 (Break @ 9600 - ROMMON)</x:String>
                                <x:String>🖧 Cisco Série 900 / C921-4P (Ctrl+C Puro @ 9600)</x:String>
                                <x:String>🖧 Cisco Série 800 / C841M (Break @ 9600 - ROMMON)</x:String>
                                <x:String>🛡️ Fortinet FortiGate 40F (FortiOS @ 9600 - Console)</x:String>
                            </Picker.Items>
                        </Picker>

                        <!-- Botão Testar / Identificar -->
                        <Button x:Name="IdentifyBtn" Text="⚡ Testar Conexão / Identificar Equipamento" Clicked="OnIdentifyClicked" BackgroundColor="#B91C1C" TextColor="White" CornerRadius="6" FontAttributes="Bold" FontSize="12" HeightRequest="38" />

                        <!-- Detalhes Identificados -->
                        <Border BackgroundColor="#18181B" Stroke="#3F3F46" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="10">
                            <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto, Auto, Auto" RowSpacing="4" ColumnSpacing="8">
                                <Label Grid.Row="0" Grid.Column="0" Text="Fabricante / Modelo:" TextColor="#94A3B8" FontSize="11" />
                                <Label Grid.Row="0" Grid.Column="1" x:Name="ModelLabel" Text="Não identificado" TextColor="#38BDF8" FontAttributes="Bold" FontSize="11" />

                                <Label Grid.Row="1" Grid.Column="0" Text="Taxa Serial:" TextColor="#94A3B8" FontSize="11" />
                                <Label Grid.Row="1" Grid.Column="1" x:Name="BaudLabel" Text="9600 bps" TextColor="#FBBF24" FontSize="11" />

                                <Label Grid.Row="2" Grid.Column="0" Text="Estado Operacional:" TextColor="#94A3B8" FontSize="11" />
                                <Label Grid.Row="2" Grid.Column="1" x:Name="StateLabel" Text="Aguardando teste" TextColor="#E2E8F0" FontSize="11" />

                                <Label Grid.Row="3" Grid.Column="0" Text="Prompt Detectado:" TextColor="#94A3B8" FontSize="11" />
                                <Label Grid.Row="3" Grid.Column="1" x:Name="PromptLabel" Text="-" TextColor="#4ADE80" FontSize="11" LineBreakMode="TailTruncation" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Frame>

                <!-- ======================================================== -->
                <!-- PASSO 2: DADOS DO CIRCUITO (FICHA SAIP)                  -->
                <!-- ======================================================== -->
                <Frame BackgroundColor="#27272A" BorderColor="#52525B" CornerRadius="8" Padding="14" HasShadow="False">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Border Grid.Column="0" BackgroundColor="#B91C1C" StrokeShape="RoundRectangle 12" WidthRequest="24" HeightRequest="24" Margin="0,0,8,0">
                                <Label Text="2" FontAttributes="Bold" FontSize="12" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="Dados do Circuito" FontAttributes="Bold" FontSize="13.5" TextColor="#EE1C25" />
                                <Label Text="• Importar Ficha SAIP ou colar dados" FontSize="11" TextColor="#71717A" />
                            </VerticalStackLayout>
                            <Border Grid.Column="2" BackgroundColor="#3B1818" StrokeShape="RoundRectangle 4" Padding="6, 2" VerticalOptions="Center">
                                <Label x:Name="TxtBadgeStep2" Text="🔴 Pendente" FontSize="10.5" FontAttributes="Bold" TextColor="#FCA5A5" />
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="*, *, *" ColumnSpacing="6">
                            <Button Grid.Column="0" Text="📂 PDF" Clicked="OnLoadPdfClicked" BackgroundColor="#2563EB" TextColor="White" CornerRadius="6" FontSize="11.5" HeightRequest="38" />
                            <Button Grid.Column="1" Text="📋 Colar" Clicked="OnPasteSaipClicked" BackgroundColor="#0D9488" TextColor="White" CornerRadius="6" FontSize="11.5" HeightRequest="38" />
                            <Button Grid.Column="2" Text="✏️ Ajustar" Clicked="OnToggleManualEditClicked" BackgroundColor="#4F46E5" TextColor="White" CornerRadius="6" FontSize="11.5" HeightRequest="38" />
                        </Grid>

                        <!-- Preview dos Dados do Circuito -->
                        <Border x:Name="CircuitDetailsLayout" BackgroundColor="#18181B" Stroke="#3F3F46" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="10" IsVisible="False">
                            <VerticalStackLayout Spacing="4">
                                <Label x:Name="SaipClientLabel" Text="Cliente: -" TextColor="White" FontAttributes="Bold" FontSize="12" />
                                <Label x:Name="SaipCircuitLabel" Text="Designação / OTS: -" TextColor="#94A3B8" FontSize="11" />
                                <Label x:Name="SaipWanLabel" Text="WAN: -" TextColor="#38BDF8" FontSize="11" />
                                <Label x:Name="SaipLanLabel" Text="LAN: -" TextColor="#4ADE80" FontSize="11" />
                                <Label x:Name="SaipBandwidthLabel" Text="Banda Nominal: -" TextColor="#FBBF24" FontSize="11" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Painel de Edição Manual de Parâmetros (Paridade com Windows) -->
                        <Border x:Name="ManualEditCard" BackgroundColor="#1E1B4B" Stroke="#4338CA" StrokeThickness="1.5" StrokeShape="RoundRectangle 6" Padding="10" IsVisible="False">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="✏️ Edição Manual de Parâmetros de Circuito" FontSize="12" FontAttributes="Bold" TextColor="#A5B4FC" />

                                <Grid ColumnDefinitions="*, *" ColumnSpacing="6">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="Cliente / Razão Social:" FontSize="10.5" TextColor="#C7D2FE" />
                                        <Entry x:Name="EditClienteEntry" Placeholder="Razão Social" TextColor="White" BackgroundColor="#0F172A" FontSize="11" HeightRequest="34" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="Designação IP:" FontSize="10.5" TextColor="#C7D2FE" />
                                        <Entry x:Name="EditDesignacaoEntry" Placeholder="Ex: SAO-IP-12345" TextColor="White" BackgroundColor="#0F172A" FontSize="11" HeightRequest="34" />
                                    </VerticalStackLayout>
                                </Grid>

                                <Grid ColumnDefinitions="*, *" ColumnSpacing="6">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="IP WAN (com máscara /30):" FontSize="10.5" TextColor="#C7D2FE" />
                                        <Entry x:Name="EditWanIpEntry" Placeholder="Ex: 201.90.204.22/30" TextColor="White" BackgroundColor="#0F172A" FontSize="11" HeightRequest="34" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="Gateway WAN (PE):" FontSize="10.5" TextColor="#C7D2FE" />
                                        <Entry x:Name="EditWanGwEntry" Placeholder="Ex: 201.90.204.21" TextColor="White" BackgroundColor="#0F172A" FontSize="11" HeightRequest="34" />
                                    </VerticalStackLayout>
                                </Grid>

                                <Grid ColumnDefinitions="*, *" ColumnSpacing="6">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="IP LAN (com máscara /29):" FontSize="10.5" TextColor="#C7D2FE" />
                                        <Entry x:Name="EditLanIpEntry" Placeholder="Ex: 200.182.245.17/29" TextColor="White" BackgroundColor="#0F172A" FontSize="11" HeightRequest="34" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="Host LAN (IP Teste):" FontSize="10.5" TextColor="#C7D2FE" />
                                        <Entry x:Name="EditHostLanEntry" Placeholder="Ex: 200.182.245.18" TextColor="White" BackgroundColor="#0F172A" FontSize="11" HeightRequest="34" />
                                    </VerticalStackLayout>
                                </Grid>

                                <Grid ColumnDefinitions="*, *" ColumnSpacing="6">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="Banda Nominal (Mbps):" FontSize="10.5" TextColor="#C7D2FE" />
                                        <Entry x:Name="EditBandaEntry" Placeholder="Ex: 50" TextColor="White" BackgroundColor="#0F172A" FontSize="11" HeightRequest="34" Keyboard="Numeric" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="Número OTS:" FontSize="10.5" TextColor="#C7D2FE" />
                                        <Entry x:Name="EditOtsEntry" Placeholder="Ex: 1234567" TextColor="White" BackgroundColor="#0F172A" FontSize="11" HeightRequest="34" />
                                    </VerticalStackLayout>
                                </Grid>

                                <Grid ColumnDefinitions="*, *" ColumnSpacing="6" Margin="0,4,0,0">
                                    <Button Grid.Column="0" Text="✕ Cancelar" Clicked="OnCancelManualEditClicked" BackgroundColor="#334155" TextColor="White" CornerRadius="6" FontSize="11" HeightRequest="34" />
                                    <Button Grid.Column="1" Text="💾 Salvar Parâmetros" Clicked="OnSaveManualEditClicked" BackgroundColor="#059669" TextColor="White" CornerRadius="6" FontSize="11" HeightRequest="34" FontAttributes="Bold" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Frame>

                <!-- ======================================================== -->
                <!-- PASSO 3: EXECUÇÃO DO PROVISIONAMENTO                     -->
                <!-- ======================================================== -->
                <Frame BackgroundColor="#27272A" BorderColor="#52525B" CornerRadius="8" Padding="14" HasShadow="False">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="Auto, *">
                            <Border Grid.Column="0" BackgroundColor="#B91C1C" StrokeShape="RoundRectangle 12" WidthRequest="24" HeightRequest="24" Margin="0,0,8,0">
                                <Label Text="3" FontAttributes="Bold" FontSize="12" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="Execução do Provisionamento" FontAttributes="Bold" FontSize="13.5" TextColor="#EE1C25" />
                                <Label Text="• Escolha o modo e inicie a ativação" FontSize="11" TextColor="#71717A" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Opções avançadas -->
                        <HorizontalStackLayout Spacing="6">
                            <CheckBox x:Name="ChkAtualizarFirmwareAuto" IsChecked="True" Color="#EE1C25" />
                            <Label Text="Atualizar Firmware se disponível" FontSize="11.5" TextColor="#E4E4E7" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <!-- Opção Especial Oculta por Padrão: NAT LAB -->
                        <HorizontalStackLayout x:Name="LayoutNatLab" Spacing="6" IsVisible="False">
                            <CheckBox x:Name="ChkNatLab" IsChecked="False" Color="#EE1C25" />
                            <Label Text="🌐 Habilitar NAT (LAB) — bancada" FontSize="11.5" TextColor="#FCA5A5" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <!-- BOTÃO PRINCIPAL DE DESTAQUE: INICIAR PROVISIONAMENTO -->
                        <Button x:Name="BtnIniciarModoAutomatico"
                                Text="⚡ Iniciar Provisionamento"
                                Clicked="OnIniciarModoAutomaticoClicked"
                                BackgroundColor="#EE1C25"
                                TextColor="White"
                                CornerRadius="8"
                                FontAttributes="Bold"
                                FontSize="13.5"
                                HeightRequest="48"
                                Margin="0, 4, 0, 0" />

                        <!-- Ferramentas Complementares -->
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="8" Margin="0, 4, 0, 0">
                            <Button Grid.Column="0" Text="🖥️ Terminal CLI" Clicked="OnAbrirTerminalClicked" BackgroundColor="#3F3F46" TextColor="White" CornerRadius="6" FontSize="11" HeightRequest="36" />
                            <Button Grid.Column="1" Text="🛠️ Quebra Senha" Clicked="OnAbrirRecuperacaoClicked" BackgroundColor="#881337" TextColor="White" CornerRadius="6" FontSize="11" HeightRequest="36" />
                        </Grid>
                        <!-- Botão Especial Oculto por Padrão: Analisador Y.1564 -->
                        <Button x:Name="BtnAnalisadorDados" Text="📊 Analisador de Dados (Y.1564 / Loop VIAVI)" Clicked="OnAbrirAnalisadorClicked" BackgroundColor="#0284C7" TextColor="White" CornerRadius="6" FontAttributes="Bold" FontSize="11" HeightRequest="36" Margin="0, 4, 0, 0" IsVisible="False" />
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>

        <!-- ========================================================================= -->
        <!-- 2. TELA MODO AUTOMÁTICO GERAL: STATUS POR ETAPA 1 A 7                      -->
        <!-- ========================================================================= -->
        <ScrollView x:Name="ViewModoAutomatico" IsVisible="False">
            <VerticalStackLayout Padding="14" Spacing="12">
                <Frame BackgroundColor="#27272A" BorderColor="#52525B" CornerRadius="10" Padding="14" HasShadow="False">
                    <VerticalStackLayout Spacing="10">
                        <!-- Badge Topo -->
                        <Border BackgroundColor="#881337" Stroke="#B91C1C" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10, 4" HorizontalOptions="Center">
                            <Label Text="🔴 VERSÃO BETA — CLARO S.A. — ATIVAÇÃO SC" FontSize="11" FontAttributes="Bold" TextColor="#FFFFFF" />
                        </Border>

                        <Label Text="⚡ PROVISIONAMENTO EM EXECUÇÃO" FontSize="18" FontAttributes="Bold" TextColor="#EE1C25" HorizontalTextAlignment="Center" />
                        <Label x:Name="TxtAutoStatusGeral" Text="Preparando..." FontSize="13" TextColor="#A1A1AA" HorizontalTextAlignment="Center" />

                        <!-- Barra de Progresso Geral -->
                        <ProgressBar x:Name="PbAutoGeral" Progress="0" ProgressColor="#EE1C25" HeightRequest="10" />
                        <Label x:Name="TxtAutoPorcentagem" Text="0%" FontAttributes="Bold" TextColor="#EE1C25" HorizontalTextAlignment="Center" FontSize="13" />

                        <!-- Checklist das 7 Etapas -->
                        <Border BackgroundColor="#18181B" Stroke="#3F3F46" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12">
                            <VerticalStackLayout Spacing="8">
                                <Label x:Name="LblAutoEtapa1" Text="○ 1. Zerar Configuração — aguardando" TextColor="#64748B" FontSize="12.5" />
                                <Label x:Name="LblAutoEtapa2" Text="○ 2. Atualizar Firmware — aguardando" TextColor="#64748B" FontSize="12.5" />
                                <Label x:Name="LblAutoEtapa3" Text="○ 3. Provisionar Equipamento — aguardando" TextColor="#64748B" FontSize="12.5" />
                                <Label x:Name="LblAutoEtapa4" Text="○ 4. Configurar IP de Teste — aguardando" TextColor="#64748B" FontSize="12.5" />
                                <Label x:Name="LblAutoEtapa5" Text="○ 5. Testar Conectividade (ICMP) — aguardando" TextColor="#64748B" FontSize="12.5" />
                                <Label x:Name="LblAutoEtapa6" Text="○ 6. Testar Acesso Remoto (Telnet / SSH) — aguardando" TextColor="#64748B" FontSize="12.5" />
                                <Label x:Name="LblAutoEtapa7" Text="○ 7. Testar Banda (Vazão vs Nominal) — aguardando" TextColor="#64748B" FontSize="12.5" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Assistente Interativo: Troca de Adaptador Console ➔ Ethernet OTG -->
                        <Frame x:Name="FrameTrocaAdaptador" BackgroundColor="#1E1B4B" BorderColor="#6366F1" CornerRadius="10" Padding="14" HasShadow="False" IsVisible="False">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
                                    <Border Grid.Column="0" BackgroundColor="#312E81" Stroke="#4F46E5" StrokeThickness="1" StrokeShape="RoundRectangle 8" WidthRequest="38" HeightRequest="38" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label Text="🔄" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="TROCA DE ADAPTADOR REQUERIDA" FontSize="13" FontAttributes="Bold" TextColor="#A5B4FC" />
                                        <Label Text="Configuração básica gravada com sucesso via Console!" FontSize="11" TextColor="#E0E7FF" />
                                    </VerticalStackLayout>
                                </Grid>

                                <BoxView HeightRequest="1" Color="#4338CA" Margin="0, 2" />

                                <Label Text="Para prosseguir com os testes de rede e acesso Telnet:" FontSize="11.5" FontAttributes="Bold" TextColor="#F8FAFC" />
                                <VerticalStackLayout Spacing="5" Margin="4, 0">
                                    <Label Text="1️⃣ Desconecte o cabo Console USB do celular." FontSize="11" TextColor="#CBD5E1" />
                                    <Label Text="2️⃣ Conecte o Adaptador USB-Ethernet (RJ45) no celular." FontSize="11" TextColor="#CBD5E1" />
                                    <Label Text="3️⃣ Conecte o cabo de rede RJ45 em uma porta LAN do roteador." FontSize="11" TextColor="#CBD5E1" />
                                </VerticalStackLayout>

                                <!-- Parâmetros de IP Estático da LAN -->
                                <Border BackgroundColor="#0F172A" Stroke="#38BDF8" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="10">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="CONFIGURAÇÃO DE IP ESTÁTICO (ROTEADOR ESTÁTICO):" FontSize="10.5" FontAttributes="Bold" TextColor="#FBBF24" />
                                        <Label x:Name="LblTrocaEthIpInfo" Text="IP Celular: 200.250.153.42 | Gateway (Roteador): 200.250.153.41" FontSize="11" FontAttributes="Bold" TextColor="#38BDF8" />
                                        <Label x:Name="LblTrocaEthMaskInfo" Text="Máscara: 255.255.255.248 (/29) • DNS: 1.1.1.1" FontSize="10.5" TextColor="#94A3B8" />
                                    </VerticalStackLayout>
                                </Border>

                                <!-- Ações de Configuração no Android -->
                                <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                                    <Button x:Name="BtnCopiarIpEth" Text="📋 Copiar IP Estático" Clicked="OnCopiarParametrosIpClicked" BackgroundColor="#334155" TextColor="#F8FAFC" CornerRadius="6" FontSize="10.5" HeightRequest="36" />
                                    <Button Text="⚙️ Configurações Ethernet" Clicked="OnAbrirConfigEthernetClicked" BackgroundColor="#1E293B" TextColor="#38BDF8" CornerRadius="6" FontSize="10.5" HeightRequest="36" />
                                </Grid>

                                <!-- Detecção Automática em Tempo Real -->
                                <Border BackgroundColor="#0F172A" Stroke="#334155" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="10">
                                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8" VerticalOptions="Center">
                                        <ActivityIndicator Grid.Column="0" x:Name="IndicatorTrocaEth" IsRunning="True" Color="#38BDF8" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                                        <Label Grid.Column="1" x:Name="LblStatusTrocaEth" Text="Aguardando conexão do adaptador Ethernet RJ45..." FontSize="10.5" TextColor="#38BDF8" VerticalOptions="Center" />
                                    </Grid>
                                </Border>

                                <!-- Botões de Ação do Técnico -->
                                <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                                    <Button Grid.Column="0" x:Name="BtnTrocaEthConfirmar" Text="🔌 Iniciar Testes de Rede" Clicked="OnTrocaEthConfirmarClicked" BackgroundColor="#16A34A" TextColor="White" CornerRadius="6" FontAttributes="Bold" FontSize="11" HeightRequest="38" />
                                    <Button Grid.Column="1" x:Name="BtnTrocaEthPular" Text="⏭ Pular Testes Ethernet" Clicked="OnTrocaEthPularClicked" BackgroundColor="#475569" TextColor="White" CornerRadius="6" FontSize="11" HeightRequest="38" />
                                </Grid>
                            </VerticalStackLayout>
                        </Frame>

                        <!-- Botões de Ação na Execução / Pós-Execução -->
                        <VerticalStackLayout Spacing="8" Margin="0, 4, 0, 0">
                            <Button x:Name="BtnAutoCancelar" Text="✖ Cancelar Execução" Clicked="OnAutoCancelarClicked" BackgroundColor="#B91C1C" TextColor="White" CornerRadius="6" FontAttributes="Bold" HeightRequest="40" FontSize="12" />

                            <Button x:Name="BtnAutoCompartilharRelatorio" Text="📄 Compartilhar Relatório de Ativação (PDF / WhatsApp)" Clicked="OnAutoCompartilharRelatorioClicked" BackgroundColor="#0D9488" TextColor="White" CornerRadius="6" FontAttributes="Bold" HeightRequest="44" FontSize="12.5" IsVisible="False" />

                            <Button x:Name="BtnAutoCertidaoY1564" Text="📜 CERTIDÃO DE NASCIMENTO - Y.1564" Clicked="OnAutoCertidaoY1564Clicked" BackgroundColor="#DC2626" TextColor="White" CornerRadius="6" FontAttributes="Bold" HeightRequest="44" FontSize="12.5" IsVisible="False" />

                            <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                                <Button Grid.Column="0" x:Name="BtnAutoVerScript" Text="📝 Ver Script TXT" Clicked="OnAutoVerScriptClicked" BackgroundColor="#3F3F46" TextColor="White" CornerRadius="6" FontSize="11" HeightRequest="36" IsVisible="False" />
                                <Button Grid.Column="1" x:Name="BtnAutoRetestarBanda" Text="🔄 Re-testar Banda" Clicked="OnAutoRetestarBandaClicked" BackgroundColor="#D97706" TextColor="White" CornerRadius="6" FontSize="11" HeightRequest="36" IsVisible="False" />
                            </Grid>

                            <Button x:Name="BtnAutoVoltar" Text="← Voltar à Tela Inicial" Clicked="OnAutoVoltarClicked" BackgroundColor="#64748B" TextColor="White" CornerRadius="6" FontAttributes="Bold" HeightRequest="40" FontSize="12" IsVisible="False" />
                        </VerticalStackLayout>

                        <!-- Terminal / Log Console em Tempo Real -->
                        <Label Text="Log da Execução Automática:" FontSize="11" FontAttributes="Bold" TextColor="#A1A1AA" Margin="0, 6, 0, 0" />
                        <Border BackgroundColor="#0A0E14" Stroke="#3F3F46" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="6">
                            <Editor x:Name="TxtAutoLog" HeightRequest="180" IsReadOnly="True" BackgroundColor="#0A0E14" TextColor="#4ADE80" FontFamily="OpenSansRegular" FontSize="10.5" Text="Aguardando início do Modo Automático..." />
                        </Border>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

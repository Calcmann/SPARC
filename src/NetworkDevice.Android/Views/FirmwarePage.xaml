<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NetworkDevice.Android.Views.FirmwarePage"
             Title="Firmware">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Frame BackgroundColor="#1E293B" CornerRadius="12" Padding="14" HasShadow="True">
                <VerticalStackLayout Spacing="4">
                    <Label Text="SPARC Mobile • Atualização de Firmware" FontSize="16" FontAttributes="Bold" TextColor="#38BDF8" />
                    <Label Text="Cisco via HTTP (8080) • HPE/Fortinet via FTP (2121) • CLI híbrida Telnet/console" FontSize="11" TextColor="#94A3B8" />
                </VerticalStackLayout>
            </Frame>

            <!-- 0. Fabricante -->
            <Frame BackgroundColor="#0F172A" CornerRadius="12" Padding="14" BorderColor="#334155">
                <VerticalStackLayout Spacing="10">
                    <Label Text="0. Fabricante (auto pela detecção)" FontSize="14" FontAttributes="Bold" TextColor="#F8FAFC" />
                    <Picker x:Name="VendorPicker" Title="Selecione o fabricante" TextColor="White" TitleColor="#94A3B8" BackgroundColor="#1E293B" SelectedIndexChanged="OnVendorChanged" />
                </VerticalStackLayout>
            </Frame>

            <!-- 1. Arquivo -->
            <Frame BackgroundColor="#0F172A" CornerRadius="12" Padding="14" BorderColor="#334155">
                <VerticalStackLayout Spacing="10">
                    <Label Text="1. Imagem IOS (.bin)" FontSize="14" FontAttributes="Bold" TextColor="#F8FAFC" />
                    <Button x:Name="PickFwBtn" Text="📂 Selecionar Firmware" Clicked="OnPickFirmwareClicked" BackgroundColor="#2563EB" TextColor="White" CornerRadius="8" FontSize="12" HeightRequest="38" />
                    <Label x:Name="FwInfoLabel" Text="Nenhum arquivo selecionado." FontSize="11" TextColor="#64748B" />
                    <Label x:Name="FwCompatLabel" Text="" FontSize="11" FontAttributes="Bold" TextColor="#94A3B8" />
                    <Entry x:Name="Md5Entry" Placeholder="MD5 esperado (opcional)" TextColor="White" BackgroundColor="#1E293B" FontSize="12" />
                </VerticalStackLayout>
            </Frame>

            <!-- 2. Rede -->
            <Frame BackgroundColor="#0F172A" CornerRadius="12" Padding="14" BorderColor="#334155">
                <VerticalStackLayout Spacing="10">
                    <Label Text="2. Rede (adaptador Ethernet OTG na LAN)" FontSize="14" FontAttributes="Bold" TextColor="#F8FAFC" />
                    <Label Text="IP do celular nesta rede:" FontSize="11" TextColor="#94A3B8" />
                    <Picker x:Name="PhoneIpPicker" Title="Selecione o IP do celular" TextColor="White" TitleColor="#94A3B8" BackgroundColor="#1E293B" />
                    <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto, Auto, Auto" RowSpacing="8" ColumnSpacing="10">
                        <Label Grid.Row="0" Grid.Column="0" Text="IP roteador:" TextColor="#94A3B8" FontAttributes="Bold" FontSize="12" VerticalOptions="Center" />
                        <Entry Grid.Row="0" Grid.Column="1" x:Name="RouterIpEntry" Placeholder="Ex: 192.168.10.1" TextColor="White" BackgroundColor="#1E293B" FontSize="13" Keyboard="Numeric" />
                        <Label Grid.Row="1" Grid.Column="0" Text="Telnet user:" TextColor="#94A3B8" FontAttributes="Bold" FontSize="12" VerticalOptions="Center" />
                        <Entry Grid.Row="1" Grid.Column="1" x:Name="TelnetUserEntry" Placeholder="EBT" Text="EBT" TextColor="White" BackgroundColor="#1E293B" FontSize="13" />
                        <Label Grid.Row="2" Grid.Column="0" Text="Telnet pass:" TextColor="#94A3B8" FontAttributes="Bold" FontSize="12" VerticalOptions="Center" />
                        <Entry Grid.Row="2" Grid.Column="1" x:Name="TelnetPassEntry" Placeholder="PRO1AN" Text="PRO1AN" IsPassword="True" TextColor="White" BackgroundColor="#1E293B" FontSize="13" />
                        <Label Grid.Row="3" Grid.Column="0" Text="FTP user/pass:" TextColor="#94A3B8" FontAttributes="Bold" FontSize="12" VerticalOptions="Center" />
                        <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*, *" ColumnSpacing="8">
                            <Entry Grid.Column="0" x:Name="FtpUserEntry" Placeholder="usuário" Text="sparc" TextColor="White" BackgroundColor="#1E293B" FontSize="12" />
                            <Entry Grid.Column="1" x:Name="FtpPassEntry" Placeholder="senha" Text="sparc" IsPassword="True" TextColor="White" BackgroundColor="#1E293B" FontSize="12" />
                        </Grid>
                    </Grid>
                    <Label Text="Roteador zerado (sem IP)? Preencha o IP temporário da LAN:" FontSize="11" TextColor="#94A3B8" />
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                        <Entry x:Name="TempIpEntry" Placeholder="IP temp. (opcional)" TextColor="White" BackgroundColor="#1E293B" FontSize="12" Keyboard="Numeric" />
                        <Entry x:Name="TempMaskEntry" Placeholder="Máscara" Text="255.255.255.0" TextColor="White" BackgroundColor="#1E293B" FontSize="12" Keyboard="Numeric" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- 3. Execução -->
            <Frame BackgroundColor="#0F172A" CornerRadius="12" Padding="14" BorderColor="#334155">
                <VerticalStackLayout Spacing="10">
                    <Label Text="3. Execução" FontSize="14" FontAttributes="Bold" TextColor="#F8FAFC" />
                    <Label Text="Mantenha a tela ligada! Cópia + reload levam vários minutos. ROMMON (flash vazia) não é atendido pelo celular — use notebook com TFTP." FontSize="11" TextColor="#94A3B8" />
                    <Button x:Name="UpgradeBtn" Text="⬆️ ATUALIZAR FIRMWARE" Clicked="OnUpgradeClicked" BackgroundColor="#7C3AED" TextColor="White" CornerRadius="8" FontAttributes="Bold" HeightRequest="44" FontSize="13" />
                    <Editor x:Name="FwLogEditor" HeightRequest="180" IsReadOnly="True" BackgroundColor="#000000" TextColor="#4ADE80" FontSize="11" Text="[SPARC Mobile] Selecione o firmware e configure a rede..." />
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NetworkDevice.Android.Views.Y1564Page"
             Title="Certidão de Nascimento"
             BackgroundColor="#0B0F19">
    <ScrollView>
        <VerticalStackLayout Padding="14" Spacing="12">
            <!-- CABEÇALHO -->
            <Frame BackgroundColor="#111827" BorderColor="#1F2937" CornerRadius="10" Padding="12" HasShadow="False">
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*, Auto">
                        <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                            <Label Text="📜" FontSize="18" VerticalOptions="Center" />
                            <Label Text="CERTIDÃO DE NASCIMENTO" FontSize="15" FontAttributes="Bold" TextColor="#38BDF8" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Border Grid.Column="1" BackgroundColor="#DC2626" StrokeShape="RoundRectangle 4" Padding="6, 2" VerticalOptions="Center">
                            <Label Text="ITU-T Y.1564" FontSize="10.5" FontAttributes="Bold" TextColor="#FFFFFF" />
                        </Border>
                    </Grid>
                    <Label Text="Aferição Oficial de Banda e SLA — Claro / Embratel (MTS-5800 &amp; QT-600)" FontSize="11" TextColor="#94A3B8" />

                    <!-- Status Ethernet OTG -->
                    <Border BackgroundColor="#18181B" Stroke="#3F3F46" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="8, 4">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Label Grid.Column="0" x:Name="EthStatusBadge" Text="🔌 ETH: Checando..." FontSize="11" FontAttributes="Bold" TextColor="#FBBF24" VerticalOptions="Center" Margin="0,0,6,0" />
                            <Label Grid.Column="1" x:Name="EthDetailsLabel" Text="Vínculo de processo para isolamento de testes" FontSize="10" TextColor="#71717A" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                            <Button Grid.Column="2" x:Name="BtnConfigEthernet" Text="⚙️ Conexão ETH" Clicked="OnConfigEthernetClicked" BackgroundColor="#1E293B" TextColor="#38BDF8" CornerRadius="4" FontSize="9.5" HeightRequest="26" Padding="6, 0" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- Status do Aparelho & Calibração de Hardware -->
                    <Border BackgroundColor="#0F172A" Stroke="#1E293B" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="8, 4">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" x:Name="DeviceAdaptationLabel" Text="📱 Identificando smartphone..." FontSize="10" TextColor="#38BDF8" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                            <Button Grid.Column="1" Text="⚙️ Detalhes" Clicked="OnDeviceDetailsClicked" BackgroundColor="#1E293B" TextColor="#38BDF8" CornerRadius="4" FontSize="9.5" HeightRequest="26" Padding="6, 0" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </Frame>

            <!-- CARD 1: DADOS DO CIRCUITO (FICHA SAIP) -->
            <Frame BackgroundColor="#111827" BorderColor="#1F2937" CornerRadius="8" Padding="12" HasShadow="False">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="📋 DADOS DO CIRCUITO (FICHA SAIP)" FontSize="12.5" FontAttributes="Bold" TextColor="#38BDF8" VerticalOptions="Center" />
                        <Border Grid.Column="1" x:Name="BadgeSaipStatus" BackgroundColor="#064E3B" StrokeShape="RoundRectangle 4" Padding="6, 2" VerticalOptions="Center">
                            <Label x:Name="TxtSaipStatus" Text="✓ SAIP Carregada" FontSize="10" FontAttributes="Bold" TextColor="#34D399" />
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" RowSpacing="6" ColumnSpacing="8">
                        <!-- Cliente -->
                        <Border Grid.Row="0" Grid.Column="0" BackgroundColor="#0F172A" Stroke="#1E293B" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="8, 6">
                            <VerticalStackLayout Spacing="1">
                                <Label Text="Cliente / Razão Social:" FontSize="10" TextColor="#94A3B8" />
                                <Label x:Name="TxtClienteNome" Text="Identificando..." FontSize="12" FontAttributes="Bold" TextColor="#F8FAFC" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Designação -->
                        <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#0F172A" Stroke="#1E293B" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="8, 6">
                            <VerticalStackLayout Spacing="1">
                                <Label Text="Designação IP:" FontSize="10" TextColor="#94A3B8" />
                                <Label x:Name="TxtDesignacao" Text="—" FontSize="12" FontAttributes="Bold" TextColor="#38BDF8" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Banda CIR -->
                        <Border Grid.Row="1" Grid.Column="0" BackgroundColor="#0F172A" Stroke="#1E293B" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="8, 6">
                            <VerticalStackLayout Spacing="1">
                                <Label Text="Banda (CIR):" FontSize="10" TextColor="#94A3B8" />
                                <Label x:Name="TxtVelocidadeCir" Text="— Mbps" FontSize="12" FontAttributes="Bold" TextColor="#F59E0B" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Gateway PE -->
                        <Border Grid.Row="1" Grid.Column="1" BackgroundColor="#0F172A" Stroke="#1E293B" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="8, 6">
                            <VerticalStackLayout Spacing="1">
                                <Label Text="Gateway PE / Destino:" FontSize="10" TextColor="#94A3B8" />
                                <Label x:Name="TxtDestinoIp" Text="—" FontSize="12" FontAttributes="Bold" TextColor="#34D399" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Linha 2: MAC do Dispositivo & IP QT-600 Alvo (NOC) -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                        <!-- MAC Local -->
                        <Border Grid.Column="0" BackgroundColor="#0F172A" Stroke="#1E293B" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="8, 6">
                            <VerticalStackLayout Spacing="2">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Grid.Column="0" Text="Endereço MAC Local:" FontSize="9.5" TextColor="#94A3B8" VerticalOptions="Center" />
                                    <Button Grid.Column="1" Text="📋 Copiar" Clicked="OnCopiarMacClicked" BackgroundColor="#1E293B" TextColor="#38BDF8" CornerRadius="4" FontSize="9" HeightRequest="22" Padding="4, 0" VerticalOptions="Center" />
                                </Grid>
                                <Label x:Name="TxtMacDispositivo" Text="Detectando MAC..." FontSize="11" FontAttributes="Bold" FontFamily="Monospace" TextColor="#38BDF8" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- IP QT-600 Alvo -->
                        <Border Grid.Column="1" BackgroundColor="#0F172A" Stroke="#1E293B" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="8, 6">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="IP QT-600 Alvo (NOC):" FontSize="9.5" TextColor="#94A3B8" />
                                <Label x:Name="TxtIpQt600Alvo" Text="—" FontSize="11" FontAttributes="Bold" FontFamily="Monospace" TextColor="#34D399" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- CARD 2: REDE LOCAL & SERVIDOR DHCP (ROTEADOR <-> SMARTPHONE OTG) -->
            <Frame BackgroundColor="#111827" BorderColor="#1F2937" CornerRadius="8" Padding="12" HasShadow="False">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*, Auto">
                        <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                            <Label Text="🌐" FontSize="14" VerticalOptions="Center" />
                            <Label Text="CONECTIVIDADE LAN &amp; SERVIDOR DHCP" FontSize="12" FontAttributes="Bold" TextColor="#38BDF8" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Border Grid.Column="1" x:Name="BadgeDhcpStatus" BackgroundColor="#1E293B" StrokeShape="RoundRectangle 4" Padding="6, 2" VerticalOptions="Center">
                            <Label x:Name="TxtDhcpStatus" Text="DHCP Sob Demanda" FontSize="9.5" FontAttributes="Bold" TextColor="#94A3B8" />
                        </Border>
                    </Grid>

                    <!-- Detalhamento dos IPs -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                        <Border Grid.Column="0" BackgroundColor="#0F172A" Stroke="#1E293B" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="8, 6">
                            <VerticalStackLayout Spacing="1">
                                <Label Text="IP Obtido no Celular (OTG):" FontSize="9.5" TextColor="#94A3B8" />
                                <Label x:Name="TxtOtgIp" Text="Sem IP Atribuído" FontSize="11.5" FontAttributes="Bold" FontFamily="Monospace" TextColor="#FBBF24" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" BackgroundColor="#0F172A" Stroke="#1E293B" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="8, 6">
                            <VerticalStackLayout Spacing="1">
                                <Label Text="Host LAN Homologado (SAIP):" FontSize="9.5" TextColor="#94A3B8" />
                                <Label x:Name="TxtHostLanIp" Text="—" FontSize="11.5" FontAttributes="Bold" FontFamily="Monospace" TextColor="#38BDF8" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Ações de DHCP -->
                    <Grid ColumnDefinitions="*, *, *" ColumnSpacing="6">
                        <!-- 1. Ativar DHCP Temporário -->
                        <Button Grid.Column="0" x:Name="BtnAtivarDhcp" Text="⚡ Ativar DHCP (3s)" Clicked="OnAtivarDhcpClicked" BackgroundColor="#0284C7" TextColor="White" CornerRadius="6" FontSize="10" FontAttributes="Bold" HeightRequest="36" Padding="4, 0" />
                        <!-- 2. Renovar IP / Consultar -->
                        <Button Grid.Column="1" x:Name="BtnRenovarIp" Text="🔄 Renovar IP" Clicked="OnRenovarIpClicked" BackgroundColor="#334155" TextColor="#F8FAFC" CornerRadius="6" FontSize="10" FontAttributes="Bold" HeightRequest="36" Padding="4, 0" />
                        <!-- 3. Remover DHCP (Entrega Estática) -->
                        <Button Grid.Column="2" x:Name="BtnRemoverDhcp" Text="🚫 Remover DHCP" Clicked="OnRemoverDhcpClicked" BackgroundColor="#B91C1C" TextColor="White" CornerRadius="6" FontSize="10" FontAttributes="Bold" HeightRequest="36" Padding="4, 0" />
                    </Grid>

                    <!-- Feedback de Status / Log Rápido -->
                    <Border BackgroundColor="#090D16" Stroke="#1E293B" StrokeThickness="1" StrokeShape="RoundRectangle 4" Padding="6, 4">
                        <Label x:Name="TxtDhcpLog" Text="💡 Se a interface estiver 'Sem IP', toque em '⚡ Ativar DHCP' para injetar o pool no roteador via Serial." FontSize="9.5" TextColor="#64748B" LineBreakMode="WordWrap" />
                    </Border>
                </VerticalStackLayout>
            </Frame>

            <!-- CARD 3: MODO DE OPERAÇÃO & CONTROLE -->
            <Frame BackgroundColor="#111827" BorderColor="#1F2937" CornerRadius="8" Padding="14" HasShadow="False">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="⚙️ MODO DE OPERAÇÃO" FontSize="12.5" FontAttributes="Bold" TextColor="#38BDF8" VerticalOptions="Center" />
                        <Border Grid.Column="1" BackgroundColor="#1E293B" StrokeShape="RoundRectangle 4" Padding="6, 2" VerticalOptions="Center">
                            <Label Text="Porta 5001" FontSize="10" FontAttributes="Bold" TextColor="#F59E0B" />
                        </Border>
                    </Grid>

                    <!-- Seletor de Modo (Padrão: Refletor MTS-5800) -->
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Modo de Operação Homologado:" TextColor="#94A3B8" FontSize="10.5" />
                        <Picker x:Name="ModePicker" Title="Selecione o Modo" TextColor="White" TitleColor="#94A3B8" BackgroundColor="#1F2937" FontSize="11.5" SelectedIndexChanged="OnModePickerSelectedIndexChanged">
                            <Picker.Items>
                                <x:String>🔄 Modo Refletor MTS-5800 (Aguardar Central QT-600)</x:String>
                                <x:String>⚡ Teste pelo Celular (SPARC Master contra PE)</x:String>
                            </Picker.Items>
                        </Picker>
                    </VerticalStackLayout>

                    <!-- Painel Refletor (Visível por Padrão) -->
                    <VerticalStackLayout x:Name="LayoutModoRefletor" Spacing="8">
                        <Border BackgroundColor="#0F172A" Stroke="#059669" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="10">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="⏱️ Duração do Teste: Indefinida" FontSize="11" FontAttributes="Bold" TextColor="#34D399" />
                                <Label Text="O SPARC Mobile opera como Refletor LLB na porta UDP 5001 (L3/L4 Swap). Aguarda os disparos da central QT-600 (teste padrão de 15 minutos)." FontSize="10" TextColor="#94A3B8" />
                            </VerticalStackLayout>
                        </Border>

                        <Button x:Name="ToggleReflectorBtn" Text="🟢 ATIVAR REFLETOR MTS-5800 (LOOPBACK LLB)" Clicked="OnToggleReflectorClicked" BackgroundColor="#059669" TextColor="White" CornerRadius="8" FontAttributes="Bold" FontSize="12" HeightRequest="46" />
                    </VerticalStackLayout>

                    <!-- Painel Master (Oculto por Padrão) -->
                    <VerticalStackLayout x:Name="LayoutModoMaster" Spacing="8" IsVisible="False">
                        <!-- Destino Remoto (Gateway Claro ou Refletor) -->
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="IP Remoto:" TextColor="#94A3B8" FontSize="11" VerticalOptions="Center" />
                            <Entry Grid.Column="1" x:Name="RemoteIpEntry" Placeholder="Ex: 201.90.204.21" TextColor="White" BackgroundColor="#1F2937" FontSize="11" />
                        </Grid>

                        <!-- Tipo de Serviço e Distância MEF -->
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Serviço Oficial:" TextColor="#94A3B8" FontSize="10.5" />
                                <Picker x:Name="ServicePicker" TextColor="White" TitleColor="#94A3B8" BackgroundColor="#1F2937" FontSize="11" SelectedIndexChanged="OnServicePickerSelectedIndexChanged">
                                    <Picker.Items>
                                        <x:String>🌐 BLD (Internet Simétrica)</x:String>
                                        <x:String>🛡️ MPLS (IP VPN Corporativa)</x:String>
                                        <x:String>📞 VOZ (Tronco Digital E1)</x:String>
                                        <x:String>📞 VOZ (Tronco SIP / PABX IP)</x:String>
                                    </Picker.Items>
                                </Picker>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Distância MEF 23.1:" TextColor="#94A3B8" FontSize="10.5" />
                                <Picker x:Name="TierPicker" TextColor="White" TitleColor="#94A3B8" BackgroundColor="#1F2937" FontSize="11">
                                    <Picker.Items>
                                        <x:String>≤ 1200 Km (Regional)</x:String>
                                        <x:String>≤ 250 Km (Metropol.)</x:String>
                                        <x:String>≤ 7000 Km (Nacional)</x:String>
                                    </Picker.Items>
                                </Picker>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Banda CIR e Duração -->
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Banda Alvo (Mbps):" TextColor="#94A3B8" FontSize="10.5" />
                                <Entry x:Name="BandwidthEntry" Text="100" Keyboard="Numeric" TextColor="White" BackgroundColor="#1F2937" FontSize="11" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Duração do Teste:" TextColor="#94A3B8" FontSize="10.5" />
                                <Picker x:Name="DurationPicker" TextColor="White" TitleColor="#94A3B8" BackgroundColor="#1F2937" FontSize="11">
                                    <Picker.Items>
                                        <x:String>⚡ 1 Minuto (Expresso)</x:String>
                                        <x:String>⏱️ 5 Minutos (Recomendado)</x:String>
                                        <x:String>📜 15 Minutos (Oficial Claro)</x:String>
                                    </Picker.Items>
                                </Picker>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Botão Iniciar Master / Cancelar -->
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="8" Margin="0, 4, 0, 0">
                            <Button Grid.Column="0" x:Name="StartTestBtn" Text="▶ EMITIR CERTIDÃO" Clicked="OnStartTestClicked" BackgroundColor="#DC2626" TextColor="White" CornerRadius="8" FontAttributes="Bold" FontSize="11.5" HeightRequest="44" />
                            <Button Grid.Column="1" x:Name="CancelTestBtn" Text="✖ Cancelar" Clicked="OnCancelTestClicked" BackgroundColor="#B91C1C" TextColor="White" CornerRadius="8" FontAttributes="Bold" FontSize="11.5" HeightRequest="44" IsEnabled="False" />
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- CARD 3: DASHBOARD DE TELEMETRIA AO VIVO -->
            <Frame BackgroundColor="#111827" BorderColor="#1F2937" CornerRadius="8" Padding="14" HasShadow="False">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="📊 TELEMETRIA EM TEMPO REAL" FontSize="12.5" FontAttributes="Bold" TextColor="#38BDF8" VerticalOptions="Center" />
                        <Border Grid.Column="1" x:Name="VerdictBorder" BackgroundColor="#334155" StrokeShape="RoundRectangle 4" Padding="8, 3" VerticalOptions="Center">
                            <Label x:Name="VerdictLabel" Text="⚪ AGUARDANDO REFLETOR" FontSize="10.5" FontAttributes="Bold" TextColor="#FFFFFF" />
                        </Border>
                    </Grid>

                    <!-- Barra de progresso / temporizador -->
                    <ProgressBar x:Name="TestProgressBar" Progress="0" ProgressColor="#38BDF8" HeightRequest="8" />
                    <Label x:Name="ProgressTimerLabel" Text="Tempo: 00:00 (Indefinido)" FontSize="11" TextColor="#94A3B8" HorizontalTextAlignment="Center" FontFamily="OpenSansRegular" />

                    <!-- Grid 2x2 com Medidores Digitais -->
                    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" RowSpacing="8" ColumnSpacing="8">
                        <!-- Vazão Tx/Rx -->
                        <Border Grid.Row="0" Grid.Column="0" BackgroundColor="#1E293B" StrokeShape="RoundRectangle 6" Padding="10">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Vazão Tx / Rx" TextColor="#94A3B8" FontSize="10" />
                                <Label x:Name="ThroughputLabel" Text="0.0 / 0.0 Mbps" FontAttributes="Bold" FontSize="14" TextColor="#38BDF8" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Perda de Pacotes / Pacotes Refletidos -->
                        <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#1E293B" StrokeShape="RoundRectangle 6" Padding="10">
                            <VerticalStackLayout Spacing="2">
                                <Label x:Name="LossTitleLabel" Text="Pacotes Refletidos" TextColor="#94A3B8" FontSize="10" />
                                <Label x:Name="LossLabel" Text="0 pkts" FontAttributes="Bold" FontSize="14" TextColor="#4ADE80" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Latência Média / Origem Detectada -->
                        <Border Grid.Row="1" Grid.Column="0" BackgroundColor="#1E293B" StrokeShape="RoundRectangle 6" Padding="10">
                            <VerticalStackLayout Spacing="2">
                                <Label x:Name="DelayTitleLabel" Text="Central QT-600:" TextColor="#94A3B8" FontSize="10" />
                                <Label x:Name="DelayLabel" Text="Aguardando" FontAttributes="Bold" FontSize="14" TextColor="#FBBF24" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Jitter / PPS -->
                        <Border Grid.Row="1" Grid.Column="1" BackgroundColor="#1E293B" StrokeShape="RoundRectangle 6" Padding="10">
                            <VerticalStackLayout Spacing="2">
                                <Label x:Name="JitterTitleLabel" Text="Taxa PPS" TextColor="#94A3B8" FontSize="10" />
                                <Label x:Name="JitterLabel" Text="0 PPS" FontAttributes="Bold" FontSize="14" TextColor="#A78BFA" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Botão Compartilhar Certidão de Nascimento -->
                    <Button x:Name="ShareCertidaoBtn" Text="📜 COMPARTILHAR CERTIDÃO DE NASCIMENTO (PDF/HTML)" Clicked="OnShareCertidaoClicked" BackgroundColor="#059669" TextColor="White" CornerRadius="8" FontAttributes="Bold" HeightRequest="44" FontSize="11" IsVisible="False" Margin="0, 4, 0, 0" />
                </VerticalStackLayout>
            </Frame>

            <!-- CARD 4: REGISTRO DE EVENTOS -->
            <Frame BackgroundColor="#111827" BorderColor="#1F2937" CornerRadius="8" Padding="14" HasShadow="False">
                <VerticalStackLayout Spacing="8">
                    <Label Text="📝 Registro de Operações e Eventos" FontSize="12.5" FontAttributes="Bold" TextColor="#F8FAFC" />
                    <Editor x:Name="LogEditor" HeightRequest="130" IsReadOnly="True" BackgroundColor="#000000" TextColor="#38BDF8" FontFamily="OpenSansRegular" FontSize="10" Text="[Certidão Y.1564] Pronto. Modo inicial: Refletor MTS-5800 LLB (porta 5001)." />
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

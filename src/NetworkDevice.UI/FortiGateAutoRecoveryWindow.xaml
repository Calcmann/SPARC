<Window x:Class="NetworkDevice.UI.FortiGateAutoRecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SPARC — Recuperação Autônoma de Senha e Bootloader (FortiGate 40F)"
        Icon="Assets/sparc.ico"
        Width="780" Height="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F172A"
        FontFamily="Segoe UI">

    <Border Padding="18,16" Background="#0F172A" BorderBrush="#334155" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Cabeçalho -->
                <RowDefinition Height="Auto" /> <!-- S/N e Instruções Físicas -->
                <RowDefinition Height="Auto" /> <!-- Painel do Bootloader / BIOS -->
                <RowDefinition Height="Auto" /> <!-- Status e Barra de Progresso -->
                <RowDefinition Height="*" />    <!-- Terminal Log -->
                <RowDefinition Height="Auto" /> <!-- Linha de Envio Interativo ao Console -->
                <RowDefinition Height="Auto" /> <!-- Rodapé e Botões Finais -->
            </Grid.RowDefinitions>

            <!-- CABEÇALHO -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <Border Background="#881337" CornerRadius="8" Width="44" Height="44" Margin="0,0,12,0">
                    <TextBlock Text="🛠️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTituloCabecalho" Text="FortiGate 40F — Quebra de Senha e Reset de Fábrica" FontWeight="Black" FontSize="15" Foreground="#F87171" />
                    <TextBlock x:Name="TxtSubtituloCabecalho" Text="Procedimento físico guiado: reinicie o 40F e segure RESET até o LED Status piscar rapidamente." FontSize="11" Foreground="#94A3B8" />
                </StackPanel>
            </StackPanel>

            <!-- INSTRUÇÃO FÍSICA & SERIAL NUMBER -->
            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                <!-- CARD SERIAL NUMBER (EXIBIDO APENAS APÓS A COLETA OU INFORMADO) -->
                <Border x:Name="BorderSerialNumber" Visibility="Collapsed" Background="#064E3B" BorderBrush="#059669" BorderThickness="1.5" CornerRadius="8" Padding="10,6" Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="✅" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Serial Number (S/N):" FontWeight="Bold" FontSize="11" Foreground="#A7F3D0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBox x:Name="TxtSerialNumber" Grid.Column="1" Padding="8,3" FontSize="11.5" FontWeight="Bold" Background="#022C22" Foreground="#34D399" BorderBrush="#059669" TextChanged="TxtSerialNumber_TextChanged" IsReadOnly="True" ToolTip="Serial Number capturado automaticamente pelo SPARC no boot do equipamento." />
                    </Grid>
                </Border>

                <!-- CARD DE AVISO: PROCEDIMENTO GUIADO DE RESET FÍSICO (LED STATUS + RESET) -->
                <Border x:Name="BorderAvisoFormatacao" Background="#450A0A" BorderBrush="#DC2626" BorderThickness="1.5" CornerRadius="8" Padding="14,12" Margin="0,0,0,8" Visibility="Visible">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="⚠️" FontSize="19" Margin="0,0,10,0" VerticalAlignment="Center" DockPanel.Dock="Left" />
                            <TextBlock Text="AVISO: Qualquer configuração prévia existente no equipamento será apagada." FontWeight="Black" FontSize="14" Foreground="#FCA5A5" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                        <Border Background="#1C1917" BorderBrush="#B45309" BorderThickness="1.5" CornerRadius="6" Padding="12,10" Margin="0,4,0,0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="📍" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                    <TextBlock Text="PASSO A PASSO OBRIGATÓRIO PARA QUEBRA DE SENHA DO 40F:" FontWeight="Black" FontSize="13" Foreground="#FDE047" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </DockPanel>
                                <TextBlock Text="1. Reinicie o equipamento (desligue e ligue o cabo de energia da fonte)." FontSize="12.5" LineHeight="19" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#FEF08A" Margin="16,2,0,4" />
                                <TextBlock Text="2. Aguarde a inicialização: observe o LED 'STATUS' no painel frontal." FontSize="12.5" LineHeight="19" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#FEF08A" Margin="16,0,0,4" />
                                <TextBlock Text="3. Quando o LED STATUS começar a piscar devagar, aperte e segure o botão no furo 'RESET' (traseira)." FontSize="12.5" LineHeight="19" TextWrapping="Wrap" FontWeight="Bold" Foreground="#FACC15" Margin="16,0,0,4" />
                                <TextBlock Text="4. Segure o botão reset (em torno de 3 segundos) até o LED STATUS começar a piscar rápido, e então solte." FontSize="12.5" LineHeight="19" TextWrapping="Wrap" FontWeight="Bold" Foreground="#FDE047" Margin="16,0,0,4" />
                                <TextBlock Text="5. O roteador detectará o reset físico e reiniciará com as configurações de fábrica!" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#86EFAC" Margin="16,0,0,4" />
                                <TextBlock Text="6. Quebra de senha realizada: a senha retornou à default. Siga com o processo padrão de provisionamento." FontSize="12.5" LineHeight="19" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#A7F3D0" Margin="16,0,0,2" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- CARD DE INSTRUÇÃO E MÉTODOS (MODO AVANÇADO) -->
                <Border x:Name="BorderMetodosManuais" Background="#451A03" BorderBrush="#B45309" BorderThickness="1.5" CornerRadius="8" Padding="10,8" Visibility="Collapsed">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,3">
                            <TextBlock Text="🔌" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" DockPanel.Dock="Left" />
                            <TextBlock Text="MÉTODO 1 (Automático): Desligue e religue a fonte de alimentação do FortiGate 40F." FontWeight="Black" FontSize="11" Foreground="#FDE68A" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="O SPARC monitorará os primeiros segundos do boot para enviar maintainer ou admin padrão." FontSize="10" Foreground="#FDE047" Margin="23,0,0,3" />
                        <DockPanel>
                            <TextBlock Text="📌" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" DockPanel.Dock="Left" />
                            <TextBlock Text="MÉTODO 2 (Reset Físico / FortiOS 7.2.4+): Segure o botão RESET (furo traseiro) com clipe por 30s ao ligar a fonte." FontWeight="SemiBold" FontSize="10" Foreground="#E2E8F0" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- PAINEL DO BOOTLOADER / BIOS (EXIBIDO NO MODO AVANÇADO CTRL+SHIFT+V) -->
            <Border Grid.Row="2" x:Name="BorderBiosPanel" Background="#1E1B4B" BorderBrush="#4338CA" BorderThickness="1.5" CornerRadius="8" Padding="10,8" Margin="0,0,0,10" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <CheckBox x:Name="ChkInterceptBios" Content="⚙️ Interceptar Bootloader (BIOS) no Boot" IsChecked="False" FontWeight="Bold" FontSize="11" Foreground="#C7D2FE" VerticalAlignment="Center" DockPanel.Dock="Left" Checked="ChkInterceptBios_Checked" Unchecked="ChkInterceptBios_Unchecked" ToolTip="Quando ativado, o SPARC envia comando de interrupção durante a janela de 3s da BIOS para abrir o menu de configuração." />
                        <TextBlock x:Name="TxtBiosStatus" Text="Bootloader inativo (Aguardando boot)" FontSize="10.5" Foreground="#A5B4FC" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </DockPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <Button x:Name="BtnBiosBootBackup" Content="🔄 [B] Boot Backup Firmware" ToolTip="Inicia a inicialização através da partição secundária/backup de firmware" Padding="10,4" FontWeight="SemiBold" FontSize="10.5" Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0" IsEnabled="False" Click="BtnBiosBootBackup_Click" />
                        <Button x:Name="BtnBiosFormat" Content="🧹 [F] Formatar Flash (Reset)" ToolTip="Formata o dispositivo de boot (apaga partições e senhas da flash)" Padding="10,4" FontWeight="SemiBold" FontSize="10.5" Background="#DC2626" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0" IsEnabled="False" Click="BtnBiosFormat_Click" />
                        <Button x:Name="BtnBiosSysInfo" Content="ℹ️ [I] Informações BIOS" ToolTip="Consulta informações de hardware e sistema na BIOS" Padding="10,4" FontWeight="SemiBold" FontSize="10.5" Background="#4F46E5" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0" IsEnabled="False" Click="BtnBiosSysInfo_Click" />
                        <Button x:Name="BtnBiosQuit" Content="▶️ [Q] Continuar Boot" ToolTip="Sai do menu da BIOS e prossegue com a inicialização normal do FortiOS" Padding="10,4" FontWeight="SemiBold" FontSize="10.5" Background="#475569" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0" IsEnabled="False" Click="BtnBiosQuit_Click" />
                        <Button x:Name="BtnInterromperBiosAgora" Content="⏹️ Forçar Interrupção Agora" ToolTip="Envia imediatamente comandos de interrupção caso o equipamento esteja na contagem da BIOS" Padding="10,4" FontWeight="SemiBold" FontSize="10.5" Background="#D97706" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnInterromperBiosAgora_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- STATUS & PROGRESSO -->
            <StackPanel Grid.Row="3" Margin="0,0,0,8">
                <DockPanel Margin="0,0,0,4">
                    <TextBlock x:Name="TxtStatusBadge" Text="⏳ Aguardando boot do equipamento (desligue e ligue a fonte)..." FontWeight="Bold" FontSize="11" Foreground="#38BDF8" DockPanel.Dock="Left" />
                    <TextBlock x:Name="TxtPercentBadge" Text="0%" FontWeight="Bold" FontSize="10.5" Foreground="#94A3B8" DockPanel.Dock="Right" HorizontalAlignment="Right" />
                </DockPanel>
                <ProgressBar x:Name="ProgressBarRecovery" Height="6" Minimum="0" Maximum="100" Value="10" Foreground="#10B981" Background="#1E293B" BorderThickness="0" />
            </StackPanel>

            <!-- CONSOLE SERIAL MONITOR -->
            <Border Grid.Row="4" Background="#020617" BorderBrush="#1E293B" BorderThickness="1.5" CornerRadius="6" Padding="6" Margin="0,0,0,8">
                <TextBox x:Name="TxtTerminalLog"
                         Background="#020617" Foreground="#4ADE80"
                         BorderThickness="0"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas, Cascadia Mono, Courier New"
                         FontSize="10" />
            </Border>

            <!-- LINHA DE ENVIO INTERATIVO AO CONSOLE (EXIBIDO NO MODO AVANÇADO) -->
            <Grid x:Name="GridConsoleInput" Grid.Row="5" Margin="0,0,0,10" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtConsoleInput" Grid.Column="0"
                         Padding="8,5" FontSize="11"
                         Background="#020617" Foreground="#F8FAFC"
                         BorderBrush="#334155" BorderThickness="1"
                         KeyDown="TxtConsoleInput_KeyDown"
                         ToolTip="Digite qualquer comando serial ou opção (ex: B, F, Q, maintainer) e pressione Enter para enviar." />
                <Button x:Name="BtnSendConsole" Grid.Column="1"
                        Content="Enviar ao Console ↵"
                        Padding="12,5" FontWeight="SemiBold" FontSize="11"
                        Background="#1E293B" Foreground="#38BDF8"
                        BorderBrush="#334155" BorderThickness="1"
                        Cursor="Hand" Margin="6,0,0,0"
                        Click="BtnSendConsole_Click" />
            </Grid>

            <!-- BOTÕES FINAIS -->
            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="TxtFooterNote" Text="* A senha de fábrica foi restaurada. O processo padrão do SPARC assumirá todas as configurações." FontSize="9.5" Foreground="#64748B" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnForcarPromptAtual" Content="⚡ Forçar Envio Agora" ToolTip="Dispara credenciais imediatamente caso o aparelho tenha acabado de ser religado" Padding="12,6" FontWeight="SemiBold" FontSize="11" Background="#D97706" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0" Click="BtnForcarPromptAtual_Click" />
                    <Button x:Name="BtnConcluir" Content="Prosseguir para Processo Padrão ➔" Padding="14,6" FontWeight="Bold" FontSize="11.5" Background="#16A34A" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0" IsEnabled="False" Click="BtnConcluir_Click" />
                    <Button x:Name="BtnCancelar" Content="Cancelar" Padding="12,6" FontWeight="SemiBold" FontSize="11" Background="#334155" Foreground="#CBD5E1" BorderThickness="0" Cursor="Hand" Click="BtnCancelar_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

<Window x:Class="NetworkDevice.UI.TabelaCpeHomologadosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SPARC — Catálogo de CPEs Homologados Claro (Banda x Modelo)"
        Height="780" Width="1080" MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterOwner"
        Background="#0B0F19" Foreground="#E2E8F0"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Estilo de Botão Primário Moderno -->
        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo de Filtro Chip -->
        <Style x:Key="FilterChipBtn" TargetType="RadioButton">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ChipBorder" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="#0284C7"/>
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- 0: Cabeçalho com Logo e Título -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Painel do Circuito Atual / Simulador de Banda -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Barra de Filtros e Busca -->
            <RowDefinition Height="Auto"/>
            <!-- 3: Lista / Tabela Gráfica de Modelos -->
            <RowDefinition Height="*"/>
            <!-- 4: Rodapé com Legenda e Ações -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= 0: CABEÇALHO ================= -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#E11D48" CornerRadius="6" Padding="6,2" Margin="0,0,8,0">
                        <TextBlock Text="CLARO S.A." FontWeight="Black" FontSize="11" Foreground="White"/>
                    </Border>
                    <Border Background="#0C4A6E" CornerRadius="6" Padding="8,2" Margin="0,0,10,0">
                        <TextBlock Text="ENGENHARIA DE IMPLANTAÇÃO" FontWeight="Bold" FontSize="11" Foreground="#38BDF8"/>
                    </Border>
                    <TextBlock Text="• PORTFÓLIO DE CPES EMPRESARIAIS" FontWeight="SemiBold" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Matriz de Modelos Homologados x Limites de Banda" FontWeight="Black" FontSize="20" Foreground="#FFFFFF" Margin="0,4,0,2"/>
                <TextBlock Text="Tabela técnica oficial com limites nominais de vazão (BLD Internet / MPLS VPN / TDM) por modelo, kit e part number." FontSize="12" Foreground="#94A3B8"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnAbrirPlanilhaExcel" Content="📊 Abrir Planilha XLSX Original" Style="{StaticResource ModernBtn}"
                        Background="#047857" Foreground="White" Margin="0,0,8,0" Click="BtnAbrirPlanilhaExcel_Click"
                        ToolTip="Abre o arquivo oficial 'CPE''s Empresariais.xlsx' diretamente no Microsoft Excel" />
                <Button x:Name="BtnFechar" Content="✕ Fechar" Style="{StaticResource ModernBtn}"
                        Background="#334155" Foreground="White" Click="BtnFechar_Click" />
            </StackPanel>
        </Grid>

        <!-- ================= 1: BANNER DO CIRCUITO ATUAL / SIMULADOR ================= -->
        <Border Grid.Row="1" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="⚡ Validação de Compatibilidade com o Circuito:" FontWeight="Bold" FontSize="12.5" Foreground="#F8FAFC"/>
                        <TextBlock x:Name="TxtCircuitoIdentificacao" Text="Nenhuma Ficha SAIP carregada" FontWeight="Bold" FontSize="12.5" Foreground="#38BDF8" Margin="6,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtCircuitoDetalhes" Text="Digite uma velocidade ao lado para simular e verificar quais modelos suportam a banda exigida." FontSize="11.5" Foreground="#94A3B8"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Simular Banda (Mbps):" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="#CBD5E1" Margin="0,0,6,0"/>
                    <TextBox x:Name="TxtSimularBanda" Width="70" Padding="6,4" FontWeight="Bold" FontSize="13" TextAlignment="Center"
                             Background="#1E293B" Foreground="#38BDF8" BorderBrush="#475569" TextChanged="TxtSimularBanda_TextChanged"/>
                    <ComboBox x:Name="CmbTipoServicoSimulado" Width="100" Margin="6,0,0,0" Padding="4,4" FontSize="11.5" FontWeight="Bold"
                              SelectedIndex="0" SelectionChanged="CmbTipoServicoSimulado_SelectionChanged">
                        <ComboBoxItem Content="🌐 BLD"/>
                        <ComboBoxItem Content="🛡️ MPLS"/>
                    </ComboBox>
                    <Button x:Name="BtnUsarBandaSaip" Content="Usar Banda SAIP" Margin="6,0,0,0" Padding="8,5" Style="{StaticResource ModernBtn}"
                            Background="#0284C7" Foreground="White" FontSize="11" Click="BtnUsarBandaSaip_Click"
                            ToolTip="Aplica automaticamente a velocidade nominal extraída da Ficha SAIP carregada"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 2: BARRA DE FILTROS E BUSCA ================= -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                <RadioButton x:Name="RbFiltroTodos" Content="Todos os Modelos" Style="{StaticResource FilterChipBtn}" IsChecked="True" Checked="RbFiltro_Checked"/>
                <RadioButton x:Name="RbFiltroCisco" Content="Cisco" Style="{StaticResource FilterChipBtn}" Checked="RbFiltro_Checked"/>
                <RadioButton x:Name="RbFiltroHpe" Content="HPE / HP" Style="{StaticResource FilterChipBtn}" Checked="RbFiltro_Checked"/>
                <RadioButton x:Name="RbFiltroFortinet" Content="Fortinet" Style="{StaticResource FilterChipBtn}" Checked="RbFiltro_Checked"/>
                <RadioButton x:Name="RbFiltroNovo" Content="Portfólio Novo" Style="{StaticResource FilterChipBtn}" Checked="RbFiltro_Checked"/>
                <RadioButton x:Name="RbFiltroAntigo" Content="Portfólio Antigo" Style="{StaticResource FilterChipBtn}" Checked="RbFiltro_Checked"/>
                <RadioButton x:Name="RbFiltroCompatíveis" Content="⭐ Apenas Compatíveis" Style="{StaticResource FilterChipBtn}" Checked="RbFiltro_Checked"/>
            </WrapPanel>

            <Border Grid.Column="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="6,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔍" VerticalAlignment="Center" Margin="2,0,4,0" FontSize="11"/>
                    <TextBox Grid.Column="1" x:Name="TxtBusca" Background="Transparent" BorderThickness="0" Foreground="#F8FAFC"
                             FontSize="12" VerticalAlignment="Center" TextChanged="TxtBusca_TextChanged"
                             ToolTip="Pesquise por modelo, fabricante, PN, SAP ou descrição"/>
                    <Button Grid.Column="2" Content="✕" Background="Transparent" Foreground="#64748B" BorderThickness="0"
                            Padding="4,0" Cursor="Hand" Click="BtnLimparBusca_Click" ToolTip="Limpar busca"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= 3: TABELA GRÁFICA DE MODELOS ================= -->
        <Border Grid.Row="3" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="1">
            <DataGrid x:Name="DgModelos" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      IsReadOnly="True" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1E293B"
                      Background="#0F172A" RowBackground="#0F172A" AlternatingRowBackground="#111D33"
                      BorderThickness="0" HeadersVisibility="Column" SelectionMode="Single"
                      Foreground="#E2E8F0" FontSize="12" RowHeight="46"
                      MouseDoubleClick="DgModelos_MouseDoubleClick">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#1E293B"/>
                        <Setter Property="Foreground" Value="#CBD5E1"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="11.5"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="BorderBrush" Value="#334155"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <!-- Status de Compatibilidade -->
                    <DataGridTemplateColumn Header="Compatibilidade" Width="135">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="BorderCompat" CornerRadius="4" Padding="6,3" Margin="4,2" HorizontalAlignment="Center">
                                    <TextBlock x:Name="TxtCompat" FontWeight="Black" FontSize="11" HorizontalAlignment="Center"/>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsCompativelComSimulacao}" Value="True">
                                        <Setter TargetName="BorderCompat" Property="Background" Value="#064E3B"/>
                                        <Setter TargetName="TxtCompat" Property="Text" Value="✅ SUPORTA"/>
                                        <Setter TargetName="TxtCompat" Property="Foreground" Value="#34D399"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCompativelComSimulacao}" Value="False">
                                        <Setter TargetName="BorderCompat" Property="Background" Value="#450A0A"/>
                                        <Setter TargetName="TxtCompat" Property="Text" Value="❌ INCOMPATÍVEL"/>
                                        <Setter TargetName="TxtCompat" Property="Foreground" Value="#F87171"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Fabricante -->
                    <DataGridTemplateColumn Header="Fabricante" Width="95">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding Fabricante}" FontWeight="Bold" FontSize="11.5"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Modelo / Nome Comercial -->
                    <DataGridTemplateColumn Header="Modelo Homologado Claro" Width="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding ModeloNome}" FontWeight="Bold" FontSize="12.5" Foreground="#F8FAFC"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Kit}" FontSize="10.5" Foreground="#38BDF8" FontWeight="SemiBold" Margin="0,0,6,0"/>
                                        <TextBlock Text="•" FontSize="10" Foreground="#64748B" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Portfolio}" FontSize="10.5" Foreground="#94A3B8"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Part Number & SAP -->
                    <DataGridTemplateColumn Header="Part Number / SAP" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding PartNumberPrincipal}" FontFamily="Consolas" FontSize="11" Foreground="#CBD5E1" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SapFormatado}" FontFamily="Consolas" FontSize="10" Foreground="#A1A1AA"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Tipo de Acesso -->
                    <DataGridTemplateColumn Header="Acesso" Width="75">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TipoAcesso}" FontWeight="Bold" FontSize="11"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           Foreground="{Binding TipoAcessoColor}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Banda BLD (Internet) -->
                    <DataGridTemplateColumn Header="BLD (Internet)" Width="125">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding BldFormatado, Mode=OneWay}" FontWeight="Black" FontSize="12" HorizontalAlignment="Center" Foreground="#38BDF8"/>
                                    <ProgressBar Maximum="10000" Value="{Binding BldMaxMbps, Mode=OneWay}" Height="4" Width="90" Background="#1E293B" Foreground="#0284C7" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Banda MPLS -->
                    <DataGridTemplateColumn Header="MPLS VPN" Width="105">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding MplsFormatado, Mode=OneWay}" FontWeight="Bold" FontSize="11.5" HorizontalAlignment="Center" Foreground="#A78BFA"/>
                                    <ProgressBar Maximum="10000" Value="{Binding MplsMaxMbps, Mode=OneWay}" Height="3" Width="70" Background="#1E293B" Foreground="#7C3AED" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Descrição resumida -->
                    <DataGridTextColumn Header="Descrição e Composição do Kit" Width="*" Binding="{Binding Descricao, Mode=OneWay}" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="ToolTip" Value="{Binding Descricao, Mode=OneWay}"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ================= 4: RODAPÉ ================= -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="💡 Dica: Duplo clique em qualquer modelo para selecioná-lo automaticamente no SPARC."
                           FontSize="11.5" Foreground="#94A3B8" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnSelecionarModeloNoSparc" Content="✓ Selecionar Modelo Selecionado no SPARC"
                        Style="{StaticResource ModernBtn}" Background="#0284C7" Foreground="White"
                        Click="BtnSelecionarModeloNoSparc_Click" ToolTip="Define o modelo selecionado acima como o equipamento ativo na tela inicial do SPARC"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

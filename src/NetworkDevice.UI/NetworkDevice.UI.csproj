<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>NetworkDevice.UI</AssemblyName>
    <RootNamespace>NetworkDevice.UI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\sparc.ico</ApplicationIcon>
    <Version>0.8.10</Version>
    <InformationalVersion>Release v0.8.10 Beta</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\**\*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetworkDevice.Core\NetworkDevice.Core.csproj" />
    <ProjectReference Include="..\NetworkDevice.Protocols\NetworkDevice.Protocols.csproj" />
    <ProjectReference Include="..\NetworkDevice.Cisco\NetworkDevice.Cisco.csproj" />
    <ProjectReference Include="..\NetworkDevice.Fortinet\NetworkDevice.Fortinet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\Manual_Instrucoes_Operador_SPARC.pdf" Link="Manual_Instrucoes_Operador_SPARC.pdf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
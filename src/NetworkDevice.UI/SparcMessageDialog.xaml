<Window x:Class="NetworkDevice.UI.SparcMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SPARC — Instrução ao Operador"
        Icon="Assets/sparc.ico"
        Width="640" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#18181B"
        FontFamily="Segoe UI"
        Foreground="#E4E4E7">

    <Window.Resources>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Padding="20" Background="#18181B" BorderBrush="#3F3F46" BorderThickness="1">
        <StackPanel>
            <!-- CABEÇALHO PADRONIZADO (ESTILO WAN / BANCADA) -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="BadgeIconBorder" Grid.Column="0" Background="#78350F" CornerRadius="8" Width="44" Height="44" Margin="0,0,14,0">
                    <TextBlock x:Name="TxtIcon" Text="⚠️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTituloPrincipal" Text="Instrução para o Operador" FontWeight="Black" FontSize="15" Foreground="#FBBF24" TextWrapping="Wrap" />
                    <TextBlock x:Name="TxtSubHeader" Text="Interação necessária para continuidade do fluxo" FontSize="11.5" Foreground="#A1A1AA" Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <!-- CARD DE MENSAGEM PADRONIZADO -->
            <Border Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1.5" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="TxtMessage"
                               Text=""
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="#E4E4E7"
                               LineHeight="19" />
                </ScrollViewer>
            </Border>

            <!-- BARRA DE BOTÕES DE AÇÃO -->
            <DockPanel Margin="0,2,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCancel" Content="Cancelar" Padding="14,7" Margin="0,0,8,0"
                            Background="#3F3F46" Foreground="#E4E4E7" BorderThickness="0" FontWeight="SemiBold" FontSize="11"
                            Visibility="Collapsed" Click="BtnCancel_Click" />

                    <Button x:Name="BtnNo" Content="Não" Padding="14,7" Margin="0,0,8,0"
                            Background="#3F3F46" Foreground="#E4E4E7" BorderThickness="0" FontWeight="SemiBold" FontSize="11"
                            Visibility="Collapsed" Click="BtnNo_Click" />

                    <Button x:Name="BtnYes" Content="Sim" Padding="16,7" Margin="0,0,8,0"
                            Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="11.5"
                            Visibility="Collapsed" Click="BtnYes_Click" />

                    <Button x:Name="BtnOk" Content="OK (Prosseguir)" Padding="16,7"
                            Background="#16A34A" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="11.5"
                            Visibility="Visible" Click="BtnOk_Click" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>

<Window x:Class="NetworkDevice.UI.EditDeviceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SPARC — Edição de Cadastro de Técnico / Licença"
        Icon="Assets/sparc.ico"
        Width="580" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#18181B"
        FontFamily="Segoe UI"
        Foreground="#E4E4E7">

    <Border Padding="20" Background="#18181B" BorderBrush="#3F3F46" BorderThickness="1">
        <StackPanel>
            <!-- CABEÇALHO -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border Background="#1E3A8A" CornerRadius="8" Width="40" Height="40" Margin="0,0,12,0">
                    <TextBlock Text="✏️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Editar Dados do Técnico / Cópia" FontWeight="Black" FontSize="15" Foreground="#38BDF8" />
                    <TextBlock x:Name="TxtSubHeader" Text="Atualização cadastral com sincronização imediata na nuvem" FontSize="11" Foreground="#A1A1AA" />
                </StackPanel>
            </StackPanel>

            <!-- CARD COM FORMULÁRIO -->
            <Border Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- NOME / SOBRENOME -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                        <TextBlock Text="Nome *" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,0,0,4" />
                        <TextBox x:Name="TxtFirstName" Height="30" Padding="8,4" Background="#18181B" Foreground="White" BorderBrush="#52525B" FontSize="11.5" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                        <TextBlock Text="Sobrenome" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,0,0,4" />
                        <TextBox x:Name="TxtLastName" Height="30" Padding="8,4" Background="#18181B" Foreground="White" BorderBrush="#52525B" FontSize="11.5" />
                    </StackPanel>

                    <!-- EMPRESA / MATRÍCULA -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                        <TextBlock Text="Empresa (Terceirizada / Própria) *" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,0,0,4" />
                        <TextBox x:Name="TxtCompany" Height="30" Padding="8,4" Background="#18181B" Foreground="White" BorderBrush="#52525B" FontSize="11.5" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10">
                        <TextBlock Text="Matrícula Funcional *" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,0,0,4" />
                        <TextBox x:Name="TxtEmployeeId" Height="30" Padding="8,4" Background="#18181B" Foreground="White" BorderBrush="#52525B" FontSize="11.5" />
                    </StackPanel>

                    <!-- WHATSAPP / E-MAIL -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,10">
                        <TextBlock Text="WhatsApp / Telefone com DDD *" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,0,0,4" />
                        <TextBox x:Name="TxtPhone" Height="30" Padding="8,4" Background="#18181B" Foreground="White" BorderBrush="#52525B" FontSize="11.5" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,10">
                        <TextBlock Text="E-mail (Opcional)" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,0,0,4" />
                        <TextBox x:Name="TxtEmail" Height="30" Padding="8,4" Background="#18181B" Foreground="White" BorderBrush="#52525B" FontSize="11.5" />
                    </StackPanel>

                    <!-- CLUSTER / UF -->
                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,10">
                        <TextBlock Text="Cluster / Polo *" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,0,0,4" />
                        <TextBox x:Name="TxtCluster" Height="30" Padding="8,4" Background="#18181B" Foreground="White" BorderBrush="#52525B" FontSize="11.5" />
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,10">
                        <TextBlock Text="UF *" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,0,0,4" />
                        <TextBox x:Name="TxtUf" Height="30" MaxLength="2" Padding="8,4" Background="#18181B" Foreground="White" BorderBrush="#52525B" FontSize="11.5" />
                    </StackPanel>

                    <!-- NOTAS -->
                    <StackPanel Grid.Row="4" Grid.ColumnSpan="3">
                        <TextBlock Text="Observações / Notas Internas" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,0,0,4" />
                        <TextBox x:Name="TxtNotes" Height="30" Padding="8,4" Background="#18181B" Foreground="White" BorderBrush="#52525B" FontSize="11.5" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- AVISO DE SINCRONIZAÇÃO -->
            <TextBlock Text="💡 As alterações são sanitizadas (Title Case, matrículas em maiúsculo, e-mail padronizado) e sincronizadas com a base online no GitHub."
                       FontSize="10.5" Foreground="#38BDF8" TextWrapping="Wrap" Margin="0,0,0,14" />

            <!-- BOTÕES DE AÇÃO -->
            <DockPanel>
                <Button Content="Cancelar" HorizontalAlignment="Left" Padding="14,6" Background="#3F3F46" Foreground="White" BorderThickness="0" FontWeight="SemiBold" FontSize="11.5" Cursor="Hand" Click="BtnCancelar_Click" />
                <Button Content="💾 Salvar Alterações e Sincronizar" HorizontalAlignment="Right" Padding="16,6" Background="#16A34A" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="12" Cursor="Hand" Click="BtnSalvar_Click" />
            </DockPanel>
        </StackPanel>
    </Border>
</Window>

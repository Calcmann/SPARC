<Window x:Class="NetworkDevice.UI.WanDiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SPARC — Diagnóstico Didático de Portas LAN / WAN"
        Icon="Assets/sparc.ico"
        Width="680" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#18181B"
        FontFamily="Segoe UI"
        Foreground="#E4E4E7">

    <Border Padding="20" Background="#18181B" BorderBrush="#3F3F46" BorderThickness="1">
        <StackPanel>
            <!-- CABEÇALHO -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="BadgeIconBorder" Grid.Column="0" Background="#78350F" CornerRadius="8" Width="44" Height="44" Margin="0,0,14,0">
                    <TextBlock x:Name="TxtIcon" Text="⚠️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTituloPrincipal" Text="Diagnóstico de Portas — Status Físico e Conectividade" FontWeight="Black" FontSize="15" Foreground="#FBBF24" />
                    <TextBlock x:Name="TxtSubHeader" Text="Modelo identificado: Cisco Série 900 / C921-4P" FontSize="11.5" Foreground="#A1A1AA" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <!-- BANNER DE ALERTA DE INVERSÃO DE CABOS (QUANDO DETECTADO) -->
            <Border x:Name="BannerInversao" Visibility="Collapsed" Background="#450A0A" BorderBrush="#EF4444" BorderThickness="1.5" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🚨" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="ALERTA CRÍTICO: POSSÍVEL INVERSÃO DE CABOS DETECTADA!" FontWeight="Black" FontSize="12.5" Foreground="#FCA5A5" />
                        <TextBlock x:Name="TxtInversaoDesc"
                                   Text="A porta WAN está com link ativo, mas a porta LAN está desconectada (ou o IP do seu computador foi detectado na porta WAN). Verifique as conexões!"
                                   TextWrapping="Wrap" FontSize="11" Foreground="#FEE2E2" Margin="0,3,0,4" LineHeight="16" />
                        <TextBlock Text="👉 Conecte o cabo do computador na porta LAN e o cabo do modem/acesso Claro na porta WAN."
                                   FontWeight="Bold" FontSize="11" Foreground="#F87171" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CARDS DE STATUS FÍSICO DAS PORTAS (LAN E WAN LADO A LADO) -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- CARD LAN -->
                <Border x:Name="CardLan" Grid.Column="0" Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1.5" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="🖥️ PORTA LAN (Rede Local)" FontWeight="Bold" FontSize="12" Foreground="#38BDF8" />
                            <Border x:Name="BadgeLanStatus" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" Background="#065F46">
                                <TextBlock x:Name="TxtLanStatus" Text="🟢 LINK UP" FontSize="10.5" FontWeight="Bold" Foreground="#34D399" />
                            </Border>
                        </DockPanel>

                        <TextBlock x:Name="TxtPortaLanNome" Text="Porta LAN" FontWeight="SemiBold" FontSize="12.5" Foreground="#FFFFFF" Margin="0,2,0,4" />
                        <TextBlock Text="Conexão com o seu notebook / computador para gerência e testes locais."
                                   FontSize="10.5" Foreground="#A1A1AA" TextWrapping="Wrap" LineHeight="14" />
                    </StackPanel>
                </Border>

                <!-- CARD WAN (SEM MENÇÃO À COR AZUL) -->
                <Border x:Name="CardWan" Grid.Column="2" Background="#27272A" BorderBrush="#EF4444" BorderThickness="1.5" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="🌐 PORTA WAN (Acesso Claro)" FontWeight="Bold" FontSize="12" Foreground="#F87171" />
                            <Border x:Name="BadgeWanStatus" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" Background="#7F1D1D">
                                <TextBlock x:Name="TxtWanStatus" Text="🔴 LINK DOWN" FontSize="10.5" FontWeight="Bold" Foreground="#FCA5A5" />
                            </Border>
                        </DockPanel>

                        <TextBlock x:Name="TxtPortaWanNome" Text="Porta WAN" FontWeight="SemiBold" FontSize="12.5" Foreground="#FFFFFF" Margin="0,2,0,4" />
                        <TextBlock Text="Conexão com o equipamento da operadora (Modem / NTU / EDD / Fibra)."
                                   FontSize="10.5" Foreground="#A1A1AA" TextWrapping="Wrap" LineHeight="14" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- CENÁRIOS DIDÁTICOS DE ATIVAÇÃO -->
            <TextBlock Text="Como proceder de acordo com o seu ambiente de teste:" FontWeight="Bold" FontSize="11.5" Foreground="#D4D4D8" Margin="0,0,0,8" />

            <Grid Margin="0,0,0,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- CENÁRIO 1: ATIVAÇÃO NO CLIENTE -->
                <Border Grid.Row="0" Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="6" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="🏢 Ativação no Cliente (Em Campo)" FontWeight="Bold" FontSize="11.5" Foreground="#34D399" Margin="0,0,0,2" />
                        <TextBlock Text="Se você está ativando no endereço do cliente, o cabo do equipamento de acesso da Claro deve estar conectado na porta WAN para validar o circuito, o SLA e emitir a Certidão de Conectividade. Conecte o cabo e clique em 'Conectei o Cabo WAN'."
                                   FontSize="10.5" Foreground="#D1FAE5" TextWrapping="Wrap" LineHeight="15" />
                    </StackPanel>
                </Border>

                <!-- CENÁRIO 2: PREPARAÇÃO EM BANCADA -->
                <Border Grid.Row="2" Background="#451A03" BorderBrush="#B45309" BorderThickness="1" CornerRadius="6" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="🔬 Preparação em Bancada (Laboratório)" FontWeight="Bold" FontSize="11.5" Foreground="#FBBF24" Margin="0,0,0,2" />
                        <TextBlock Text="Se você está em bancada/laboratório apenas pré-configurando o roteador sem link da Claro disponível, você pode prosseguir normalmente. Os testes de WAN, Internet e Telefonia serão pulados e marcados como 'Modo Bancada' sem apontar erro."
                                   FontSize="10.5" Foreground="#FEF3C7" TextWrapping="Wrap" LineHeight="15" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- MENSAGEM DE STATUS DO RECHEQUE / FEEDBACK EM TEMPO REAL -->
            <TextBlock x:Name="TxtRecheckStatus" Text="" Visibility="Collapsed" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" Margin="0,0,0,10" HorizontalAlignment="Center" />

            <!-- BOTÕES DE AÇÃO -->
            <DockPanel Margin="0,4,0,0">
                <Button x:Name="BtnRechecar" Content="🔍 Rechecar Portas &amp; Inversão" HorizontalAlignment="Left" Padding="12,7"
                        Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="SemiBold" FontSize="11" Cursor="Hand"
                        Click="BtnRechecar_Click" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnOffline" Content="Continuar Offline" Padding="12,7" Margin="0,0,8,0"
                            Background="#3F3F46" Foreground="#E4E4E7" BorderThickness="0" FontWeight="SemiBold" FontSize="11" Cursor="Hand"
                            Click="BtnOffline_Click" />

                    <Button x:Name="BtnBancada" Content="🧪 Seguir em Modo Bancada" Padding="14,7" Margin="0,0,8,0"
                            Background="#D97706" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="11.5" Cursor="Hand"
                            Click="BtnBancada_Click" />

                    <Button x:Name="BtnConecteiWan" Content="🔌 Conectei o Cabo WAN (Repetir Teste)" Padding="14,7"
                            Background="#16A34A" Foreground="White" BorderThickness="0" FontWeight="Black" FontSize="11.5" Cursor="Hand"
                            Click="BtnConecteiWan_Click" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>

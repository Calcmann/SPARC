<Window x:Class="NetworkDevice.UI.UpdateAvailableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SPARC — Atualização de Sistema Disponível"
        Icon="Assets/sparc.ico"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#18181B"
        FontFamily="Segoe UI"
        Foreground="#E4E4E7">

    <Border Padding="20" Background="#18181B" BorderBrush="#3F3F46" BorderThickness="1">
        <StackPanel>
            <!-- CABEÇALHO -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border Background="#065F46" CornerRadius="8" Width="44" Height="44" Margin="0,0,12,0">
                    <TextBlock Text="🚀" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Nova Versão Homologada Disponível" FontWeight="Black" FontSize="15" Foreground="#34D399" />
                    <TextBlock x:Name="TxtSubHeader" Text="Existe uma versão mais recente do SPARC no repositório oficial." FontSize="11" Foreground="#A1A1AA" />
                </StackPanel>
            </StackPanel>

            <!-- CARD DE COMPARAÇÃO DE VERSÃO -->
            <Border Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Versão Instalada" FontSize="11" Foreground="#A1A1AA" FontWeight="SemiBold" />
                        <TextBlock x:Name="TxtVersaoAtual" Text="v0.8.33" FontSize="15" FontWeight="Bold" Foreground="#F87171" Margin="0,2,0,0" />
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="➜" FontSize="18" Foreground="#38BDF8" VerticalAlignment="Center" Margin="12,0" />

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Versão Homologada" FontSize="11" Foreground="#A1A1AA" FontWeight="SemiBold" />
                        <TextBlock x:Name="TxtVersaoNova" Text="v0.8.34" FontSize="15" FontWeight="Black" Foreground="#4ADE80" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- NOTAS DA VERSÃO -->
            <TextBlock Text="O que mudou nesta versão:" FontSize="11" FontWeight="Bold" Foreground="#A1A1AA" Margin="0,0,0,4" />
            <Border Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,14" MaxHeight="100">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="TxtReleaseNotes" Text="Melhorias no controle de licenças e atualização automática."
                               FontSize="11" Foreground="#E4E4E7" TextWrapping="Wrap" LineHeight="16" />
                </ScrollViewer>
            </Border>

            <!-- BARRA DE PROGRESSO DO DOWNLOAD (OCULTA INICIALMENTE) -->
            <StackPanel x:Name="PanelDownloadProgress" Visibility="Collapsed" Margin="0,0,0,14">
                <DockPanel Margin="0,0,0,4">
                    <TextBlock x:Name="TxtDownloadStatus" Text="Baixando atualização homologada..." FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" />
                    <TextBlock x:Name="TxtDownloadPercent" Text="0%" FontSize="11" Foreground="#4ADE80" FontWeight="Bold" HorizontalAlignment="Right" />
                </DockPanel>
                <ProgressBar x:Name="PbDownload" Height="8" Minimum="0" Maximum="100" Value="0" Background="#27272A" Foreground="#10B981" BorderThickness="0" />
            </StackPanel>

            <!-- BOTÕES DE AÇÃO -->
            <DockPanel x:Name="PanelBotoes">
                <Button Content="Lembrar Mais Tarde" HorizontalAlignment="Left" Padding="14,6" Background="#3F3F46" Foreground="White" BorderThickness="0" FontWeight="SemiBold" FontSize="11.5" Cursor="Hand" Click="BtnLembrarMaisTarde_Click" />
                <Button x:Name="BtnAtualizarAgora" Content="⚡ Atualizar Agora e Reiniciar" HorizontalAlignment="Right" Padding="16,6" Background="#16A34A" Foreground="White" BorderThickness="0" FontWeight="Black" FontSize="12" Cursor="Hand" Click="BtnAtualizarAgora_Click" />
            </DockPanel>
        </StackPanel>
    </Border>
</Window>

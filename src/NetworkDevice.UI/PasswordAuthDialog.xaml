<Window x:Class="NetworkDevice.UI.PasswordAuthDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SPARC — Autenticação de Acesso / Quebra de Senha"
        Icon="Assets/sparc.ico"
        Width="550" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Border Padding="20" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1">
        <StackPanel>
            <!-- CABEÇALHO -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border Background="#FEF3C7" CornerRadius="8" Width="40" Height="40" Margin="0,0,12,0">
                    <TextBlock Text="🔒" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtHeaderTitle" Text="Equipamento Protegido por Senha" FontWeight="Black" FontSize="15" Foreground="#881337" />
                    <TextBlock x:Name="TxtHeaderSubtitle" Text="O roteador está solicitando autenticação no console serial." FontSize="11" Foreground="#64748B" />
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="TxtExplanation"
                       Text="Se você possui as credenciais de acesso deste equipamento, informe-as abaixo para fazer login imediato e pular a etapa de zeramento. Caso contrário, o SPARC executará a recuperação de acesso de fábrica via BootWare (HPE Ctrl+B) / ROMMON (Cisco)."
                       FontSize="11.5" Foreground="#334155" TextWrapping="Wrap" LineHeight="17" Margin="0,0,0,14" />

            <!-- BANNER DE ERRO DE AUTENTICAÇÃO (VISÍVEL SE SENHA/LOGIN INCORRETO) -->
            <Border x:Name="BorderErrorBanner" Background="#FEF2F2" BorderBrush="#FECDD3" BorderThickness="1.5" CornerRadius="6" Padding="10,8" Margin="0,0,0,12" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠" FontSize="14" Foreground="#DC2626" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtErrorMessage" Text="Senha ou usuário incorretos. Informe nova combinação ou opte por zerar a configuração." FontSize="11" FontWeight="Bold" Foreground="#991B1B" TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- OPÇÃO 1: INFORMAR CREDENCIAIS CONHECIDAS (LOGIN DIRETO) -->
            <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1.5" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock x:Name="TxtOption1Title" Text="OPÇÃO 1: Tenho as Credenciais de Acesso (Login Direto)" FontWeight="Bold" FontSize="12" Foreground="#166534" Margin="0,0,0,10" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- LINHA USUÁRIO (DINÂMICA) -->
                        <TextBlock x:Name="LblUser" Grid.Row="0" Grid.Column="0" Text="Usuário (Login):" FontWeight="Bold" FontSize="11" Foreground="#374151" VerticalAlignment="Center" Margin="0,0,0,8" />
                        <TextBox x:Name="TxtUser" Grid.Row="0" Grid.Column="1" Padding="6,4" FontSize="11.5" Background="White" BorderBrush="#CBD5E1" Margin="0,0,0,8" />

                        <!-- LINHA SENHA -->
                        <TextBlock x:Name="LblPass" Grid.Row="1" Grid.Column="0" Text="Senha de Acesso:" FontWeight="Bold" FontSize="11" Foreground="#374151" VerticalAlignment="Center" />
                        <PasswordBox x:Name="TxtPass" Grid.Row="1" Grid.Column="1" Padding="6,4" FontSize="11.5" Background="White" BorderBrush="#CBD5E1" />
                    </Grid>

                    <Button x:Name="BtnLogin" Content="🔑 Testar Credenciais e Pular Zeramento" Padding="12,6" FontWeight="Bold" FontSize="11.5" Background="#16A34A" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnLogin_Click" />
                </StackPanel>
            </Border>

            <!-- OPÇÃO 2: ZERAMENTO DE FÁBRICA -->
            <Border Background="#FFF1F2" BorderBrush="#FECDD3" BorderThickness="1.5" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock x:Name="TxtOption2Title" Text="OPÇÃO 2: Não tenho as Credenciais (Zerar de Fábrica)" FontWeight="Bold" FontSize="12" Foreground="#991B1B" Margin="0,0,0,4" />
                    <TextBlock Text="O SPARC executará a quebra de senha via BootWare (HPE Ctrl+B) ou ROMMON (Cisco Break/Ctrl+C), apagando a configuração antiga e criando o acesso limpo."
                               FontSize="10.5" Foreground="#7F1D1D" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <TextBlock Text="👉 Ao optar pelo zeramento, siga estes passos:&#x0a;  1. Selecione o Modelo do Equipamento no Passo 1;&#x0a;  2. Carregue a Ficha SAIP (.pdf / .txt) no Passo 2;&#x0a;  3. (Opcional) Carregue o Firmware no Passo 3 se desejar atualizá-lo;&#x0a;  4. Clique em 'INICIAR PROVISIONAMENTO AUTOMÁTICO'."
                               FontSize="10" Foreground="#881337" TextWrapping="Wrap" Margin="0,0,0,8" FontWeight="SemiBold" LineHeight="15" />
                    <Button x:Name="BtnZerar" Content="⚡ Zerar Configuração e Quebrar Senha" Padding="12,6" FontWeight="Bold" FontSize="11.5" Background="#881337" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnZerar_Click" />
                </StackPanel>
            </Border>

            <!-- BOTÃO CANCELAR -->
            <DockPanel>
                <Button Content="Cancelar" HorizontalAlignment="Right" Padding="12,4" FontWeight="SemiBold" FontSize="11" Background="#E2E8F0" Foreground="#475569" BorderThickness="0" Cursor="Hand" Click="BtnCancelar_Click" />
            </DockPanel>
        </StackPanel>
    </Border>
</Window>

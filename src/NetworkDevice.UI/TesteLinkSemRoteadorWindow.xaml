<Window x:Class="NetworkDevice.UI.TesteLinkSemRoteadorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SPARC — Testar Link sem Roteador (Modo Acesso / WAN Direta)"
        Icon="Assets/sparc.ico"
        Height="820" Width="980"
        MinHeight="700" MinWidth="860"
        WindowStartupLocation="CenterOwner"
        Background="#0B0F19">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto" />
            <!-- 1: Conteúdo Principal -->
            <RowDefinition Height="*" />
            <!-- 2: Rodapé e Ações -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= 0: HEADER DA JANELA ================= -->
        <Border Grid.Row="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Image Source="Assets/sparc_logo_horizontal.png" Height="38" Margin="0,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                    <Border Background="#059669" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                        <TextBlock Text="🔌 ACESSO DIRETO" FontWeight="Black" FontSize="11.5" Foreground="#FFFFFF" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Teste de Link sem Roteador — Modo Access (EDD / GPON)" FontWeight="Bold" FontSize="13.5" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="Validação direta na porta de entrega usando o IP WAN no notebook (ICMP Google / Cloudflare / Speedtest)" FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Border Grid.Column="2" x:Name="BadgeStatus" Background="#334155" CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatusGeral" Text="⚪ PRONTO PARA TESTAR" FontWeight="Black" FontSize="12" Foreground="#FFFFFF" TextAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- ================= 1: CONTEÚDO PRINCIPAL ================= -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,0,6">

                <!-- CARD 1: DADOS DO CIRCUITO (FICHA SAIP / MANUAL) -->
                <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="📋 DADOS DO CIRCUITO (FICHA SAIP)" FontWeight="Black" FontSize="12.5" Foreground="#38BDF8" DockPanel.Dock="Left" />
                            <Border x:Name="BorderBadgeSaip" Background="#1E293B" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                <TextBlock x:Name="TxtBadgeSaip" Text="✓ Ficha SAIP Carregada" FontSize="10.5" FontWeight="Bold" Foreground="#4ADE80" />
                            </Border>
                        </DockPanel>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.2*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.4*" />
                            </Grid.ColumnDefinitions>

                            <!-- Cliente -->
                            <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="Cliente / Razão Social:" FontSize="10.5" Foreground="#94A3B8" />
                                    <TextBox x:Name="TxtClienteNome" Text="Identificando..." FontSize="12.5" FontWeight="Bold" Foreground="#F8FAFC" Background="Transparent" BorderThickness="0" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Designação -->
                            <Border Grid.Column="1" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="Designação IP / OTS:" FontSize="10.5" Foreground="#94A3B8" />
                                    <TextBox x:Name="TxtDesignacao" Text="—" FontSize="12.5" FontWeight="Bold" Foreground="#38BDF8" Background="Transparent" BorderThickness="0" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- CIR Nominal -->
                            <Border Grid.Column="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="Banda Contratada (CIR):" FontSize="10.5" Foreground="#94A3B8" />
                                    <TextBox x:Name="TxtVelocidadeCir" Text="100 Mbps" FontSize="12.5" FontWeight="Bold" Foreground="#F59E0B" Background="Transparent" BorderThickness="0" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Roteador PE -->
                            <Border Grid.Column="3" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,6">
                                <StackPanel>
                                    <TextBlock Text="Roteador PE Claro:" FontSize="10.5" Foreground="#94A3B8" />
                                    <TextBox x:Name="TxtPeRouter" Text="—" FontSize="12.5" FontWeight="Bold" Foreground="#A78BFA" Background="Transparent" BorderThickness="0" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Linha 2: Parâmetros IP WAN -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="IP WAN do Circuito (Notebook):" FontSize="10.5" Foreground="#94A3B8" />
                                    <TextBox x:Name="TxtWanIp" Text="10.0.0.2" FontSize="12.5" FontWeight="Bold" FontFamily="Consolas" Foreground="#34D399" Background="Transparent" BorderThickness="0" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="Máscara WAN (CIDR):" FontSize="10.5" Foreground="#94A3B8" />
                                    <TextBox x:Name="TxtWanMascara" Text="255.255.255.252" FontSize="12.5" FontFamily="Consolas" Foreground="#F8FAFC" Background="Transparent" BorderThickness="0" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="Gateway PE (Operadora):" FontSize="10.5" Foreground="#94A3B8" />
                                    <TextBox x:Name="TxtWanGateway" Text="10.0.0.1" FontSize="12.5" FontWeight="Bold" FontFamily="Consolas" Foreground="#38BDF8" Background="Transparent" BorderThickness="0" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,6">
                                <StackPanel>
                                    <TextBlock Text="DNS Primário / Secundário:" FontSize="10.5" Foreground="#94A3B8" />
                                    <TextBlock Text="1.1.1.1  /  8.8.8.8" FontSize="12" FontFamily="Consolas" Foreground="#CBD5E1" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- CARD 2: PLACA DE REDE DO NOTEBOOK (INTERFACE FÍSICA) -->
                <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="💻 PLACA DE REDE DO NOTEBOOK" FontWeight="Black" FontSize="12.5" Foreground="#38BDF8" DockPanel.Dock="Left" />
                            <Border x:Name="BorderStatusPlaca" Background="#1E293B" CornerRadius="4" Padding="8,2" HorizontalAlignment="Right">
                                <TextBlock x:Name="TxtStatusPlaca" Text="⚪ Checando placa..." FontSize="10.5" FontWeight="Bold" Foreground="#FBBF24" />
                            </Border>
                        </DockPanel>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.5*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0" x:Name="CmbAdaptadoresRede" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="8,6" FontSize="12" FontWeight="SemiBold" Margin="0,0,8,0" SelectionChanged="CmbAdaptadoresRede_SelectionChanged" />

                            <Button Grid.Column="1" x:Name="BtnAtualizarAdaptadores" Content="🔄 Atualizar" Padding="10,6" Margin="0,0,8,0" Background="#1E293B" Foreground="#38BDF8" BorderThickness="1" BorderBrush="#334155" Cursor="Hand" Click="BtnAtualizarAdaptadores_Click" ToolTip="Atualiza a lista de placas de rede conectadas" />

                            <Button Grid.Column="2" x:Name="BtnAplicarIpWan" Content="⚡ Aplicar IP WAN no Windows" Padding="12,6" Margin="0,0,8,0" Background="#059669" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnAplicarIpWan_Click" ToolTip="Configura o IP WAN estático, máscara, gateway e DNS 1.1.1.1/8.8.8.8 na placa de rede do Windows com rota prioritária" />

                            <Button Grid.Column="3" x:Name="BtnRestaurarDhcp" Content="↩ Restaurar DHCP" Padding="12,6" Background="#334155" Foreground="#CBD5E1" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnRestaurarDhcp_Click" ToolTip="Restaura a placa de rede para DHCP automático ou para a configuração original capturada" />
                        </Grid>

                        <TextBlock x:Name="TxtInfoAdaptador" Text="Selecione o adaptador Ethernet conectado ao cabo do circuito (porta de acesso EDD/GPON)." FontSize="11" Foreground="#64748B" Margin="2,2,0,0" />
                    </StackPanel>
                </Border>

                <!-- CARD 3: TESTES DE CONECTIVIDADE ICMP -->
                <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="📡 TESTES DE CONECTIVIDADE ICMP" FontWeight="Black" FontSize="12.5" Foreground="#38BDF8" DockPanel.Dock="Left" />
                            <Button x:Name="BtnTestarIcmp" Content="▶ Testar Pings ICMP" Padding="12,4" Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right" Click="BtnTestarIcmp_Click" ToolTip="Dispara sequência de pacotes ICMP para o Gateway PE, Google DNS e Cloudflare DNS" />
                        </DockPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 1. Gateway PE -->
                            <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,6,0">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="1. Gateway PE (Operadora)" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" DockPanel.Dock="Left" />
                                        <Border x:Name="BadgeIcmpPe" Background="#334155" CornerRadius="3" Padding="6,1" HorizontalAlignment="Right">
                                            <TextBlock x:Name="TxtBadgeIcmpPe" Text="⚪ PENDENTE" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                        </Border>
                                    </DockPanel>
                                    <TextBlock x:Name="TxtDestinoPe" Text="Alvo: 10.0.0.1" FontSize="11" FontFamily="Consolas" Foreground="#38BDF8" Margin="0,0,0,4" />
                                    <TextBlock x:Name="TxtMetricasPe" Text="RTT Médio: — | Perda: —" FontSize="11" Foreground="#94A3B8" />
                                </StackPanel>
                            </Border>

                            <!-- 2. Google DNS (8.8.8.8) -->
                            <Border Grid.Column="1" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,6,0">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="2. Google DNS (Internet)" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" DockPanel.Dock="Left" />
                                        <Border x:Name="BadgeIcmpGoogle" Background="#334155" CornerRadius="3" Padding="6,1" HorizontalAlignment="Right">
                                            <TextBlock x:Name="TxtBadgeIcmpGoogle" Text="⚪ PENDENTE" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                        </Border>
                                    </DockPanel>
                                    <TextBlock Text="Alvo: 8.8.8.8" FontSize="11" FontFamily="Consolas" Foreground="#38BDF8" Margin="0,0,0,4" />
                                    <TextBlock x:Name="TxtMetricasGoogle" Text="RTT Médio: — | Perda: —" FontSize="11" Foreground="#94A3B8" />
                                </StackPanel>
                            </Border>

                            <!-- 3. Cloudflare DNS (1.1.1.1) -->
                            <Border Grid.Column="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="3. Cloudflare DNS (Web)" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" DockPanel.Dock="Left" />
                                        <Border x:Name="BadgeIcmpCf" Background="#334155" CornerRadius="3" Padding="6,1" HorizontalAlignment="Right">
                                            <TextBlock x:Name="TxtBadgeIcmpCf" Text="⚪ PENDENTE" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                        </Border>
                                    </DockPanel>
                                    <TextBlock Text="Alvo: 1.1.1.1" FontSize="11" FontFamily="Consolas" Foreground="#38BDF8" Margin="0,0,0,4" />
                                    <TextBlock x:Name="TxtMetricasCf" Text="RTT Médio: — | Perda: —" FontSize="11" Foreground="#94A3B8" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- CARD 4: TESTE DE BANDA (SPEEDTEST) -->
                <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="🚀 TESTE DE LARGURA DE BANDA (SPEEDTEST)" FontWeight="Black" FontSize="12.5" Foreground="#38BDF8" DockPanel.Dock="Left" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ComboBox x:Name="CmbMetodoSpeedtest" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="6,3" FontSize="11" Margin="0,0,8,0">
                                    <ComboBoxItem Content="⚡ Nativo HTTP CDN (Fast/Cloudflare)" Tag="Nativo" IsSelected="True" />
                                    <ComboBoxItem Content="🚀 Speedtest CLI (Ookla)" Tag="Cli" />
                                </ComboBox>
                                <Button x:Name="BtnIniciarSpeedtest" Content="▶ Iniciar Speedtest" Padding="12,4" Background="#D97706" Foreground="White" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand" Click="BtnIniciarSpeedtest_Click" ToolTip="Executa medição de vazão em tempo real" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Métricas de Banda -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.4*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="Download Medido:" FontSize="10.5" Foreground="#94A3B8" />
                                    <TextBlock x:Name="TxtDownloadMbps" Text="0.0 Mbps" FontSize="18" FontWeight="Black" Foreground="#4ADE80" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="Upload Medido:" FontSize="10.5" Foreground="#94A3B8" />
                                    <TextBlock x:Name="TxtUploadMbps" Text="0.0 Mbps" FontSize="18" FontWeight="Black" Foreground="#38BDF8" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="Latência Speedtest:" FontSize="10.5" Foreground="#94A3B8" />
                                    <TextBlock x:Name="TxtLatenciaSpeedtest" Text="— ms" FontSize="18" FontWeight="Black" Foreground="#F59E0B" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                <StackPanel>
                                    <TextBlock Text="Veredito Regulatório (CIR):" FontSize="10.5" Foreground="#94A3B8" />
                                    <TextBlock x:Name="TxtVereditoBanda" Text="Aguardando teste..." FontSize="13" FontWeight="Bold" Foreground="#CBD5E1" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Barra de Progresso do Speedtest -->
                        <Grid Margin="0,0,0,4">
                            <ProgressBar x:Name="PbSpeedtest" Height="8" Background="#1E293B" Foreground="#059669" BorderThickness="0" Value="0" Maximum="100" />
                        </Grid>
                        <TextBlock x:Name="TxtProgressoSpeedtest" Text="Pronto para teste de banda." FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Right" />
                    </StackPanel>
                </Border>

                <!-- CARD 5: CONSOLE DE LOGS -->
                <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="14,10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="🖥️ LOG DE EXECUÇÃO" FontWeight="Black" FontSize="11.5" Foreground="#94A3B8" DockPanel.Dock="Left" />
                            <Button x:Name="BtnLimparLog" Content="Limpar" Padding="6,1" FontSize="10" Background="#1E293B" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right" Click="BtnLimparLog_Click" />
                        </DockPanel>

                        <Border Background="#0A0E14" CornerRadius="6" MaxHeight="140" Padding="8">
                            <ScrollViewer x:Name="ScrollLog" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="TxtLogConsole" Text="[LOG] Janela de Teste de Link Direto inicializada. Conecte o cabo ao acesso e clique em EXECUTAR TESTE COMPLETO." FontFamily="Consolas" FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ================= 2: RODAPÉ E AÇÕES ================= -->
        <Border Grid.Row="2" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnTesteCompleto" Content="🚀 EXECUTAR TESTE COMPLETO (IP + PING + BANDA)" Padding="14,8" Margin="0,0,8,0" Background="#059669" Foreground="White" FontWeight="Black" FontSize="12.5" BorderThickness="0" Cursor="Hand" Click="BtnTesteCompleto_Click" ToolTip="Executa em sequência: Configura IP WAN no Windows -> Testa Pings ICMP -> Executa Speedtest -> Emite Laudo Técnico em PDF" />

                    <Button x:Name="BtnVisualizarPdf" Content="📄 Abrir Laudo (PDF)" Padding="12,8" Margin="0,0,8,0" Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="12" BorderThickness="0" Cursor="Hand" Visibility="Collapsed" Click="BtnVisualizarPdf_Click" ToolTip="Abre o arquivo PDF gerado" />

                    <Button x:Name="BtnSalvarPdf" Content="💾 Salvar PDF como..." Padding="12,8" Margin="0,0,8,0" Background="#334155" Foreground="White" FontWeight="Bold" FontSize="12" BorderThickness="0" Cursor="Hand" Visibility="Collapsed" Click="BtnSalvarPdf_Click" ToolTip="Salva cópia do relatório técnico em PDF no local desejado" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnFechar" Content="Fechar" Padding="14,8" Background="#334155" Foreground="#CBD5E1" FontWeight="SemiBold" FontSize="12" BorderThickness="0" Cursor="Hand" Click="BtnFechar_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

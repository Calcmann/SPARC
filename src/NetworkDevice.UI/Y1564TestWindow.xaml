<Window x:Class="NetworkDevice.UI.Y1564TestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SPARC — Analisador de Dados &amp; Testes de Campo (ITU-T Y.1564 / Loop Digital VIAVI)"
        Icon="Assets/sparc.ico"
        Height="800" Width="1020"
        MinHeight="680" MinWidth="880"
        WindowStartupLocation="CenterOwner"
        Background="#0B0F19">

    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#111827" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#1E293B" />
                                <Setter Property="Foreground" Value="#38BDF8" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#1F2937" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto" />
            <!-- 1: Conteúdo Principal com Abas -->
            <RowDefinition Height="*" />
            <!-- 2: Rodapé Geral -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= 0: HEADER BAR GERAL ================= -->
        <Border Grid.Row="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Col 0: Logo e Título do Analisador -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Image Source="Assets/sparc_logo_horizontal.png" Height="34" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                    <Border Background="#0284C7" CornerRadius="4" Padding="7,3" VerticalAlignment="Center">
                        <TextBlock Text="📊 ANALISADOR DE DADOS" FontWeight="Black" FontSize="11" Foreground="#FFFFFF" />
                    </Border>
                </StackPanel>

                <!-- Col 1: Circuito e Descrição com TextTrimming seguro (evita sobreposição) -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="TxtHeaderCircuito" Text="Circuito: LFS/IP/02924 — NORTEL ELETR" FontWeight="Bold" FontSize="13" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="TxtHeaderSub" Text="Validação Ethernet ITU-T Y.1564 (e-SAM), Smart Loopback VIAVI/JDSU e Diagnóstico de MTU" FontSize="10.5" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Col 2: Ações Globais: Botão Recapturar IPs e Badge de Status -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button x:Name="BtnRefreshInterfaces" Content="🔄 Recapturar IPs / Interfaces" Padding="10,6" Margin="0,0,8,0" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#334155" BorderThickness="1" FontWeight="Bold" FontSize="11" ToolTip="Recaptura adaptadores de rede, novos endereços IPv4 e status físico de link." Click="BtnRefreshInterfaces_Click" />
                    <Border x:Name="BadgeStatus" Background="#334155" CornerRadius="4" Padding="10,6" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtStatusGeral" Text="⚪ PRONTO PARA TESTES" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" TextAlignment="Center" TextWrapping="NoWrap" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 1: ABAS DO ANALISADOR ================= -->
        <TabControl Grid.Row="1" x:Name="TcAnalisador" Background="Transparent" BorderThickness="0" Margin="0,0,0,10">

            <!-- ========================================================================= -->
            <!-- ABA 1: CERTIFICAÇÃO ITU-T Y.1564 (MASTER / GERADOR)                       -->
            <!-- ========================================================================= -->
            <TabItem Header="📜 Certificação ITU-T Y.1564 (Master)">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Painel de Parâmetros e Ajustes -->
                    <Border Grid.Row="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <!-- Seletor de Modo de Teste / Topologia -->
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="Topologia / Modo de Teste:" FontWeight="SemiBold" FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center" Margin="2,0,10,0" />
                                <ComboBox x:Name="CmbTestMode" Width="440" HorizontalAlignment="Left" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#0284C7" FontSize="11" Padding="6,3" SelectionChanged="CmbTestMode_SelectionChanged">
                                    <ComboBoxItem Content="🔄 Y.1564 Loopback Bidirecional (VIAVI / JDSU / SPARC Refletor)" Tag="loopback" IsSelected="True" ToolTip="Padrão Oficial ITU-T Y.1564. Requer Refletor/Loopback ativo na ponta remota (porta UDP 5001)." />
                                    <ComboBoxItem Content="⚡ Validação de Circuito contra Gateway / PE (Carga de Estresse sem Refletor)" Tag="gateway" ToolTip="Para testes contra o Gateway/PE (ex: 200.182.245.1) sem refletor UDP. Avalia capacidade sob estresse e saturação." />
                                </ComboBox>
                                <TextBlock x:Name="TxtModeDescription" Text="Mede vazão real L1 (Rx), perda (FLR) e latência de ida e volta." FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </DockPanel>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.8*" />
                                    <ColumnDefinition Width="0.8*" />
                                    <ColumnDefinition Width="1.0*" />
                                    <ColumnDefinition Width="2.0*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1.8*" />
                                </Grid.ColumnDefinitions>

                                <!-- Labels Linha 1 -->
                                <TextBlock x:Name="TxtRemoteIpLabel" Grid.Row="0" Grid.Column="0" Text="IP do QT Remoto (VIAVI):" FontSize="11" Foreground="#94A3B8" Margin="2,0,8,3" />
                                <TextBlock x:Name="TxtRemotePortLabel" Grid.Row="0" Grid.Column="1" Text="Porta UDP:" FontSize="11" Foreground="#94A3B8" Margin="2,0,8,3" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Banda CIR (Mbps):" FontSize="11" Foreground="#94A3B8" Margin="2,0,8,3" />
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="Quadro / MTU:" FontSize="11" Foreground="#94A3B8" Margin="2,0,8,3" />
                                <TextBlock Grid.Row="0" Grid.Column="4" Text="Duração:" FontSize="11" Foreground="#94A3B8" Margin="2,0,8,3" />
                                <TextBlock Grid.Row="0" Grid.Column="5" Text="Interface de Origem (PC):" FontSize="11" Foreground="#94A3B8" Margin="2,0,2,3" />

                                <!-- Inputs Linha 1 -->
                                <TextBox Grid.Row="1" Grid.Column="0" x:Name="TxtRemoteIp" Text="200.182.245.1" Background="#0F172A" Foreground="#38BDF8" BorderBrush="#334155" Padding="6,4" FontSize="12" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Endereço IP do testador remoto VIAVI/JDSU (QT)" />
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtRemotePort" Text="5001" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="6,4" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Porta UDP do reflector/responder (Padrão 5001 ou 862)" />
                                <TextBox Grid.Row="1" Grid.Column="2" x:Name="TxtTargetBandwidth" Text="200" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="6,4" FontSize="12" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Largura de banda nominal do circuito (CIR / ULR)" />

                                <ComboBox Grid.Row="1" Grid.Column="3" x:Name="CmbFrameSize" SelectedIndex="0" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="4,4" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <ComboBoxItem Content="1500 B (Fixo — Padrão Claro)" Tag="1500" />
                                    <ComboBoxItem Content="Variável / IMIX (64, 512, 1500 B)" Tag="imix" />
                                    <ComboBoxItem Content="Variável Completo (64 a 1500 B)" Tag="imix_full" />
                                    <ComboBoxItem Content="Variável c/ Jumbo (64 a 9000 B)" Tag="imix_jumbo" />
                                    <ComboBoxItem Content="9000 B (Jumbo Frame)" Tag="9000" />
                                    <ComboBoxItem Content="9216 B (Jumbo Frame Max)" Tag="9216" />
                                    <ComboBoxItem Content="1024 B (Fixo)" Tag="1024" />
                                    <ComboBoxItem Content="512 B (Fixo)" Tag="512" />
                                    <ComboBoxItem Content="256 B (Fixo)" Tag="256" />
                                    <ComboBoxItem Content="128 B (Fixo)" Tag="128" />
                                    <ComboBoxItem Content="64 B (Fixo)" Tag="64" />
                                </ComboBox>

                                <ComboBox Grid.Row="1" Grid.Column="4" x:Name="CmbDuration" SelectedIndex="0" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="4,4" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <ComboBoxItem Content="15 minutos (Oficial Claro)" Tag="15" />
                                    <ComboBoxItem Content="5 minutos (Rápido)" Tag="5" />
                                    <ComboBoxItem Content="1 minuto (Expresso)" Tag="1" />
                                    <ComboBoxItem Content="30 segundos (Lab)" Tag="0.5" />
                                </ComboBox>

                                <ComboBox Grid.Row="1" Grid.Column="5" x:Name="CmbSourceInterface" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="4,4" FontSize="11" VerticalAlignment="Center" ToolTip="Selecione o adaptador de rede local utilizado no teste" />
                            </Grid>

                            <!-- Linha 2: Taxas Limites de Falha e Parâmetros de SLA (Totalmente Customizáveis) -->
                            <Border Background="#0A0E1A" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.2*" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="2.5*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Perfil MEF -->
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Perfil MEF / Distância (E-ACCESS):" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3" />
                                        <ComboBox x:Name="CmbMefTier" SelectedIndex="0" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="6,4" FontSize="11" SelectionChanged="CmbMefTier_SelectionChanged">
                                            <ComboBoxItem Content="≤ 1200 Km (Interestadual)" Tag="1200" />
                                            <ComboBoxItem Content="≤ 250 Km (Metropolitano)" Tag="250" />
                                            <ComboBoxItem Content="≤ 7000 Km (Nacional Extremo)" Tag="7000" />
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- FLR Max % -->
                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Text="FLR Máx (% Perda):" FontSize="11" Foreground="#F59E0B" FontWeight="Bold" Margin="0,0,0,3" />
                                        <TextBox x:Name="TxtSlaLossInput" Text="0.02" Background="#0F172A" Foreground="#F59E0B" BorderBrush="#334155" Padding="6,4" FontSize="11.5" FontWeight="Bold" TextChanged="TxtSlaLossInput_TextChanged" ToolTip="Limite de perda de quadros (FLR). Padrão 0.02%" />
                                    </StackPanel>

                                    <!-- FTD Max ms -->
                                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                        <TextBlock Text="FTD Máx (Delay ms):" FontSize="11" Foreground="#34D399" FontWeight="Bold" Margin="0,0,0,3" />
                                        <TextBox x:Name="TxtSlaDelayInput" Text="250" Background="#0F172A" Foreground="#34D399" BorderBrush="#334155" Padding="6,4" FontSize="11.5" FontWeight="Bold" TextChanged="TxtSlaDelayInput_TextChanged" ToolTip="Limite de latência / atraso de quadros (FTD) em ms" />
                                    </StackPanel>

                                    <!-- IFDV Max ms -->
                                    <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                        <TextBlock Text="IFDV Máx (Jitter ms):" FontSize="11" Foreground="#A78BFA" FontWeight="Bold" Margin="0,0,0,3" />
                                        <TextBox x:Name="TxtSlaJitterInput" Text="160" Background="#0F172A" Foreground="#A78BFA" BorderBrush="#334155" Padding="6,4" FontSize="11.5" FontWeight="Bold" TextChanged="TxtSlaJitterInput_TextChanged" ToolTip="Limite de variação de atraso / jitter (IFDV) em ms" />
                                    </StackPanel>

                                    <!-- Resumo das regras -->
                                    <Border Grid.Column="4" Background="#111827" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtMefTierSummary" Text="Regra SLA: FLR &lt;= 0.02% | FTD &lt;= 250ms | IFDV &lt;= 160ms" FontSize="10.5" Foreground="#38BDF8" FontFamily="Consolas" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Cards de Métricas em Tempo Real -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: L1 Mbps -->
                        <Border Grid.Column="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock x:Name="TxtMetricRxRateHeader" Text="L1 Mbps (ULR)" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" TextAlignment="Center" />
                                <TextBlock x:Name="TxtMetricRxRate" Text="— Mbps" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" TextAlignment="Center" Margin="0,3,0,1" />
                                <TextBlock x:Name="TxtMetricTargetRate" Text="Alvo: 200 Mbps" FontSize="10.5" Foreground="#94A3B8" TextAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Loss -->
                        <Border Grid.Column="1" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock x:Name="TxtMetricLossHeader" Text="Loss (Perda de Quadros)" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" TextAlignment="Center" />
                                <TextBlock x:Name="TxtMetricLoss" Text="— %" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" TextAlignment="Center" Margin="0,3,0,1" />
                                <TextBlock x:Name="TxtSlaLoss" Text="SLA FLR: &lt;= 0.02%" FontSize="10.5" Foreground="#94A3B8" TextAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Card 3: FD (Delay) -->
                        <Border Grid.Column="2" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="FD (Delay / Latência)" FontSize="11" FontWeight="Bold" Foreground="#34D399" TextAlignment="Center" />
                                <TextBlock x:Name="TxtMetricDelay" Text="— ms" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" TextAlignment="Center" Margin="0,3,0,1" />
                                <TextBlock x:Name="TxtMetricDelayMinMax" Text="Min: — | Max: —" FontSize="10" Foreground="#94A3B8" TextAlignment="Center" />
                                <TextBlock x:Name="TxtSlaDelay" Text="SLA FTD: &lt;= 250 ms" FontSize="10" Foreground="#64748B" TextAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Card 4: FDV (Jitter) -->
                        <Border Grid.Column="3" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="12,8">
                            <StackPanel>
                                <TextBlock Text="FDV (Jitter)" FontSize="11" FontWeight="Bold" Foreground="#A78BFA" TextAlignment="Center" />
                                <TextBlock x:Name="TxtMetricJitter" Text="— ms" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" TextAlignment="Center" Margin="0,3,0,1" />
                                <TextBlock x:Name="TxtMetricJitterMax" Text="Max: —" FontSize="10" Foreground="#94A3B8" TextAlignment="Center" />
                                <TextBlock x:Name="TxtSlaJitter" Text="SLA IFDV: &lt;= 160 ms" FontSize="10" Foreground="#64748B" TextAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Progresso e Contadores -->
                    <Border Grid.Row="2" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock x:Name="TxtTimeRemaining" Text="Tempo: 00:00:00 / 00:15:00 (0%)" FontSize="11.5" FontWeight="SemiBold" Foreground="#F8FAFC" DockPanel.Dock="Left" />
                                <TextBlock x:Name="TxtPacketCounters" Text="Tx: 0 | Rx: 0 | Perdidos: 0 (0.00%) | OOS: 0" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Right" FontFamily="Consolas" />
                            </DockPanel>
                            <ProgressBar x:Name="PbTestProgress" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="#DC2626" Background="#1E293B" BorderThickness="0" />
                        </StackPanel>
                    </Border>

                    <!-- Log em Tempo Real -->
                    <Border Grid.Row="3" Background="#030712" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,10">
                        <TextBox x:Name="TxtLogOutput" IsReadOnly="True" Background="Transparent" Foreground="#38BDF8" CaretBrush="#38BDF8" FontFamily="Consolas, Cascadia Mono, Courier New" FontSize="11" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" />
                    </Border>

                    <!-- Botões de Ação da Aba 1 -->
                    <Border Grid.Row="4" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="10,8">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Button x:Name="BtnIniciar" Content="▶ Iniciar Certificação Y.1564" Padding="14,6" Margin="0,0,8,0" Background="#DC2626" Foreground="White" FontWeight="Bold" FontSize="12.5" BorderThickness="0" Click="BtnIniciar_Click" />
                                <Button x:Name="BtnInterromper" Content="⏹ Interromper" Padding="12,6" Margin="0,0,8,0" Background="#B91C1C" Foreground="White" FontWeight="Bold" FontSize="12" BorderThickness="0" IsEnabled="False" Click="BtnInterromper_Click" />
                                <Button x:Name="BtnY1564Zerar" Content="🧹 Limpar Resultados" Padding="12,6" Margin="0,0,8,0" Background="#334155" Foreground="White" FontWeight="Bold" FontSize="12" BorderThickness="0" ToolTip="Limpa os resultados, métricas e log da certificação anterior." Click="BtnY1564Zerar_Click" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="BtnVisualizarPdf" Content="📄 Visualizar Certidão (PDF)" Padding="12,6" Margin="0,0,8,0" Background="#059669" Foreground="White" FontWeight="Bold" FontSize="12" BorderThickness="0" Visibility="Collapsed" Click="BtnVisualizarPdf_Click" />
                                <Button x:Name="BtnSalvarPdfComo" Content="💾 Salvar PDF como..." Padding="12,6" Background="#3F3F46" Foreground="White" FontWeight="Bold" FontSize="12" BorderThickness="0" Visibility="Collapsed" Click="BtnSalvarPdfComo_Click" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========================================================================= -->
            <!-- ABA 2: LOOP DIGITAL (SMART REFLECTOR L3/L4 COMPATÍVEL VIAVI / JDSU)       -->
            <!-- ========================================================================= -->
            <TabItem Header="🔄 Loop Digital (Refletor VIAVI)">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Banner de Orientação e Configuração -->
                    <Border Grid.Row="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="🔄 MODO REFLETOR DIGITAL (SMART LOOPBACK)" FontWeight="Black" FontSize="14" Foreground="#38BDF8" />
                                    <TextBlock Text="O notebook reflete tráfego de teste em tempo real (L3/L4 Swap). A equipe na central com VIAVI/JDSU executa testes RFC 2544 / Y.1564 contra este host." FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                                </StackPanel>
                                <Border x:Name="BadgeLoopStatus" Background="#27272A" CornerRadius="4" Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtLoopStatus" Text="⚪ LOOP DIGITAL DESLIGADO" FontWeight="Black" FontSize="11.5" Foreground="#A1A1AA" />
                                </Border>
                            </DockPanel>

                            <!-- Banner de Alerta / Instalação do Npcap -->
                            <Border x:Name="PnlNpcapWarning" Background="#2A1B0A" BorderBrush="#D97706" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10" Visibility="Collapsed">
                                <DockPanel LastChildFill="True">
                                    <Button x:Name="BtnInstalarNpcap" DockPanel.Dock="Right" Content="⬇️ Instalar Npcap Agora" Padding="10,4" Background="#D97706" Foreground="White" FontWeight="Bold" FontSize="11" BorderThickness="0" Margin="10,0,0,0" Click="BtnInstalarNpcap_Click" />
                                    <TextBlock VerticalAlignment="Center" FontSize="11.5" Foreground="#FDE68A" Text="⚠️ O driver Npcap não foi detectado. Para fechar loop promíscuo no padrão MTS-5800 (L2/L3 Swap com Acterna BERT/IPoE), instale o Npcap." TextWrapping="Wrap" />
                                </DockPanel>
                            </Border>

                            <!-- Parâmetros de Escuta do Loop -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.0*" />
                                    <ColumnDefinition Width="2.0*" />
                                    <ColumnDefinition Width="0.9*" />
                                    <ColumnDefinition Width="2.2*" />
                                </Grid.ColumnDefinitions>

                                <!-- Placa de Rede / IP -->
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <DockPanel Margin="0,0,0,3">
                                        <TextBlock Text="Interface / IP de Escuta:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                                        <Button x:Name="BtnLoopRefreshNic" Content="🔄 Recapturar" Padding="5,1" HorizontalAlignment="Right" Background="Transparent" Foreground="#38BDF8" BorderBrush="#334155" BorderThickness="1" FontSize="10" FontWeight="Bold" ToolTip="Recaptura adaptadores de rede, novos endereços IP e status do link." Click="BtnRefreshInterfaces_Click" />
                                    </DockPanel>
                                    <ComboBox x:Name="CmbLoopInterface" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="6,4" FontSize="11" SelectionChanged="CmbLoopInterface_SelectionChanged" />
                                </StackPanel>

                                <!-- Modo de Operação do Loop -->
                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                    <TextBlock Text="Modo de Reflexão (Loopback):" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3" />
                                    <ComboBox x:Name="CmbLoopMode" SelectedIndex="0" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="6,4" FontSize="11" SelectionChanged="CmbLoopMode_SelectionChanged">
                                        <ComboBoxItem Content="🔄 L3 Wire Swap (MTS-5800 / Acterna BERT / L3)" Tag="PromiscuousL3" />
                                        <ComboBoxItem Content="🔄 L2 Wire Swap (MTS-5800 MAC Swap)" Tag="PromiscuousL2" />
                                        <ComboBoxItem Content="🌐 L4 UDP Socket (RFC 2544 / IP SLA / Iperf)" Tag="UdpSocket" />
                                    </ComboBox>
                                </StackPanel>

                                <!-- Porta UDP (ativa apenas no modo L4) -->
                                <StackPanel x:Name="PnlLoopPort" Grid.Column="2" Margin="0,0,10,0">
                                    <TextBlock Text="Porta UDP:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3" />
                                    <TextBox x:Name="TxtLoopPort" Text="5001" Background="#0F172A" Foreground="#38BDF8" BorderBrush="#334155" Padding="6,4" FontSize="12" FontWeight="Bold" ToolTip="Porta UDP de escuta (5001 = VIAVI/JDSU/Iperf; 5800 = MTS-5800; 862 = TWAMP)" IsEnabled="False" />
                                </StackPanel>

                                <!-- Botões de Iniciar / Parar / Zerar Loop -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                                    <Button x:Name="BtnLoopIniciar" Content="🟢 Ligar Loop Digital" Padding="13,7" Margin="0,0,6,0" Background="#059669" Foreground="White" FontWeight="Black" FontSize="12.5" BorderThickness="0" Click="BtnLoopIniciar_Click" />
                                    <Button x:Name="BtnLoopParar" Content="⏹ Desligar" Padding="11,7" Margin="0,0,6,0" Background="#B91C1C" Foreground="White" FontWeight="Bold" FontSize="12" BorderThickness="0" IsEnabled="False" Click="BtnLoopParar_Click" />
                                    <Button x:Name="BtnLoopZerar" Content="🧹 Zerar Dados" Padding="11,7" Background="#334155" Foreground="#F8FAFC" FontWeight="Bold" FontSize="12" BorderThickness="0" ToolTip="Zera contadores de pacotes, volume de teste acumulado e limpa o log em tempo real." Click="BtnLoopZerar_Click" />
                                </StackPanel>
                            </Grid>

                            <!-- Barra de Otimizações de Performance & Anti-Bufferbloat (JDSU / VIAVI 120M - 1G) -->
                            <Border Background="#090D16" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.0*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="1.8*" />
                                        <ColumnDefinition Width="2.2*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Buffer Anti-Bufferbloat -->
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Buffer do Driver (Anti-Bufferbloat):" FontSize="10.5" Foreground="#94A3B8" Margin="0,0,0,3" />
                                        <ComboBox x:Name="CmbLoopBufferSize" SelectedIndex="0" Background="#0F172A" Foreground="#38BDF8" BorderBrush="#334155" Padding="6,3" FontSize="11" FontWeight="SemiBold">
                                            <ComboBoxItem Content="⚡ 4 MB — Balanceado (200M a 1G / &lt; 10ms)" Tag="4194304" ToolTip="Recomendado para 200 Mbps a 1 Gbps. Evita micro-descartes e mantém latência em ~9ms (SLA 74ms)." />
                                            <ComboBoxItem Content="⚡ 2 MB — Ultra Baixa Latência (&lt; 2ms / até 100M)" Tag="2097152" ToolTip="Ideal para circuitos até 100 Mbps com foco em latência ultra-baixa." />
                                            <ComboBoxItem Content="📦 8 MB — Alta Capacidade (Ideal 500M - 1 Gbps)" Tag="8388608" ToolTip="Absorve rajadas intensas em CPUs modestas sem perda de quadros." />
                                            <ComboBoxItem Content="🐘 16 MB — Máxima Retenção" Tag="16777216" ToolTip="Tamanho legado. Suporta rajadas massivas, mas atrasa pacotes sob saturação." />
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Workers Paralelos -->
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="Workers Paralelos:" FontSize="10.5" Foreground="#94A3B8" Margin="0,0,0,3" />
                                        <ComboBox x:Name="CmbLoopWorkers" SelectedIndex="0" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="6,3" FontSize="11">
                                            <ComboBoxItem Content="⚡ Auto (Multi-core)" Tag="0" />
                                            <ComboBoxItem Content="2 Workers" Tag="2" />
                                            <ComboBoxItem Content="4 Workers" Tag="4" />
                                            <ComboBoxItem Content="8 Workers" Tag="8" />
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Filtro BPF em Kernel -->
                                    <StackPanel Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <CheckBox x:Name="ChkLoopBpfFilter" Content="🛡️ Filtro BPF em Kernel" IsChecked="True" Foreground="#34D399" FontSize="11" FontWeight="SemiBold" ToolTip="Descarta ruídos do Windows (NetBIOS, mDNS, SSDP) direto no driver Npcap sem consumir CPU." />
                                        <TextBlock Text="Bloqueia ruídos de rede no driver" FontSize="10" Foreground="#64748B" Margin="20,2,0,0" />
                                    </StackPanel>

                                    <!-- Diagnóstico do Link Físico (Placa de Rede) -->
                                    <Border Grid.Column="3" Background="#111827" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                        <StackPanel>
                                            <TextBlock Text="Status Físico da Placa Selecionada:" FontSize="9.5" Foreground="#94A3B8" />
                                            <TextBlock x:Name="TxtLoopNicSpeedBadge" Text="Detectando link..." FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,2,0,0" FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Cards de Métricas em Tempo Real do Loop -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1.4*" />
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Rx Mbps -->
                        <Border Grid.Column="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Taxa Rx (Recebida)" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" TextAlignment="Center" />
                                <TextBlock x:Name="TxtLoopRxMbps" Text="0.00 Mbps" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" TextAlignment="Center" Margin="0,3,0,1" />
                                <TextBlock x:Name="TxtLoopRxPps" Text="0 pps" FontSize="10.5" Foreground="#94A3B8" TextAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Tx Mbps Refletido -->
                        <Border Grid.Column="1" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Taxa Tx (Refletida)" FontSize="11" FontWeight="Bold" Foreground="#34D399" TextAlignment="Center" />
                                <TextBlock x:Name="TxtLoopTxMbps" Text="0.00 Mbps" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" TextAlignment="Center" Margin="0,3,0,1" />
                                <TextBlock x:Name="TxtLoopTxPps" Text="0 pps" FontSize="10.5" Foreground="#94A3B8" TextAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Pacotes Totais -->
                        <Border Grid.Column="2" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Pacotes Refletidos" FontSize="11" FontWeight="Bold" Foreground="#A78BFA" TextAlignment="Center" />
                                <TextBlock x:Name="TxtLoopTotalPkts" Text="0" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" TextAlignment="Center" Margin="0,3,0,1" />
                                <TextBlock x:Name="TxtLoopPktsRxVsTx" Text="Rx: 0 | Tx: 0" FontSize="10.5" Foreground="#94A3B8" TextAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Card 4: Volume Total -->
                        <Border Grid.Column="3" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Volume de Dados" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" TextAlignment="Center" />
                                <TextBlock x:Name="TxtLoopTotalBytes" Text="0.00 MB" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" TextAlignment="Center" Margin="0,3,0,1" />
                                <TextBlock x:Name="TxtLoopUptime" Text="Tempo: 00:00:00" FontSize="10.5" Foreground="#94A3B8" TextAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Card 5: Testador Remoto Detectado -->
                        <Border Grid.Column="4" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="Testador Remoto Detectado" FontSize="11" FontWeight="Bold" Foreground="#F43F5E" TextAlignment="Center" />
                                <TextBlock x:Name="TxtLoopLastRemote" Text="Aguardando tráfego..." FontSize="13.5" FontWeight="SemiBold" Foreground="#F8FAFC" TextAlignment="Center" Margin="0,5,0,2" TextTrimming="CharacterEllipsis" FontFamily="Consolas" />
                                <TextBlock Text="IP e Porta do VIAVI / JDSU" FontSize="10" Foreground="#94A3B8" TextAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Log do Loop Digital em Tempo Real -->
                    <Border Grid.Row="2" Background="#030712" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="2,0,2,6">
                                <TextBlock Text="📋 REGISTRO DE TRÁFEGO DO REFLETOR" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" />
                                <Button Content="🧹 Limpar Log" Padding="8,2" HorizontalAlignment="Right" Background="#1E293B" Foreground="#94A3B8" BorderThickness="0" FontSize="10.5" FontWeight="SemiBold" Click="BtnLimparLogLoop_Click" />
                            </DockPanel>
                            <TextBox Grid.Row="1" x:Name="TxtLoopLogOutput" IsReadOnly="True" Background="Transparent" Foreground="#34D399" CaretBrush="#34D399" FontFamily="Consolas, Cascadia Mono, Courier New" FontSize="11" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" />
                        </Grid>
                    </Border>

                    <!-- Comandos Úteis de Loop no Roteador -->
                    <Border Grid.Row="3" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="10,8">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="💡 Alternativa Roteador:" FontWeight="Bold" FontSize="11.5" Foreground="#E2E8F0" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Para responder via Cisco IOS diretamente: comando 'ip sla responder'" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="📋 Copiar Comando Cisco (ip sla responder)" Padding="8,4" Background="#334155" Foreground="White" FontSize="11" FontWeight="SemiBold" BorderThickness="0" Click="BtnCopiarComandoCiscoSla_Click" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========================================================================= -->
            <!-- ABA 3: TESTE DE MTU & CONECTIVIDADE (PATH MTU DISCOVERY)                   -->
            <!-- ========================================================================= -->
            <TabItem Header="📏 Teste de MTU (Path MTU)">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Painel de Disparo do Teste de MTU -->
                    <Border Grid.Row="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="📏 DESCOBERTA DE PATH MTU &amp; SUPORTE A JUMBO FRAMES" FontWeight="Black" FontSize="14" Foreground="#38BDF8" />
                            <TextBlock Text="Verifica se o caminho até o Gateway ou QT suporta MTU 1500 bytes (Padrão Claro) ou Jumbo Frames (9000 bytes) sem fragmentação usando bit Don't Fragment (DF)." FontSize="11" Foreground="#94A3B8" Margin="0,2,0,8" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.5*" />
                                    <ColumnDefinition Width="2.0*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="IP de Destino (Gateway WAN / QT Remoto):" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3" />
                                    <TextBox x:Name="TxtMtuTargetIp" Text="200.182.245.1" Background="#0F172A" Foreground="#38BDF8" BorderBrush="#334155" Padding="6,5" FontSize="12" FontWeight="Bold" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Left">
                                    <Button x:Name="BtnMtuTestar" Content="🔍 Executar Teste de MTU" Padding="14,7" Margin="0,0,8,0" Background="#0284C7" Foreground="White" FontWeight="Black" FontSize="12.5" BorderThickness="0" Click="BtnMtuTestar_Click" />
                                    <Button x:Name="BtnMtuZerar" Content="🧹 Limpar Teste" Padding="12,7" Background="#334155" Foreground="White" FontWeight="Bold" FontSize="12" BorderThickness="0" ToolTip="Limpa os resultados e log do teste de MTU." Click="BtnMtuZerar_Click" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Cards de Resultado do MTU -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: MTU Máximo -->
                        <Border Grid.Column="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="MTU Máximo Detectado" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" TextAlignment="Center" />
                                <TextBlock x:Name="TxtMtuDetected" Text="— Bytes" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" TextAlignment="Center" Margin="0,4,0,2" />
                                <TextBlock x:Name="TxtMtuStatusBadge" Text="Aguardando teste..." FontSize="11" Foreground="#94A3B8" TextAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Jumbo Frame -->
                        <Border Grid.Column="1" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Jumbo Frame (9000 B)" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" TextAlignment="Center" />
                                <TextBlock x:Name="TxtMtuJumboSupport" Text="—" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" TextAlignment="Center" Margin="0,4,0,2" />
                                <TextBlock Text="Suporte a pacotes estendidos" FontSize="11" Foreground="#94A3B8" TextAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Card 3: RTT Base -->
                        <Border Grid.Column="2" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="Latência RTT Base" FontSize="11" FontWeight="Bold" Foreground="#34D399" TextAlignment="Center" />
                                <TextBlock x:Name="TxtMtuRtt" Text="— ms" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" TextAlignment="Center" Margin="0,4,0,2" />
                                <TextBlock Text="Tempo de ida e volta ICMP" FontSize="11" Foreground="#94A3B8" TextAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Log do Teste de MTU -->
                    <Border Grid.Row="2" Background="#030712" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="8">
                        <TextBox x:Name="TxtMtuLogOutput" IsReadOnly="True" Background="Transparent" Foreground="#38BDF8" CaretBrush="#38BDF8" FontFamily="Consolas, Cascadia Mono, Courier New" FontSize="11" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" />
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ================= 2: RODAPÉ GERAL ================= -->
        <Border Grid.Row="2" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="12,8">
            <DockPanel>
                <TextBlock Text="SPARC — Sistema de Provisionamento e Ativação de Roteadores da Claro | ITU-T Y.1564 &amp; VIAVI Compatible" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" DockPanel.Dock="Left" />
                <Button Content="Fechar Analisador" Padding="16,6" Background="#374151" Foreground="White" FontSize="12" FontWeight="Bold" BorderThickness="0" HorizontalAlignment="Right" Click="BtnFechar_Click" />
            </DockPanel>
        </Border>
    </Grid>
</Window>

<Window x:Class="NetworkDevice.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SPARC — Sistema de Provisionamento e Ativação de Roteadores Claro"
        Icon="Assets/sparc.ico"
        Height="820" Width="1060"
        MinHeight="700" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="#18181B"
        Loaded="Window_Loaded"
        PreviewKeyDown="MainWindow_PreviewKeyDown">

    <Window.Resources>
        <!-- Gradiente Claro S.A. (Vinho #881337 para Vermelho #DA291C) -->
        <LinearGradientBrush x:Key="ClaroGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#B91C1C" Offset="0.0" />
            <GradientStop Color="#EE1C25" Offset="1.0" />
        </LinearGradientBrush>
        
        <LinearGradientBrush x:Key="ClaroGradientHoverBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#C02020" Offset="0.0" />
            <GradientStop Color="#EE1C25" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="BetaBadgeBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1A0505" Offset="0.0" />
            <GradientStop Color="#B91C1C" Offset="0.5" />
            <GradientStop Color="#EE1C25" Offset="1.0" />
        </LinearGradientBrush>

        <!-- CTA Button: estado desabilitado visível com borda e texto em opacidade média -->
        <Style x:Key="CtaPrimaryStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ClaroGradientBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#EE1C25"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#55EE1C25"/>
                                <Setter Property="Foreground" Value="#55FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{StaticResource ClaroGradientHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="4">

        <!-- ========================================================================= -->
        <!-- 1. TELA INICIAL DE ABERTURA: DEFINIÇÃO DE INSUMOS DO CIRCUITO             -->
        <!-- ========================================================================= -->
        <Grid x:Name="GridTelaInicial" Visibility="Visible">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Background="#27272A" BorderBrush="#52525B" BorderThickness="1" CornerRadius="10" Padding="14,10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="2">
                <StackPanel>
                    <!-- CABEÇALHO COMPACTO E LIMPO -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,8">
                        <Border Background="{StaticResource BetaBadgeBrush}" CornerRadius="10" Padding="12,2.5" HorizontalAlignment="Center" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔴" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="VERSÃO BETA — CLARO S.A. — ATIVAÇÃO SC" FontWeight="Black" FontSize="11.5" Foreground="#FFFFFF" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="SPARC — Sistema de Provisionamento e Ativação de Roteadores" FontWeight="Black" FontSize="18" Foreground="#EE1C25" HorizontalAlignment="Center" />
                        <TextBlock Text="Configure o equipamento, informe os dados e escolha como deseja executar o provisionamento."
                                   FontSize="13" Foreground="#A1A1AA" Margin="0,2,0,0" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- ======================================================== -->
                    <!-- PASSO 1: EQUIPAMENTO & SERIAL                             -->
                    <!-- ======================================================== -->
                    <Border Background="#27272A" BorderBrush="#52525B" BorderThickness="3.5,1,1,1" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,5">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#B91C1C" CornerRadius="10" Width="26" Height="26" Margin="0,0,7,0">
                                        <TextBlock Text="1" FontWeight="Black" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Equipamento &amp; Porta Serial" FontWeight="Black" FontSize="13.5" Foreground="#EE1C25" VerticalAlignment="Center" />
                                    <TextBlock Text="• Escolha o modelo e valide a comunicação" FontSize="11.5" Foreground="#71717A" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border x:Name="BadgeStep1" Background="#3B1818" CornerRadius="4" Padding="8,3" HorizontalAlignment="Right">
                                    <TextBlock x:Name="TxtBadgeStep1" Text="🔴 Modelo e Serial Pendentes" FontSize="11" FontWeight="Bold" Foreground="#FCA5A5" />
                                </Border>
                            </DockPanel>

                            <DockPanel VerticalAlignment="Center" LastChildFill="True">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnTestarAvaliarInicial" Content="🔌 Testar Conexão Porta Serial" Padding="12,6" Margin="0,0,14,0" FontSize="12" FontWeight="Bold" Background="#B91C1C" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnTestarAvaliar_Click" ToolTip="Testa a porta serial e avalia situação do equipamento (senha, modelo, versão, flash e configuração)" />
                                    <TextBlock Text="Porta:" FontWeight="Black" FontSize="13.5" Foreground="#EE1C25" VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <ComboBox x:Name="CbPortaInicial" Width="85" IsEditable="True" SelectionChanged="CbPortaInicial_SelectionChanged" />
                                    <Button Content="🔄" Padding="4,5" Margin="3,0,0,0" ToolTip="Atualizar portas COM" Click="BtnAtualizarPortas_Click" />
                                    <TextBlock x:Name="TxtSerialTestStatus" Text="" VerticalAlignment="Center" Margin="10,0,16,0" FontSize="11" FontWeight="SemiBold" Foreground="#4ADE80" MaxWidth="160" />
                                </StackPanel>
                                <ComboBox x:Name="CbModeloRoteadorInicial" SelectedIndex="0" FontSize="13" FontWeight="Bold" Padding="6,8" VerticalAlignment="Center" SelectionChanged="CbModeloRoteadorInicial_SelectionChanged" PreviewMouseLeftButtonDown="CbModeloRoteadorInicial_PreviewMouseLeftButtonDown" ToolTip="Clique em qualquer ponto do campo para abrir a lista">
                                    <ComboBoxItem Content="— Selecione o modelo do equipamento —" Tag="" IsEnabled="False" />
                                    <ComboBoxItem Content="🖧 HPE MSR 954 / 958 (Ctrl+B @ 9600 - BootWare)" Tag="hpe.msr954.ctrl-b" />
                                    <ComboBoxItem Content="🖧 HPE MSR 930 / 931 / 935 (Ctrl+B @ 9600 - BootWare)" Tag="hpe.msr930.ctrl-b" />
                                    <ComboBoxItem Content="🖧 HPE MSR 1002 / 1003 (Ctrl+B @ 9600 - BootWare)" Tag="hpe.msr1002.ctrl-b" />
                                    <ComboBoxItem Content="🖧 Cisco Série 1900 / 1921 / 1941 / 1905 (Break @ 9600 - ROMMON)" Tag="cisco.c1900.break" />
                                    <ComboBoxItem Content="🖧 Cisco Série 900 / C921-4P (Ctrl+C Puro @ 9600)" Tag="cisco.c900.ctrl-c" />
                                    <ComboBoxItem Content="🖧 Cisco Série 800 / C841M (Break @ 9600 - ROMMON)" Tag="cisco.c841.break" />
                                </ComboBox>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- ======================================================== -->
                    <!-- PASSO 2: DADOS DO CIRCUITO                                -->
                    <!-- ======================================================== -->
                    <Border Background="#27272A" BorderBrush="#52525B" BorderThickness="3.5,1,1,1" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,5">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#B91C1C" CornerRadius="10" Width="26" Height="26" Margin="0,0,7,0">
                                        <TextBlock Text="2" FontWeight="Black" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Dados do Circuito" FontWeight="Black" FontSize="13.5" Foreground="#EE1C25" VerticalAlignment="Center" />
                                    <TextBlock Text="• Importar Ficha SAIP ou informar dados manualmente" FontSize="11.5" Foreground="#71717A" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border x:Name="BadgeStep2" Background="#3B1818" CornerRadius="4" Padding="8,3" HorizontalAlignment="Right">
                                    <TextBlock x:Name="TxtBadgeStep2" Text="🔴 Circuito Pendente" FontSize="11" FontWeight="Bold" Foreground="#FCA5A5" />
                                </Border>
                            </DockPanel>

                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="Origem dos dados:" FontSize="12" FontWeight="SemiBold" Foreground="#A1A1AA" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <RadioButton x:Name="RbModoSaip" Content="Importar Ficha SAIP (PDF/TXT)" IsChecked="True" FontWeight="SemiBold" Foreground="#E4E4E7" Margin="0,0,14,0" Checked="RbModoInsumo_Checked" />
                                    <RadioButton x:Name="RbModoManual" Content="Informar manualmente (IPs, GW, VLAN)" FontWeight="SemiBold" Foreground="#E4E4E7" Checked="RbModoInsumo_Checked" />
                                </StackPanel>
                            </DockPanel>

                            <!-- CONTAINER DINÂMICO DOS MODOS DE INSUMO -->
                            <Border Background="#3F3F46" BorderBrush="#52525B" BorderThickness="1" CornerRadius="5" Padding="8">
                                <Grid>
                                    <!-- OPÇÃO 1: FICHA SAIP -->
                                    <StackPanel x:Name="GridInsumoSaip" Visibility="Visible">
                                        <DockPanel Margin="0,0,0,4">
                                            <Button x:Name="BtnCarregarSaip" Content="📂 Selecionar Arquivo SAIP (.pdf / .txt)" Padding="14,7" FontWeight="Black" FontSize="14" Background="#EE1C25" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnCarregarSaip_Click" MinWidth="220" />
                                            <Button x:Name="BtnLimparSaip" Content="✖ Limpar" Padding="10,5" Margin="6,0,0,0" Visibility="Collapsed" Click="BtnLimparSaip_Click" />
                                        </DockPanel>
                                        <Border Background="#27272A" BorderBrush="#52525B" BorderThickness="1" CornerRadius="4" Padding="6">
                                            <TextBlock x:Name="TxtSaipResumo" Text="Nenhuma ficha SAIP selecionada. Clique no botão acima para carregar o arquivo PDF ou TXT da ordem de serviço."
                                                       Foreground="#A1A1AA" FontSize="12.5" TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>

                                    <!-- OPÇÃO 2: ENTRADA MANUAL -->
                                    <StackPanel x:Name="PanelInsumoManual" Visibility="Collapsed">
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="1.5*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Designação:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#E4E4E7" Margin="0,0,4,0" FontSize="12.5" />
                                            <TextBox Grid.Column="1" x:Name="TxtManualDesignacao" Text="" Padding="4,5" Margin="0,0,8,0" TextChanged="TxtManual_TextChanged" />

                                            <TextBlock Grid.Column="2" Text="Nome do Cliente:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#E4E4E7" Margin="0,0,4,0" FontSize="12.5" />
                                            <TextBox Grid.Column="3" x:Name="TxtManualCliente" Text="" Padding="4,5" TextChanged="TxtManual_TextChanged" />
                                        </Grid>

                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="34" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="WAN IP:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#E4E4E7" Margin="0,0,3,0" FontSize="12.5" />
                                            <TextBox Grid.Column="1" x:Name="TxtManualWanIp" Text="" Padding="4,5" Margin="0,0,5,0" TextChanged="TxtManual_TextChanged" ToolTip="Ex.: 201.90.204.22" />
                                            <TextBlock Grid.Column="2" Text="WAN GW:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#E4E4E7" Margin="0,0,3,0" FontSize="12.5" />
                                            <TextBox Grid.Column="3" x:Name="TxtManualWanGw" Text="" Padding="4,5" Margin="0,0,5,0" TextChanged="TxtManual_TextChanged" ToolTip="Ex.: 201.90.204.21" />
                                            <TextBlock Grid.Column="4" Text="/" VerticalAlignment="Center" FontWeight="Bold" Foreground="#E4E4E7" Margin="0,0,2,0" FontSize="12.5" />
                                            <TextBox Grid.Column="5" x:Name="TxtManualWanCidr" Text="" Padding="4,5" Margin="0,0,6,0" TextChanged="TxtManual_TextChanged" ToolTip="Ex.: 30" />
                                            <TextBlock Grid.Column="6" Text="LAN IP:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#E4E4E7" Margin="0,0,3,0" FontSize="12.5" />
                                            <TextBox Grid.Column="7" x:Name="TxtManualLanIp" Text="" Padding="4,5" Margin="0,0,5,0" TextChanged="TxtManual_TextChanged" ToolTip="Ex.: 200.182.245.17" />
                                            <TextBlock Grid.Column="8" Text="/" VerticalAlignment="Center" FontWeight="Bold" Foreground="#E4E4E7" Margin="0,0,2,0" FontSize="12.5" />
                                            <TextBox Grid.Column="9" x:Name="TxtManualLanCidr" Text="" Padding="4,5" TextChanged="TxtManual_TextChanged" ToolTip="Ex.: 28" />
                                        </Grid>

                                        <Border Background="#1E2A1E" BorderBrush="#3F5A3F" BorderThickness="1" CornerRadius="3" Padding="5,2" Margin="0,0,0,4">
                                            <TextBlock x:Name="TxtManualHostCalculadoPreview" Text="Host LAN Calculado: — (preencha LAN IP)" FontWeight="SemiBold" Foreground="#A1A1AA" FontSize="12" />
                                        </Border>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="BtnAplicarManualInline" Content="✓ Aplicar Informações" Padding="10,3" FontWeight="Bold" FontSize="12" Background="#B91C1C" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnAplicarManual_Click" ToolTip="Valida e carrega os dados manuais para liberar o checklist" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ======================================================== -->
                    <!-- PASSO 3: MODO DE EXECUÇÃO & FIRMWARE                      -->
                    <!-- ======================================================== -->
                    <Border Background="#27272A" BorderBrush="#52525B" BorderThickness="3.5,1,1,1" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,5">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#B91C1C" CornerRadius="10" Width="26" Height="26" Margin="0,0,7,0">
                                        <TextBlock Text="3" FontWeight="Black" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Firmware" FontWeight="Black" FontSize="13.5" Foreground="#EE1C25" VerticalAlignment="Center" />
                                    <TextBlock Text="• Selecione a imagem do firmware para atualização" FontSize="11.5" Foreground="#71717A" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border x:Name="BadgeStep3" Background="#3B1818" CornerRadius="4" Padding="8,3" HorizontalAlignment="Right">
                                    <TextBlock x:Name="TxtBadgeStep3" Text="🔴 Firmware Pendente" FontSize="11" FontWeight="Bold" Foreground="#FCA5A5" />
                                </Border>
                            </DockPanel>

                            <!-- SELEÇÃO / ATUALIZAÇÃO DE FIRMWARE -->
                            <Border x:Name="PanelFirmwareObrigatorio" Visibility="Visible" Background="#3B1818" BorderBrush="#52525B" BorderThickness="1" CornerRadius="5" Padding="6,4" Margin="0,5,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Button x:Name="BtnSelecionarFirmwareAuto" Content="📂 Selecionar Firmware" Padding="14,7" FontWeight="Black" FontSize="14" Background="#B91C1C" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnSelecionarFirmwareAuto_Click" MinWidth="220" />
                                        <CheckBox x:Name="ChkAtualizarFirmwareAuto" IsChecked="True" Content="Atualizar / Validar Firmware (.ipe / .bin) via TFTP" FontWeight="Bold" FontSize="12" Foreground="#E4E4E7" VerticalAlignment="Center" Margin="12,0,0,0" Checked="ChkAtualizarFirmwareAuto_Changed" Unchecked="ChkAtualizarFirmwareAuto_Changed" />
                                    </StackPanel>
                                    <TextBlock x:Name="TxtFirmwareAutoInfo" Text="Nenhum firmware selecionado (clique em Selecionar Firmware)" Margin="0,2,0,0" Foreground="#FCA5A5" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- CHECKLIST DE PRONTIDÃO EXPANDIDO, VISUAL E ORGANIZADO -->
                    <Border Background="#3F3F46" BorderBrush="#52525B" BorderThickness="1.5" CornerRadius="8" Padding="8,6" Margin="0,0,0,6">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,5">
                                <TextBlock Text="✓ Prontidão para Iniciar" FontWeight="Black" FontSize="13" Foreground="#E4E4E7" VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtChecklistTotalPronto" Text="0 de 4 concluídos" FontWeight="Bold" FontSize="12" Foreground="#A1A1AA" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </DockPanel>

                            <!-- 4 CARDS LADO A LADO -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- ITEM 1a: MODELO -->
                                <Border x:Name="CardChkModelo" Grid.Column="0" Background="#3B1818" BorderBrush="#52525B" BorderThickness="1" CornerRadius="6" Padding="6,4" Margin="0,0,3,0">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtChkModeloIcon" Text="🔴 1a. Modelo" FontWeight="Black" FontSize="12.5" Foreground="#FCA5A5" />
                                        <TextBlock x:Name="TxtChkModeloSub" Text="Selecione Cisco ou HPE" FontSize="11" Foreground="#A1A1AA" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>

                                <!-- ITEM 1b: STATUS SERIAL -->
                                <Border x:Name="CardChkSerial" Grid.Column="1" Background="#3B1818" BorderBrush="#52525B" BorderThickness="1" CornerRadius="6" Padding="6,4" Margin="2,0,2,0">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtChkSerialIcon" Text="🔴 1b. Status Serial" FontWeight="Black" FontSize="12.5" Foreground="#FCA5A5" />
                                        <TextBlock x:Name="TxtChkSerialSub" Text="Clique 'Testar Conexão Porta Serial'" FontSize="11" Foreground="#A1A1AA" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>

                                <!-- ITEM 2: FICHA SAIP -->
                                <Border x:Name="CardChkDados" Grid.Column="2" Background="#3B1818" BorderBrush="#52525B" BorderThickness="1" CornerRadius="6" Padding="6,4" Margin="2,0,2,0">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtChkDadosIcon" Text="🔴 2. Ficha SAIP" FontWeight="Black" FontSize="12.5" Foreground="#FCA5A5" />
                                        <TextBlock x:Name="TxtChkDadosSub" Text="Carregue PDF/TXT ou Manual" FontSize="11" Foreground="#A1A1AA" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>

                                <!-- ITEM 3: FIRMWARE -->
                                <Border x:Name="CardChkFirmware" Grid.Column="3" Background="#3B1818" BorderBrush="#52525B" BorderThickness="1" CornerRadius="6" Padding="6,4" Margin="3,0,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtChkFirmwareIcon" Text="🔴 3. Firmware" FontWeight="Black" FontSize="12.5" Foreground="#FCA5A5" />
                                        <TextBlock x:Name="TxtChkFirmwareSub" Text="Selecione .ipe / .bin" FontSize="11" Foreground="#A1A1AA" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- BARRA DE STATUS / ORIENTAÇÃO EM DESTAQUE -->
                            <Border x:Name="BannerStatusProntidao" Visibility="Collapsed" Background="#2A1F1F" BorderBrush="#7C3535" BorderThickness="1" CornerRadius="4" Padding="8,4">
                                <TextBlock x:Name="TxtAlertaProsseguir" Text="⚠ Preencha os itens destacados em vermelho acima para habilitar o botão de início."
                                           Foreground="#FCA5A5" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- BOTÃO DE AÇÃO PRINCIPAL DINÂMICO -->
                    <Button x:Name="BtnAvancarParaEsteira" Style="{StaticResource CtaPrimaryStyle}" Content="⚡ Iniciar Provisionamento Automático"
                            Padding="14,8" Background="{StaticResource ClaroGradientBrush}" Foreground="White" BorderThickness="0" FontWeight="Black" FontSize="15" Cursor="Hand"
                            HorizontalAlignment="Stretch" Click="BtnAvancarParaEsteira_Click" IsEnabled="False" ToolTip="Valide: modelo + teste serial + dados do circuito" />

                    <!-- DESCRIÇÃO DO BOTÃO CONFORME O MODO -->
<TextBlock x:Name="TxtDescricaoBotaoAcao" Text="O SPARC executará as 7 etapas em sequência. Acompanhe o progresso na esteira."
                                Foreground="#A1A1AA" FontSize="12" FontWeight="SemiBold" Margin="0,3,0,4" HorizontalAlignment="Center" />

                    <!-- BOTÃO OPÇÕES AVANÇADAS VIA ATALHO CTRL+SHIFT+V -->
                    <Button x:Name="BtnSemiAutoAtalho" Content="⚙️ OPÇÕES AVANÇADAS (Ctrl+Shift+V)"
                            Padding="14,8" Background="#B91C1C" Foreground="White" BorderThickness="0" FontWeight="Black" FontSize="15" Cursor="Hand"
                            HorizontalAlignment="Stretch" Click="BtnSemiAutoAtalho_Click" IsEnabled="True" Visibility="Collapsed"
                            ToolTip="Atalho: Ctrl+Shift+V — Acessa a esteira em modo passo a passo" />

                    <!-- OPÇÃO SECRETA NAT (LAB) — mesmo atalho, default DESLIGADA -->
                    <CheckBox x:Name="ChkNatLab" Content="🌐 Habilitar NAT overload (LAB) — mantém NAT após provisionar"
                            Foreground="#FCA5A5" FontSize="12" FontWeight="Bold" Margin="0,4,0,0"
                            HorizontalAlignment="Center" Visibility="Collapsed" IsChecked="False"
                            ToolTip="Opção secreta (Ctrl+Shift+V). Quando marcada, a esteira Cisco aplica ip nat inside/outside + overload e não o remove." />

                    <!-- MANUAL -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3,0,2">
                        <Button x:Name="BtnAbrirManualInicial" Content="📖 Abrir Manual de Instruções (PDF)" Background="Transparent" Foreground="#A1A1AA" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnAbrirManual_Click" ToolTip="Guia ilustrado de cabeamento e tempos de boot" />
                    </StackPanel>

                    <!-- RODAPÉ COMPACTO -->
                    <Border Background="#3F3F46" BorderBrush="#52525B" BorderThickness="1" CornerRadius="4" Padding="10,5" Margin="0,2,0,0">
                        <DockPanel>
                            <TextBlock Text="✉ Desenvolvido por:" FontWeight="Bold" FontSize="11.5" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="george.calcmann@claro.com.br" FontWeight="Bold" FontSize="11.5" Foreground="#EE1C25" VerticalAlignment="Center" />
                            <TextBlock Text="Claro S.A. — Ativação SC" HorizontalAlignment="Right" FontSize="11.5" FontWeight="SemiBold" Foreground="#A1A1AA" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>
            </ScrollViewer>
        </Grid>

        <!-- ========================================================================= -->
        <!-- 1b. TELA MODO AUTOMÁTICO — BARRA GERAL + STATUS POR ETAPA (SEM ESTEIRA)     -->
        <!-- ========================================================================= -->
        <Grid x:Name="GridModoAutomatico" Visibility="Collapsed" Background="#18181B">
            <Border Background="#27272A" BorderBrush="#52525B" BorderThickness="1" CornerRadius="12" Padding="18" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="8">
                <StackPanel>
                    <Border Background="{StaticResource BetaBadgeBrush}" CornerRadius="10" Padding="12,4" HorizontalAlignment="Center" Margin="0,0,0,6">
                        <TextBlock Text="🔴 VERSÃO BETA — CLARO S.A. — ATIVAÇÃO SC" FontWeight="Black" FontSize="12.5" Foreground="#FFFFFF" />
                    </Border>
                    <TextBlock Text="⚡ MODO AUTOMÁTICO EM EXECUÇÃO" FontWeight="Black" FontSize="20" Foreground="#EE1C25" HorizontalAlignment="Center" />
                    <TextBlock x:Name="TxtAutoStatusGeral" Text="Preparando..." FontSize="14" Foreground="#A1A1AA" HorizontalAlignment="Center" Margin="0,4,0,14" />
                    <ProgressBar x:Name="PbAutoGeral" Height="14" Minimum="0" Maximum="100" Value="0" Foreground="#EE1C25" Background="#27272A" BorderThickness="0" Margin="0,0,0,6" />
                    <TextBlock x:Name="TxtAutoPorcentagem" Text="0%" FontWeight="Bold" Foreground="#EE1C25" HorizontalAlignment="Center" Margin="0,0,0,16" />
                    <Border Background="#3F3F46" BorderBrush="#52525B" BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel>
                            <TextBlock x:Name="TxtAutoEtapa1" Text="○ 1. Zerar Configuração — aguardando" Foreground="#A1A1AA" FontSize="13.5" Margin="0,3" />
                            <TextBlock x:Name="TxtAutoEtapa2" Text="○ 2. Atualizar Firmware — aguardando" Foreground="#A1A1AA" FontSize="13.5" Margin="0,3" />
                            <TextBlock x:Name="TxtAutoEtapa3" Text="○ 3. Provisionar Equipamento — aguardando" Foreground="#A1A1AA" FontSize="13.5" Margin="0,3" />
                            <TextBlock x:Name="TxtAutoEtapa4" Text="○ 4. Configurar IP de Teste — aguardando" Foreground="#A1A1AA" FontSize="13.5" Margin="0,3" />
                            <TextBlock x:Name="TxtAutoEtapa5" Text="○ 5. Testar Conectividade (ICMP: 5a LAN, 5b WAN, 5c WEB) — aguardando" Foreground="#A1A1AA" FontSize="13.5" Margin="0,3" />
                            <TextBlock x:Name="TxtAutoEtapa6" Text="○ 6. Testar Acesso Remoto (Telnet) — aguardando" Foreground="#A1A1AA" FontSize="13.5" Margin="0,3" />
                            <TextBlock x:Name="TxtAutoEtapa7" Text="○ 7. Testar Banda — aguardando" Foreground="#A1A1AA" FontSize="13.5" Margin="0,3" />
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                        <Button x:Name="BtnAutoCancelar" Content="✖ Cancelar" Padding="14,6" Background="#B91C1C" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="BtnCancelar_Click" />
                        <Button x:Name="BtnAutoAbrirPdf" Content="📄 Visualizar Relatório PDF" Padding="14,6" Margin="8,0,0,0" Background="#B91C1C" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="BtnAutoAbrirPdf_Click" Visibility="Collapsed" />
                        <Button x:Name="BtnAutoExportarPdf" Content="💾 Salvar PDF como..." Padding="12,6" Margin="8,0,0,0" Background="#3F3F46" Foreground="White" BorderThickness="0" Click="BtnAutoExportarPdf_Click" Visibility="Collapsed" />
                        <Button x:Name="BtnAutoRestaurarRede" Content="↩ Restaurar configuração IP do Windows" Padding="12,6" Margin="8,0,0,0" Background="#0F766E" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="BtnAutoRestaurarRede_Click" Visibility="Collapsed" ToolTip="Volta a placa de rede ao IP/DHCP anterior ao teste (ou mantém para mais testes)" />
                        <Button x:Name="BtnAutoVoltar" Content="← Voltar à Esteira" Padding="14,6" Margin="8,0,0,0" Background="#64748B" Foreground="White" BorderThickness="0" Click="BtnAutoVoltar_Click" Visibility="Collapsed" />
                    </StackPanel>
                    <Border Background="#0A0E14" CornerRadius="6" Margin="0,14,0,0" MaxHeight="200">
                        <ScrollViewer x:Name="ScrollAutoLog" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TxtAutoLog" Text="Aguardando início..." Foreground="#94A3B8" FontFamily="Consolas" FontSize="12.5" Padding="8" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- 2. TELA PRINCIPAL DA ESTEIRA (EXIBIDA APÓS DEFINIÇÃO DE INSUMOS)          -->
        <!-- ========================================================================= -->
        <DockPanel x:Name="GridEsteiraPrincipal" Visibility="Collapsed">

            <!-- ================= BARRA SUPERIOR: CONEXÃO E CONTROLE GERAL ================= -->
            <Border DockPanel.Dock="Top" Background="#27272A" BorderBrush="#52525B" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Porta Serial -->
                    <TextBlock Text="Porta Serial:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#EE1C25" Margin="0,4,8,4" />
                    <ComboBox x:Name="CbPorta" Width="95" Margin="0,4,6,4" IsEditable="True" SelectionChanged="CbPorta_SelectionChanged" VerticalAlignment="Center"/>
                    <Button x:Name="BtnAtualizarPortas" Content="🔄" Padding="6,2" Margin="0,4,12,4" ToolTip="Atualizar portas COM" Click="BtnAtualizarPortas_Click" VerticalAlignment="Center"/>

                    <!-- Baud Rate -->
                    <TextBlock Text="Baud Rate:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#EE1C25" Margin="0,4,8,4" />
                    <ComboBox x:Name="CbBaud" SelectedIndex="0" Width="85" Margin="0,4,12,4" VerticalAlignment="Center">
                        <ComboBoxItem Content="9600" />
                        <ComboBoxItem Content="19200" />
                        <ComboBoxItem Content="38400" />
                        <ComboBoxItem Content="57600" />
                        <ComboBoxItem Content="115200" />
                    </ComboBox>

                    <!-- Perfil de Hardware -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,12,4">
                        <TextBlock Text="Perfil HW:" FontWeight="Bold" Foreground="#EE1C25" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <ComboBox x:Name="CbInterrupt" SelectedIndex="0" Width="280" HorizontalAlignment="Left" SelectionChanged="CbInterrupt_SelectionChanged" VerticalAlignment="Center">
                            <ComboBoxItem Content="HPE MSR 954 / 958 (Ctrl+B @ 9600 - BootWare)" Tag="hpe.msr954.ctrl-b" />
                            <ComboBoxItem Content="HPE MSR 930 / 931 / 935 (Ctrl+B @ 9600 - BootWare)" Tag="hpe.msr930.ctrl-b" />
                            <ComboBoxItem Content="HPE MSR 1002 / 1003 (Ctrl+B @ 9600 - BootWare)" Tag="hpe.msr1002.ctrl-b" />
                            <ComboBoxItem Content="Cisco Série 1900 / 1921 / 1941 / 1905 (Break @ 9600 - ROMMON)" Tag="cisco.c1900.break" />
                            <ComboBoxItem Content="Cisco Série 900 / C921-4P (Ctrl+C Puro @ 9600)" Tag="cisco.c900.ctrl-c" />
                            <ComboBoxItem Content="Cisco Série 800 / C841M (Break @ 9600 - ROMMON)" Tag="cisco.c841.break" />
                        </ComboBox>
                    </StackPanel>

                    <!-- Botões de Ação Global na Esteira -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,4">
                        <Button x:Name="BtnEsteiraAbrirCliDiagnostic" Content="🖥️ Terminal CLI" Padding="10,6" Margin="0,0,8,0"
                                Background="#B91C1C" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="13"
                                ToolTip="Abre a janela de diagnóstico CLI em tempo real"
                                Click="BtnAbrirCliDiagnostic_Click" />

                        <Button x:Name="BtnAvaliarEquipamentoTop" Content="🔌 Testar Conexão Porta Serial" Padding="10,6" Margin="0,0,8,0"
                                Background="#B91C1C" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="13"
                                ToolTip="Testa conexão serial e avalia situação (senha, modelo, versão, flash e configuração)"
                                Click="BtnTestarAvaliar_Click" />

                        <Button x:Name="BtnExportarRelatorioPdfTop" Content="📄 Relatório PDF" Padding="10,6" Margin="0,0,8,0"
                                Background="#B91C1C" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="13"
                                ToolTip="Gera e abre o Relatório Técnico de Homologação em PDF"
                                Click="BtnExportarRelatorioPdfTop_Click" />

                        <Button x:Name="BtnExecutarSequencia" Visibility="Collapsed" Cursor="Hand" Padding="14,6" Margin="0,0,8,0"
                                Background="{StaticResource ClaroGradientBrush}" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="14"
                                ToolTip="Executa todas as 7 fases da esteira em ordem automática (1 → 7)"
                                Click="BtnExecutarSequencia_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡ EXECUTAR ESTEIRA COMPLETA (1 → 7)" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnCancelar" Content="✖ Cancelar" Padding="10,6"
                                IsEnabled="False" Click="BtnCancelar_Click" Background="#B91C1C" Foreground="White" BorderThickness="0" FontWeight="SemiBold" />
                    </StackPanel>
                </WrapPanel>
                </ScrollViewer>
            </Border>

            <!-- ================= BANNER DO CIRCUITO ATIVO COM TÍTULO FORMATADO ================= -->
            <Border DockPanel.Dock="Top" Background="#27272A" BorderBrush="#52525B" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,0,6">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Border Background="{StaticResource BetaBadgeBrush}" CornerRadius="6" Padding="8,3" Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="VERSÃO BETA — CLARO S.A. — ATIVAÇÃO SC" FontWeight="Black" FontSize="11.5" Foreground="#FFFFFF" />
                        </Border>
                        <Button x:Name="BtnVoltarPaginaPrincipal" Content="← Voltar à Página Principal" Padding="10,3" Margin="0,0,8,0" FontWeight="Bold" Background="#64748B" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnVoltarPaginaPrincipal_Click" ToolTip="Voltar à tela inicial" />
                        <Button Content="✏ Trocar / Alterar Insumos" Padding="10,3" FontWeight="Bold" Background="#B91C1C" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnTrocarInsumos_Click" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="TxtCircuitoAtivoTitulo" Text="CIRCUITO: FNS/IP/03977 - SOLDI PROMOTORA DE VENDAS LTDA" FontWeight="Black" Foreground="#EE1C25" FontSize="15" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="TxtCircuitoAtivoResumo" Text="WAN (GE0): 201.90.204.22/30 (GW: 201.90.204.21) | LAN (GE1): 200.182.245.17/28 | Host: 200.182.245.18 | DNS: 1.1.1.1, 8.8.8.8" FontWeight="SemiBold" Foreground="#EE1C25" FontSize="13.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ================= BARRA INFERIOR DE STATUS E LINK DO MANUAL COM E-MAIL DE SUPORTE ================= -->
            <StatusBar DockPanel.Dock="Bottom" Background="#111113" Padding="6,4">
                <StatusBarItem x:Name="StatusTexto" Content="Pronto para iniciar a esteira." FontWeight="SemiBold" Foreground="#EE1C25" />
                <StatusBarItem HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="✉ Contato:" FontWeight="Bold" FontSize="12.5" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="george.calcmann@claro.com.br" FontWeight="Bold" FontSize="12.5" Foreground="#EE1C25" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button x:Name="BtnAbrirManualFooter" Content="📖 Manual de Instruções (PDF)" Padding="10,3" Margin="0,0,8,0" Background="#B91C1C" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="13" Cursor="Hand" Click="BtnAbrirManual_Click" ToolTip="Abrir Manual Ilustrado com diagrama de cabos e portas WAN/LAN" />
                        <Button Content="Limpar Terminal" Padding="8,3" Background="#3F3F46" Foreground="#E4E4E7" BorderThickness="0" FontSize="13" Click="BtnLimparTerminal_Click" />
                    </StackPanel>
                </StatusBarItem>
            </StatusBar>

            <!-- ================= CORPO PRINCIPAL ================= -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="310" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ============ MENU LATERAL DA ESTEIRA (STEPPER ORDENADO) ============ -->
                <Border Grid.Column="0" Background="#27272A" BorderBrush="#52525B" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,10,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Fluxo da Esteira" FontWeight="Bold" FontSize="14" Foreground="#EE1C25" Margin="4,0,0,10" />

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- FASE 1: ZERAR CONFIGURAÇÃO -->
                                <Button x:Name="BtnStepA" Cursor="Hand" Padding="14,10" Margin="0,0,0,6"
                                        Background="#3B1818" BorderBrush="#F87171" BorderThickness="1"
                                        HorizontalContentAlignment="Left" Click="BtnStepA_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="1" FontWeight="Bold" FontSize="16" Foreground="#EE1C25" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="a) Zerar Configuração" FontWeight="Bold" FontSize="14" Foreground="#FCA5A5" />
                                            <TextBlock Text="ROMMON Cisco / BootWare HPE" FontSize="12.5" Foreground="#A1A1AA" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" x:Name="StatusBadgeA" Text="⚪" FontSize="15" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>

                                <!-- FASE 2: ATUALIZAR FIRMWARE (RELOAD AUTOMÁTICO) -->
                                <Button x:Name="BtnStepB" Cursor="Hand" Padding="14,10" Margin="0,0,0,6"
                                        Background="#27272A" BorderBrush="#B91C1C" BorderThickness="1"
                                        HorizontalContentAlignment="Left" Click="BtnStepB_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="2" FontWeight="Bold" FontSize="16" Foreground="#EE1C25" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="b) Atualizar Firmware" FontWeight="Bold" FontSize="14" Foreground="#FCA5A5" />
                                            <TextBlock Text="TFTP (.ipe/.bin) + Reload" FontSize="12.5" Foreground="#A1A1AA" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" x:Name="StatusBadgeB" Text="⚪" FontSize="15" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>

                                <!-- FASE 3: PROVISIONAR EQUIPAMENTO -->
                                <Button x:Name="BtnStepC" Cursor="Hand" Padding="14,10" Margin="0,0,0,6"
                                        Background="#27272A" BorderBrush="#B91C1C" BorderThickness="1"
                                        HorizontalContentAlignment="Left" Click="BtnStepC_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="3" FontWeight="Bold" FontSize="16" Foreground="#EE1C25" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="c) Provisionar Equipamento" FontWeight="Bold" FontSize="14" Foreground="#FCA5A5" />
                                            <TextBlock Text="WAN, LAN, Rota e Telnet EBT" FontSize="12.5" Foreground="#A1A1AA" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" x:Name="StatusBadgeC" Text="⚪" FontSize="15" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>

                                <!-- FASE 4: CONFIGURAR IP DISPOSITIVO DE TESTE -->
                                <Button x:Name="BtnStepD" Cursor="Hand" Padding="14,10" Margin="0,0,0,6"
                                        Background="#2A1F1F" BorderBrush="#FBBF24" BorderThickness="1"
                                        HorizontalContentAlignment="Left" Click="BtnStepD_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="4" FontWeight="Bold" FontSize="16" Foreground="#EE1C25" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="d) Configurar IP de Teste" FontWeight="Bold" FontSize="14" Foreground="#FCA5A5" />
                                            <TextBlock Text="Host LAN + DNS 1.1.1.1/8.8.8.8" FontSize="12.5" Foreground="#A1A1AA" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" x:Name="StatusBadgeD" Text="⚪" FontSize="15" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>

                                <!-- FASE 5: TESTAR CONECTIVIDADE (ICMP) -->
                                <Button x:Name="BtnStepE" Cursor="Hand" Padding="14,10" Margin="0,0,0,6"
                                        Background="#27272A" BorderBrush="#38BDF8" BorderThickness="1"
                                        HorizontalContentAlignment="Left" Click="BtnStepE_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="5" FontWeight="Bold" FontSize="16" Foreground="#EE1C25" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="e) Testar Conectividade (ICMP)" FontWeight="Bold" FontSize="14" Foreground="#FCA5A5" />
                                            <TextBlock Text="5a LAN | 5b WAN | 5c WEB" FontSize="12.5" Foreground="#A1A1AA" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" x:Name="StatusBadgeE" Text="⚪" FontSize="15" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>

                                <!-- FASE 6: TESTAR ACESSO REMOTO (TELNET) -->
                                <Button x:Name="BtnStepF" Cursor="Hand" Padding="14,10" Margin="0,0,0,6"
                                        Background="#27272A" BorderBrush="#B91C1C" BorderThickness="1"
                                        HorizontalContentAlignment="Left" Click="BtnStepF_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="6" FontWeight="Bold" FontSize="16" Foreground="#EE1C25" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="f) Acesso Remoto (Telnet)" FontWeight="Bold" FontSize="14" Foreground="#FCA5A5" />
                                            <TextBlock Text="Login TCP:23 EBT/PRO1AN" FontSize="12.5" Foreground="#A1A1AA" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" x:Name="StatusBadgeF" Text="⚪" FontSize="15" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>

                                <!-- FASE 7: TESTAR BANDA -->
                                <Button x:Name="BtnStepG" Cursor="Hand" Padding="14,10" Margin="0,0,0,6"
                                        Background="#27272A" BorderBrush="#B91C1C" BorderThickness="1"
                                        HorizontalContentAlignment="Left" Click="BtnStepG_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="7" FontWeight="Bold" FontSize="16" Foreground="#EE1C25" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="g) Testar Banda" FontWeight="Bold" FontSize="14" Foreground="#FCA5A5" />
                                            <TextBlock Text="SpeedTest CLI + Nativo HTTP" FontSize="12.5" Foreground="#A1A1AA" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" x:Name="StatusBadgeG" Text="⚪" FontSize="15" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>

                                <!-- Indicador de Legenda -->
                                <Border Background="#3F3F46" BorderBrush="#52525B" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Legenda de Status:" FontWeight="SemiBold" FontSize="12.5" Foreground="#A1A1AA" Margin="0,0,0,4" />
                                        <TextBlock Text="⚪ Aguardando  |  ⏳ Executando  |  ✅ OK  |  ❌ Falha" FontSize="12" Foreground="#A1A1AA" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- ============ COLUNA DIREITA: PAINEL DE CONTROLE DA FASE + TERMINAL ============ -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- PAINEL DINÂMICO DA FASE ATIVA / SELECIONADA -->
                    <Border Grid.Row="0" Background="#27272A" BorderBrush="#52525B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                        <Grid>
                            <!-- =================== FASE 1: ZERAR CONFIGURAÇÃO =================== -->
                            <StackPanel x:Name="PanelPhaseA" Visibility="Visible">
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Fase 1 · a) Zerar Configuração do Equipamento" FontWeight="Bold" FontSize="15" Foreground="#FCA5A5" />
                                    <Button x:Name="BtnExecutarA" Content="▶ Executar Zeramento (Fase 1)" Padding="12,4" HorizontalAlignment="Right"
                                            Background="#EE1C25" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="BtnZerarConfig_Click" />
                                </DockPanel>
                                <TextBlock Text="Conecta na porta serial, envia interrupção de boot (ROMMON Cisco ou BootWare HPE), quebra de senha, limpa configuração e ajusta registrador 0x2102." Foreground="#A1A1AA" FontSize="13" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- =================== FASE 2: ATUALIZAR FIRMWARE (COM RELOAD) =================== -->
                            <StackPanel x:Name="PanelPhaseB" Visibility="Collapsed">
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Fase 2 · b) Atualizar Firmware (HPE .IPE / Cisco .BIN) + Reload Automático" FontWeight="Bold" FontSize="15" Foreground="#EE1C25" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="BtnExecutarRommonTftp" Content="🚨 Recuperação ROMMON TFTP" Padding="10,5" Margin="0,0,8,0"
                                                Background="#B91C1C" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="BtnExecutarRommonTftp_Click"
                                                ToolTip="Configura IP no Notebook e no ROMMON do Cisco, inicia servidor TFTP integrado, executa tftpdnld e efetua o boot da imagem." />
                                        <Button x:Name="BtnExecutarB" Content="⚡ Iniciar Upgrade TFTP e Reload (Fase 2)" Padding="14,5"
                                                Background="#B91C1C" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="BtnUpgradeIos_Click" />
                                    </StackPanel>
                                </DockPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" x:Name="BtnSelecionarIos" Content="📂 Selecionar Firmware (.ipe / .bin)" Padding="12,5" FontWeight="Bold" Background="#EE1C25" Foreground="White" Click="BtnSelecionarIos_Click" />
                                    <TextBlock Grid.Column="1" x:Name="TxtIosImageInfo" Text="Nenhum arquivo de firmware selecionado (opcional para a esteira)."
                                               VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#EE1C25" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <TextBlock Text="Inicia o servidor TFTP integrado, transfere o arquivo para a Flash, grava no bootloader e executa o reload automático para subir na nova versão." Foreground="#A1A1AA" FontSize="13" />
                            </StackPanel>

                            <!-- =================== FASE 3: PROVISIONAR EQUIPAMENTO =================== -->
                            <StackPanel x:Name="PanelPhaseC" Visibility="Collapsed">
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Fase 3 · c) Provisionar Equipamento (WAN, LAN, Rota e Telnet)" FontWeight="Bold" FontSize="15" Foreground="#FCA5A5" />
                                    <Button x:Name="BtnExecutarC" Content="▶ Aplicar Provisionamento (Fase 3)" Padding="12,4" HorizontalAlignment="Right"
                                            Background="#B91C1C" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="BtnAplicarSaip_Click" />
                                </DockPanel>
                                <TextBlock Text="Aplica as configurações do circuito no equipamento já atualizado (WAN GigabitEthernet 0/0 [GE0], LAN GigabitEthernet 0/1 [GE1], Rota Default, Acesso Telnet EBT/PRO1AN e gravação na Flash)." Foreground="#A1A1AA" FontSize="13.5" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- =================== FASE 4: CONFIGURAR IP DISPOSITIVO DE TESTE =================== -->
                            <StackPanel x:Name="PanelPhaseD" Visibility="Collapsed">
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Fase 4 · d) Configurar IP e DNS no Dispositivo de Teste (Host LAN)" FontWeight="Bold" FontSize="15" Foreground="#FCA5A5" />
                                    <Button x:Name="BtnExecutarD" Content="▶ Aplicar IP e DNS no Host (Fase 4)" Padding="12,4" HorizontalAlignment="Right"
                                            Background="#B91C1C" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="BtnConfigIpPc_Click" />
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Dispositivo:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#E4E4E7" Margin="0,0,6,0" FontSize="13.5" />
                                    <ComboBox x:Name="CbTipoDispositivo" SelectedIndex="0" Width="110" Margin="0,0,14,0" SelectionChanged="CbTipoDispositivo_SelectionChanged">
                                        <ComboBoxItem Content="Windows" />
                                        <ComboBoxItem Content="Android" />
                                    </ComboBox>
                                    <TextBlock Text="Placa/Interface:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#E4E4E7" Margin="0,0,6,0" FontSize="13.5" />
                                    <ComboBox x:Name="CbAdaptadorRede" Width="200" VerticalAlignment="Center" Margin="0,0,14,0" />
                                    <TextBlock x:Name="TxtHostIpCalculado" Text="Host LAN: - | DNS: 1.1.1.1, 8.8.8.8" VerticalAlignment="Center" FontWeight="Bold" Foreground="#EE1C25" FontSize="13.5" />
                                    <Button x:Name="BtnRestaurarRedeNotebook" Content="↩ Restaurar rede anterior" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                            Background="#3F3F46" Foreground="#E4E4E7" BorderThickness="1" BorderBrush="#52525B" Cursor="Hand" FontWeight="Bold"
                                            Click="BtnRestaurarRedeNotebook_Click" ToolTip="Volta a placa para o IP/DHCP que tinha antes do SPARC alterar" />
                                </StackPanel>
                                <TextBlock Text="Configura o IP fixo e servidores DNS (1.1.1.1 / 8.8.8.8) na placa de rede do operador para teste de conectividade." Foreground="#A1A1AA" FontSize="13" />
                            </StackPanel>

                            <!-- =================== FASE 5: TESTAR CONECTIVIDADE (ICMP) =================== -->
                            <StackPanel x:Name="PanelPhaseE" Visibility="Collapsed">
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Fase 5 · e) Testar Conectividade ICMP (5a LAN, 5b WAN, 5c WEB)" FontWeight="Bold" FontSize="15" Foreground="#FCA5A5" />
                                    <Button x:Name="BtnExecutarE" Content="▶ Disparar Teste ICMP (5a / 5b / 5c)" Padding="12,4" HorizontalAlignment="Right"
                                            Background="#B91C1C" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="BtnTestarIcmp_Click" />
                                </DockPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- 5a LAN -->
                                    <Border Grid.Column="0" Background="#3F3F46" BorderBrush="#52525B" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,4,0">
                                        <StackPanel>
                                            <TextBlock Text="5a · ICMP LAN (Roteador)" FontWeight="Bold" FontSize="13" Foreground="#FCA5A5" Margin="0,0,0,4" />
                                            <TextBox x:Name="TxtIcmpTargetLan" Text="200.182.245.17" Padding="4,2" FontSize="13" />
                                        </StackPanel>
                                    </Border>
                                    <!-- 5b WAN -->
                                    <Border Grid.Column="1" Background="#3F3F46" BorderBrush="#52525B" BorderThickness="1" CornerRadius="6" Padding="8" Margin="2,0,2,0">
                                        <StackPanel>
                                            <TextBlock Text="5b · ICMP WAN (Gateway Claro)" FontWeight="Bold" FontSize="13" Foreground="#FCA5A5" Margin="0,0,0,4" />
                                            <TextBox x:Name="TxtIcmpTargetWan" Text="201.90.204.21" Padding="4,2" FontSize="13" />
                                        </StackPanel>
                                    </Border>
                                    <!-- 5c WEB -->
                                    <Border Grid.Column="2" Background="#3F3F46" BorderBrush="#52525B" BorderThickness="1" CornerRadius="6" Padding="8" Margin="4,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="5c · ICMP WEB (DNS Web)" FontWeight="Bold" FontSize="13" Foreground="#FCA5A5" Margin="0,0,0,4" />
                                            <TextBox x:Name="TxtIcmpTargetWeb" Text="1.1.1.1, 8.8.8.8" Padding="4,2" FontSize="13" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <TextBox x:Name="TxtIcmpTarget" Visibility="Collapsed" />
                                <TextBlock Text="Dispara testes ICMP sequenciais: 5a (Interface LAN local), 5b (Gateway WAN Claro) e 5c (DNS Cloudflare 1.1.1.1 / Google 8.8.8.8)." Foreground="#A1A1AA" FontSize="13" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- =================== FASE 6: TESTAR ACESSO REMOTO (TELNET) =================== -->
                            <StackPanel x:Name="PanelPhaseF" Visibility="Collapsed">
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Fase 6 · f) Testar Acesso Remoto (Telnet :23)" FontWeight="Bold" FontSize="15" Foreground="#EE1C25" />
                                    <Button x:Name="BtnExecutarF" Content="☎ Disparar Teste Telnet (Fase 6)" Padding="12,4" HorizontalAlignment="Right"
                                            Background="#B91C1C" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="BtnTestarTelnet_Click" />
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Telnet Host:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#E4E4E7" Margin="0,0,6,0" FontSize="13.5" />
                                    <TextBox x:Name="TxtTelnetTarget" Width="130" Text="" VerticalAlignment="Center" Margin="0,0,6,0" Padding="4,2" ToolTip="IP do roteador (LAN) para teste Telnet" />
                                    <TextBlock Text="Porta:" VerticalAlignment="Center" Foreground="#E4E4E7" Margin="0,0,4,0" FontSize="13" />
                                    <TextBox x:Name="TxtTelnetPort" Width="50" Text="23" VerticalAlignment="Center" Margin="0,0,8,0" Padding="4,2" />
                                    <TextBlock Text="User:" VerticalAlignment="Center" Foreground="#E4E4E7" Margin="0,0,4,0" FontSize="13" />
                                    <TextBox x:Name="TxtTelnetUser" Width="70" Text="EBT" VerticalAlignment="Center" Margin="0,0,6,0" Padding="4,2" ToolTip="Usuário Telnet provisionado (HPE: EBT)" />
                                    <TextBlock Text="Senha:" VerticalAlignment="Center" Foreground="#E4E4E7" Margin="0,0,4,0" FontSize="13" />
                                    <TextBox x:Name="TxtTelnetPass" Width="100" Text="PRO1ANPRO1AN" VerticalAlignment="Center" Margin="0,0,8,0" Padding="4,2" ToolTip="Senha Telnet (HPE: PRO1ANPRO1AN)" />
                                </StackPanel>
                                <TextBlock Text="Testa conexão TCP na porta 23, negocia opções RFC 854 IAC e valida login com usuário e senha do provisionamento." Foreground="#A1A1AA" FontSize="13" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- =================== FASE 7: TESTAR BANDA =================== -->
                            <StackPanel x:Name="PanelPhaseG" Visibility="Collapsed">
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Fase 7 · g) Testar Banda de Rede" FontWeight="Bold" FontSize="15" Foreground="#FCA5A5" />
                                    <Button x:Name="BtnExecutarG" Content="▶ Iniciar Teste de Banda (Fase 7)" Padding="12,4" HorizontalAlignment="Right"
                                            Background="#B91C1C" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="BtnTestarBanda_Click" />
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Atalhos Web de Medição:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#E4E4E7" Margin="0,0,8,0" FontSize="13.5" />
                                    <Button Content="🌐 Abrir Speedtest.net" Padding="8,2" Margin="0,0,6,0" Click="BtnSpeedtestNet_Click" />
                                    <Button Content="🌐 Abrir Fast.com" Padding="8,2" Click="BtnFastCom_Click" />
                                </StackPanel>
                                <TextBlock Text="Executa o Speedtest CLI ou teste nativo HTTP em nuvem para medir vazão em Mbps, latência e estabilidade." Foreground="#A1A1AA" FontSize="13" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- BARRA DE PROGRESSO DA ESTEIRA -->
                    <Border Grid.Row="1" Background="#27272A" BorderBrush="#52525B" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock x:Name="TxtEtapaTitulo" Text="Status da Esteira: Pronto" FontWeight="Bold" FontSize="15" Foreground="#E4E4E7" />
                                <TextBlock x:Name="TxtEtapaPorcentagem" Text="0%" HorizontalAlignment="Right" FontWeight="Black" FontSize="15" Foreground="#EE1C25" />
                            </DockPanel>
                            <ProgressBar x:Name="PbProgresso" Height="12" Minimum="0" Maximum="100" Value="0" Foreground="#EE1C25" Background="#27272A" BorderThickness="0" Margin="0,0,0,6" />
                            <TextBlock x:Name="TxtEtapaDescricao" Text="Clique nas fases da esteira à esquerda para configurar ou use o botão 'Executar Esteira Completa'." Foreground="#A1A1AA" FontSize="13.5" FontWeight="Medium" />
                        </StackPanel>
                    </Border>

                    <!-- TERMINAL SERIAL E LOGS COM SUPORTE A CORES -->
                    <Border Grid.Row="2" Background="#0A0E14" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8">
                        <RichTextBox x:Name="TxtTerminal"
                                     IsReadOnly="True"
                                     Background="Transparent"
                                     Foreground="#E2E8F0"
                                     CaretBrush="#10B981"
                                     FontFamily="Consolas"
                                     FontSize="14"
                                     BorderThickness="0"
                                     Padding="10"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto">
                            <FlowDocument PagePadding="0">
                                <Paragraph x:Name="TerminalParagraph" LineHeight="18" />
                            </FlowDocument>
                        </RichTextBox>
                    </Border>
                </Grid>
            </Grid>

        </DockPanel>

    </Grid>
</Window>
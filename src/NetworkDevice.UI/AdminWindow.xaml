<Window x:Class="NetworkDevice.UI.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SPARC — Central de Administração e Homologação"
        Icon="Assets/sparc.ico"
        Width="1080" Height="740"
        MinHeight="650" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#18181B"
        FontFamily="Segoe UI"
        Foreground="#E4E4E7">

    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Foreground" Value="#A1A1AA" />
            <Setter Property="Background" Value="#27272A" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="#3F3F46" BorderThickness="1,1,1,0" CornerRadius="6,6,0,0" Margin="0,0,4,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#3F3F46" />
                                <Setter Property="Foreground" Value="#38BDF8" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
        <Border Grid.Row="0" Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#B91C1C" CornerRadius="8" Width="40" Height="40" Margin="0,0,12,0">
                        <TextBlock Text="🛡️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SPARC ADMIN" FontWeight="Black" FontSize="16" Foreground="#F87171" Margin="0,0,10,0" />
                            <Border Background="#3B1818" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="PAINEL DE CONTROLE DO GESTOR" FontSize="10.5" FontWeight="Bold" Foreground="#FCA5A5" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Gerador Criptográfico de Licenças RSA (Node-locking) &amp; Gestão do Repositório de Firmwares" FontSize="11.5" Foreground="#A1A1AA" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatusChaveRsa" Text="🔑 Chave RSA Privada: Carregada" FontSize="11.5" FontWeight="SemiBold" Foreground="#4ADE80" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Content="📁 Pasta Beta" Padding="8,4" Background="#3F3F46" Foreground="White" BorderThickness="0" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Click="BtnAbrirPastaBeta_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- CONTEÚDO PRINCIPAL: ABAS -->
        <TabControl Grid.Row="1" Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1" Padding="14">
            
            <!-- ABA 1: SOLICITAÇÕES DE ATIVAÇÃO ONLINE (1 CLIQUE) -->
            <TabItem Header="🔔 Solicitações Online (1 Clique)">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- BARRA SUPERIOR DE STATUS E FILTRO -->
                    <Border Grid.Row="0" Background="#18181B" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                        <DockPanel>
                            <!-- Contadores / Status -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#713F12" CornerRadius="6" Padding="8,5" Margin="0,0,6,0">
                                    <TextBlock x:Name="TxtSolicitacoesPendentesCount" Text="⏳ Pendentes: 0" FontWeight="Bold" FontSize="11.5" Foreground="#FDE047" />
                                </Border>
                                <Border Background="#14532D" CornerRadius="6" Padding="8,5" Margin="0,0,6,0">
                                    <TextBlock x:Name="TxtSolicitacoesAprovadasCount" Text="✅ Aprovadas: 0" FontWeight="Bold" FontSize="11.5" Foreground="#4ADE80" />
                                </Border>
                                <Border Background="#7F1D1D" CornerRadius="6" Padding="8,5" Margin="0,0,6,0">
                                    <TextBlock x:Name="TxtSolicitacoesRejeitadasCount" Text="❌ Rejeitadas: 0" FontWeight="Bold" FontSize="11.5" Foreground="#F87171" />
                                </Border>
                                <Border Background="#1E293B" CornerRadius="6" Padding="8,5" Margin="0,0,6,0">
                                    <TextBlock x:Name="TxtSolicitacoesWindowsCount" Text="🪟 Win: 0" FontWeight="Bold" FontSize="11.5" Foreground="#38BDF8" />
                                </Border>
                                <Border Background="#1E293B" CornerRadius="6" Padding="8,5" Margin="0,0,8,0">
                                    <TextBlock x:Name="TxtSolicitacoesAndroidCount" Text="📱 And: 0" FontWeight="Bold" FontSize="11.5" Foreground="#4ADE80" />
                                </Border>
                            </StackPanel>

                            <!-- Busca, Filtro Plataforma e Botão Atualizar -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="🔍 Filtrar:" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11.5" />
                                <TextBox x:Name="TxtFiltroSolicitacoes" Width="140" Height="28" Padding="6,4" Background="#27272A" Foreground="White" BorderBrush="#52525B" FontSize="11.5" TextChanged="TxtFiltroSolicitacoes_TextChanged" />
                                <ComboBox x:Name="CbFiltroPlataformaSolicitacoes" SelectedIndex="0" Height="28" Width="125" Margin="6,0,0,0" FontSize="11" SelectionChanged="CbFiltroPlataformaSolicitacoes_SelectionChanged">
                                    <ComboBoxItem Content="🌐 Todas Plat." />
                                    <ComboBoxItem Content="🪟 Windows" />
                                    <ComboBoxItem Content="📱 Android" />
                                </ComboBox>
                                <Button x:Name="BtnAtualizarSolicitacoesOnline" Content="🔄 Buscar da Nuvem" Padding="10,5" Margin="8,0,0,0" Background="#0D9488" Foreground="White" FontWeight="Bold" FontSize="11.5" BorderThickness="0" Cursor="Hand" Click="BtnAtualizarSolicitacoesOnline_Click" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- TABELA DE SOLICITAÇÕES -->
                    <Border Grid.Row="1" Background="#18181B" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="Fila de Solicitações de Ativação Online (Direto das Máquinas dos Técnicos)" FontWeight="Bold" FontSize="13" Foreground="#F4F4F5" VerticalAlignment="Center" />
                                <TextBlock Text="Selecione um técnico para Aprovar com 1 Clique ou Rejeitar" FontSize="11" Foreground="#38BDF8" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </DockPanel>

                            <DataGrid Grid.Row="1" x:Name="DgSolicitacoesOnline" AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="#27272A" Foreground="#E4E4E7" RowBackground="#1F1F23" AlternatingRowBackground="#27272A"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#3F3F46" BorderBrush="#3F3F46" BorderThickness="1"
                                      SelectionMode="Single" SelectionChanged="DgSolicitacoesOnline_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Status" Binding="{Binding StatusBadge}" FontWeight="Bold" Width="140" />
                                    <DataGridTextColumn Header="Plataforma" Binding="{Binding PlatformBadge}" FontWeight="Bold" Width="95" />
                                    <DataGridTextColumn Header="Data / Hora (UTC)" Binding="{Binding RequestedAtUtc, StringFormat='dd/MM/yyyy HH:mm'}" Width="125" />
                                    <DataGridTextColumn Header="Técnico" Binding="{Binding FullName}" FontWeight="Bold" Width="150" />
                                    <DataGridTextColumn Header="Empresa" Binding="{Binding Company}" Width="110" />
                                    <DataGridTextColumn Header="Matrícula" Binding="{Binding EmployeeId}" Width="85" />
                                    <DataGridTextColumn Header="Cluster" Binding="{Binding Cluster}" Width="110" />
                                    <DataGridTextColumn Header="UF" Binding="{Binding Uf}" Width="45" />
                                    <DataGridTextColumn Header="WhatsApp / Tel" Binding="{Binding Phone}" Width="125" />
                                    <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="160" />
                                    <DataGridTextColumn Header="Versão" Binding="{Binding ClientVersion}" Width="75" />
                                    <DataGridTextColumn Header="Machine GUID" Binding="{Binding MachineGuid}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- PAINEL DE AÇÕES DA SOLICITAÇÃO SELECIONADA -->
                    <Border Grid.Row="2" Background="#18181B" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Padding="12,10">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Ações de Liberação:" FontWeight="Bold" FontSize="11.5" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <Button x:Name="BtnAprovarSolicitacao30" Content="⚡ APROVAR (30 DIAS)" Padding="14,6" Background="#16A34A" Foreground="White" FontWeight="Black" FontSize="12" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0" Click="BtnAprovarSolicitacao30_Click" ToolTip="Assina criptograficamente e libera o acesso online por 30 dias" />
                                <Button x:Name="BtnAprovarSolicitacao60" Content="➕ 60 Dias" Padding="10,6" Background="#15803D" Foreground="White" FontWeight="Bold" FontSize="11.5" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0" Click="BtnAprovarSolicitacao60_Click" />
                                <Button x:Name="BtnAprovarSolicitacao90" Content="➕ 90 Dias" Padding="10,6" Background="#047857" Foreground="White" FontWeight="Bold" FontSize="11.5" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0" Click="BtnAprovarSolicitacao90_Click" />
                                <Button x:Name="BtnRejeitarSolicitacao" Content="❌ Rejeitar" Padding="10,6" Background="#7F1D1D" Foreground="White" FontWeight="Bold" FontSize="11.5" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0" Click="BtnRejeitarSolicitacao_Click" />
                                <Button x:Name="BtnExcluirSolicitacao" Content="🗑️ Excluir" Padding="10,6" Background="#450A0A" Foreground="#FCA5A5" BorderBrush="#991B1B" BorderThickness="1" FontWeight="Bold" FontSize="11.5" Cursor="Hand" Margin="0,0,6,0" Click="BtnExcluirSolicitacao_Click" ToolTip="Exclui definitivamente esta solicitação da nuvem e do cache local" />
                                <Button x:Name="BtnWhatsAppSolicitante" Content="💬 WhatsApp" Padding="10,6" Background="#25D366" Foreground="Black" FontWeight="Bold" FontSize="11.5" BorderThickness="0" Cursor="Hand" Click="BtnWhatsAppSolicitante_Click" />
                            </StackPanel>

                            <TextBlock x:Name="TxtSolicitacaoSelecionadaInfo" Text="Selecione uma solicitação na lista acima" FontSize="11.5" Foreground="#38BDF8" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ABA 2: GERADOR DE ATIVAÇÕES / LICENÇAS (MANUAL) -->
            <TabItem Header="🔑 Chaves de Ativação (Manual)">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,0,8">
                        
                        <!-- CARD DE ENTRADA DO PEDIDO -->
                        <Border Background="#18181B" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="1. Pedido de Ativação do Técnico (SPBREQ)" FontWeight="Bold" FontSize="13.5" Foreground="#F4F4F5" VerticalAlignment="Center" />
                                    <Button Content="📋 Colar da Área de Transferência" HorizontalAlignment="Right" Padding="10,4" Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="11.5" Cursor="Hand" Click="BtnColarPedido_Click" />
                                </DockPanel>

                                <TextBox x:Name="TxtPedidoReq" Height="65" TextWrapping="Wrap" AcceptsReturn="False" VerticalScrollBarVisibility="Auto"
                                         Background="#27272A" Foreground="#38BDF8" BorderBrush="#52525B" BorderThickness="1" Padding="8" FontSize="12" FontFamily="Consolas"
                                         TextChanged="TxtPedidoReq_TextChanged" />

                                <!-- PAINEL DE INSPEÇÃO AUTOMÁTICA DO PEDIDO -->
                                <Border x:Name="BorderInfoPedido" Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="6" Padding="10,8" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="TxtStatusDecodificacao" Text="✅ Pedido Válido" FontWeight="Bold" FontSize="12" Foreground="#4ADE80" />
                                            <TextBlock x:Name="TxtInfoTecnico" Text="Técnico: João Silva | WhatsApp: (11) 99999-9999 | Email: joao@claro.com.br" FontSize="11.5" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,3,0,0" />
                                            <TextBlock x:Name="TxtInfoPlataforma" Text="Plataforma: 🪟 Windows" FontSize="11.5" FontWeight="SemiBold" Foreground="#4ADE80" Margin="0,2,0,0" />
                                            <TextBlock x:Name="TxtInfoHardware" Text="Machine GUID: ... | Fingerprint: ..." FontSize="11" Foreground="#A1A1AA" Margin="0,2,0,0" FontFamily="Consolas" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- CONFIGURAÇÕES DA CHAVE -->
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- VALIDADE -->
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Validade da Chave:" FontSize="11.5" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,0,0,4" />
                                        <ComboBox x:Name="CbValidadeDias" SelectedIndex="0" Height="32" FontSize="12" FontWeight="Bold" SelectionChanged="CbValidadeDias_SelectionChanged">
                                            <ComboBoxItem Content="30 Dias (Padrão)" Tag="30" />
                                            <ComboBoxItem Content="60 Dias" Tag="60" />
                                            <ComboBoxItem Content="90 Dias" Tag="90" />
                                            <ComboBoxItem Content="180 Dias" Tag="180" />
                                            <ComboBoxItem Content="365 Dias" Tag="365" />
                                            <ComboBoxItem Content="Personalizado..." Tag="custom" />
                                        </ComboBox>
                                        <TextBox x:Name="TxtDiasCustom" Visibility="Collapsed" Margin="0,4,0,0" Padding="6,3" Background="#27272A" Foreground="White" BorderBrush="#52525B" FontSize="11" Text="45" />
                                    </StackPanel>

                                    <!-- NOME DO TÉCNICO -->
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="Identificação do Técnico:" FontSize="11.5" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,0,0,4" />
                                        <TextBox x:Name="TxtNomeTecnico" Height="32" Padding="8,6" Background="#27272A" Foreground="White" BorderBrush="#52525B" BorderThickness="1" FontSize="12" />
                                    </StackPanel>

                                    <!-- OBSERVAÇÕES / NOTAS -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Notas / Contrato / Local (Opcional):" FontSize="11.5" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,0,0,4" />
                                        <TextBox x:Name="TxtNotasLicenca" Height="32" Padding="8,6" Background="#27272A" Foreground="White" BorderBrush="#52525B" BorderThickness="1" FontSize="12" />
                                    </StackPanel>
                                </Grid>

                                <!-- BOTÃO GERAR -->
                                <Button x:Name="BtnGerarChave" Content="⚡ ASSINAR E GERAR CHAVE DE ATIVAÇÃO (SPB1...)" Height="40" Background="#16A34A" Foreground="White" FontWeight="Black" FontSize="13" BorderThickness="0" Cursor="Hand" Margin="0,6,0,0" Click="BtnGerarChave_Click" />
                            </StackPanel>
                        </Border>

                        <!-- CARD DA CHAVE GERADA (SAÍDA) -->
                        <Border x:Name="BorderChaveGerada" Background="#18181B" BorderBrush="#16A34A" BorderThickness="1.5" CornerRadius="8" Padding="14" Margin="0,0,0,14" Visibility="Collapsed">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="✅ Chave Gerada com Sucesso!" FontWeight="Bold" FontSize="13.5" Foreground="#4ADE80" Margin="0,0,10,0" />
                                        <TextBlock x:Name="TxtInfoValidadeChave" Text="(Válida por 30 dias até 2026-10-30)" FontSize="12" Foreground="#A1A1AA" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="📋 Copiar Chave" Padding="10,4" Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="11.5" Cursor="Hand" Margin="0,0,6,0" Click="BtnCopiarChave_Click" />
                                        <Button Content="💬 Copiar para WhatsApp" Padding="10,4" Background="#059669" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="11.5" Cursor="Hand" Click="BtnCopiarWhatsApp_Click" />
                                    </StackPanel>
                                </DockPanel>

                                <TextBox x:Name="TxtChaveGerada" Height="55" TextWrapping="Wrap" IsReadOnly="True" Background="#09090B" Foreground="#4ADE80" BorderBrush="#22C55E" BorderThickness="1" Padding="8" FontSize="12" FontFamily="Consolas" />
                            </StackPanel>
                        </Border>

                        <!-- HISTÓRICO DE CHAVES GERADAS -->
                        <Border Background="#18181B" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="Histórico de Chaves Emitidas Recentemente" FontWeight="Bold" FontSize="13" Foreground="#F4F4F5" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="BtnExcluirChaveHistorico" Content="🗑️ Excluir Selecionada" Padding="8,4" Margin="0,0,6,0" Background="#450A0A" Foreground="#FCA5A5" BorderThickness="0" FontSize="11" Cursor="Hand" Click="BtnExcluirChaveHistorico_Click" ToolTip="Exclui a chave selecionada do histórico" />
                                        <Button x:Name="BtnLimparHistoricoChaves" Content="🧹 Limpar Histórico" Padding="8,4" Margin="0,0,6,0" Background="#27272A" Foreground="#A1A1AA" BorderThickness="1" BorderBrush="#3F3F46" FontSize="11" Cursor="Hand" Click="BtnLimparHistoricoChaves_Click" ToolTip="Limpa todos os registros do histórico de testes" />
                                        <Button Content="🔄 Atualizar" Padding="8,4" Background="#3F3F46" Foreground="White" BorderThickness="0" FontSize="11" Cursor="Hand" Click="BtnAtualizarHistorico_Click" />
                                    </StackPanel>
                                </DockPanel>

                                <DataGrid x:Name="DgHistoricoChaves" Height="170" AutoGenerateColumns="False" IsReadOnly="True"
                                          Background="#27272A" Foreground="#E4E4E7" RowBackground="#1F1F23" AlternatingRowBackground="#27272A"
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#3F3F46" BorderBrush="#3F3F46" BorderThickness="1">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Data / Hora (UTC)" Binding="{Binding GeneratedAtUtc, StringFormat='dd/MM/yyyy HH:mm'}" Width="130" />
                                        <DataGridTextColumn Header="Plataforma" Binding="{Binding PlatformBadge}" FontWeight="Bold" Width="95" />
                                        <DataGridTextColumn Header="Técnico" Binding="{Binding TechnicianName}" FontWeight="Bold" Width="150" />
                                        <DataGridTextColumn Header="Empresa" Binding="{Binding Company}" Width="110" />
                                        <DataGridTextColumn Header="Matrícula" Binding="{Binding EmployeeId}" Width="85" />
                                        <DataGridTextColumn Header="Cluster" Binding="{Binding Cluster}" Width="100" />
                                        <DataGridTextColumn Header="UF" Binding="{Binding Uf}" Width="45" />
                                        <DataGridTextColumn Header="Dias" Binding="{Binding ValidDays}" Width="50" />
                                        <DataGridTextColumn Header="Expira em" Binding="{Binding ExpirationDate}" Width="90" />
                                        <DataGridTextColumn Header="Notas" Binding="{Binding Notes}" Width="*" />
                                        <DataGridTextColumn Header="Chave (Início)" Binding="{Binding LicenseToken}" Width="180" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ABA 2: GESTÃO DE CÓPIAS EM CAMPO (ONLINE & OFFLINE) -->
            <TabItem Header="💻 Gestão de Cópias em Campo">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- BARRA SUPERIOR COM MÉTRICAS E BUSCA -->
                    <Border Grid.Row="0" Background="#18181B" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                        <DockPanel>
                            <!-- Métricas Rápidas -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,6,0">
                                    <TextBlock x:Name="TxtTotalCopias" Text="👥 Total: 0 técnicos" FontWeight="Bold" FontSize="11.5" Foreground="#E4E4E7" />
                                </Border>
                                <Border Background="#14532D" CornerRadius="6" Padding="8,4" Margin="0,0,6,0">
                                    <TextBlock x:Name="TxtCopiasAtivas" Text="🟢 Ativas: 0" FontWeight="Bold" FontSize="11.5" Foreground="#4ADE80" />
                                </Border>
                                <Border Background="#713F12" CornerRadius="6" Padding="8,4" Margin="0,0,6,0">
                                    <TextBlock x:Name="TxtCopiasExpirando" Text="🟡 A Expirar (&lt;7d): 0" FontWeight="Bold" FontSize="11.5" Foreground="#FDE047" />
                                </Border>
                                <Border Background="#7F1D1D" CornerRadius="6" Padding="8,4" Margin="0,0,6,0">
                                    <TextBlock x:Name="TxtCopiasRevogadas" Text="🚫 Revogadas: 0" FontWeight="Bold" FontSize="11.5" Foreground="#F87171" />
                                </Border>
                                <Border Background="#1E293B" CornerRadius="6" Padding="8,4" Margin="0,0,6,0">
                                    <TextBlock x:Name="TxtCopiasWindowsCount" Text="🪟 Win: 0" FontWeight="Bold" FontSize="11.5" Foreground="#38BDF8" />
                                </Border>
                                <Border Background="#1E293B" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                                    <TextBlock x:Name="TxtCopiasAndroidCount" Text="📱 And: 0" FontWeight="Bold" FontSize="11.5" Foreground="#4ADE80" />
                                </Border>
                            </StackPanel>

                            <!-- Busca e Sincronização -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="🔍 Filtrar:" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11.5" />
                                <TextBox x:Name="TxtFiltroCopias" Width="140" Height="28" Padding="6,4" Background="#27272A" Foreground="White" BorderBrush="#52525B" FontSize="11.5" TextChanged="TxtFiltroCopias_TextChanged" />
                                <ComboBox x:Name="CbFiltroPlataformaCopias" SelectedIndex="0" Height="28" Width="125" Margin="6,0,0,0" FontSize="11" SelectionChanged="CbFiltroPlataformaCopias_SelectionChanged">
                                    <ComboBoxItem Content="🌐 Todas Plat." />
                                    <ComboBoxItem Content="🪟 Windows" />
                                    <ComboBoxItem Content="📱 Android" />
                                </ComboBox>
                                <Button Content="🔄 Atualizar Lista" Padding="10,5" Margin="8,0,0,0" Background="#0D9488" Foreground="White" FontWeight="Bold" FontSize="11.5" BorderThickness="0" Cursor="Hand" Click="BtnRecarregarCopias_Click" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- TABELA DE CÓPIAS / TÉCNICOS -->
                    <Border Grid.Row="1" Background="#18181B" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="Técnicos Registrados e Cópias Ativas do SPARC" FontWeight="Bold" FontSize="13" Foreground="#F4F4F5" VerticalAlignment="Center" />
                                <TextBlock Text="Controle de Validade, Renovação em 1 Clique e Bloqueio Remoto" FontSize="11" Foreground="#A1A1AA" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </DockPanel>

                            <DataGrid Grid.Row="1" x:Name="DgCopiasCampo" AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="#27272A" Foreground="#E4E4E7" RowBackground="#1F1F23" AlternatingRowBackground="#27272A"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#3F3F46" BorderBrush="#3F3F46" BorderThickness="1"
                                      SelectionMode="Single" SelectionChanged="DgCopiasCampo_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Status" Binding="{Binding StatusBadge}" FontWeight="Bold" Width="110" />
                                    <DataGridTextColumn Header="Plataforma" Binding="{Binding PlatformBadge}" FontWeight="Bold" Width="95" />
                                    <DataGridTextColumn Header="Técnico" Binding="{Binding FullName}" FontWeight="Bold" Width="150" />
                                    <DataGridTextColumn Header="Empresa" Binding="{Binding Company}" Width="110" />
                                    <DataGridTextColumn Header="Matrícula" Binding="{Binding EmployeeId}" Width="85" />
                                    <DataGridTextColumn Header="Cluster" Binding="{Binding Cluster}" Width="110" />
                                    <DataGridTextColumn Header="UF" Binding="{Binding Uf}" Width="50" />
                                    <DataGridTextColumn Header="WhatsApp / Tel" Binding="{Binding Phone}" Width="120" />
                                    <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="150" />
                                    <DataGridTextColumn Header="Expira em" Binding="{Binding ExpirationDateIso}" Width="95" />
                                    <DataGridTextColumn Header="Dias" Binding="{Binding ValidDays}" Width="50" />
                                    <DataGridTextColumn Header="Versão" Binding="{Binding ClientVersion}" Width="65" />
                                    <DataGridTextColumn Header="Último Check-in" Binding="{Binding LastSeenUtc, StringFormat='dd/MM/yyyy HH:mm'}" Width="120" />
                                    <DataGridTextColumn Header="Notas / Hardware" Binding="{Binding MachineGuid}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- PAINEL DE AÇÕES PARA O TÉCNICO SELECIONADO -->
                            <Border Grid.Row="2" Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,8,0,0">
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Ações para o Técnico Selecionado:" FontWeight="Bold" FontSize="11.5" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <Button x:Name="BtnEditarCopia" Content="✏️ Editar Dados" Padding="10,5" Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="11.5" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0" Click="BtnEditarCopia_Click" ToolTip="Edita Nome, Empresa, Matrícula, WhatsApp, E-mail, Cluster e UF do técnico com sincronização imediata na nuvem" />
                                        <Button x:Name="BtnLiberarAcesso" Content="🔓 Liberar / Reativar" Padding="10,5" Background="#059669" Foreground="White" FontWeight="Bold" FontSize="11.5" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0" Click="BtnLiberarAcesso_Click" ToolTip="Reativa o acesso de um técnico revogado ou vencido com nova chave de 30 dias na nuvem" />
                                        <Button x:Name="BtnConceder30Dias" Content="➕ +30 Dias" Padding="10,5" Background="#16A34A" Foreground="White" FontWeight="Bold" FontSize="11.5" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0" Click="BtnConceder30Dias_Click" ToolTip="Estende a validade da licença em +30 dias" />
                                        <Button x:Name="BtnConceder60Dias" Content="➕ +60 Dias" Padding="10,5" Background="#15803D" Foreground="White" FontWeight="Bold" FontSize="11.5" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0" Click="BtnConceder60Dias_Click" ToolTip="Estende a validade da licença em +60 dias" />
                                        <Button x:Name="BtnConceder90Dias" Content="➕ +90 Dias" Padding="10,5" Background="#047857" Foreground="White" FontWeight="Bold" FontSize="11.5" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0" Click="BtnConceder90Dias_Click" ToolTip="Estende a validade da licença em +90 dias" />
                                        <Button x:Name="BtnProrrogarPersonalizado" Content="➕ Outro Prazo..." Padding="10,5" Background="#0D9488" Foreground="White" FontWeight="Bold" FontSize="11.5" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0" Click="BtnProrrogarPersonalizado_Click" ToolTip="Permite informar um número personalizado de dias para estender a licença" />
                                        <Button x:Name="BtnChamarWhatsApp" Content="💬 WhatsApp" Padding="10,5" Background="#25D366" Foreground="Black" FontWeight="Bold" FontSize="11.5" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0" Click="BtnChamarWhatsApp_Click" ToolTip="Abre conversa direta no WhatsApp Web com o técnico" />
                                        <Button x:Name="BtnRevogarAcesso" Content="🚫 Revogar Acesso" Padding="10,5" Background="#7F1D1D" Foreground="White" FontWeight="Bold" FontSize="11.5" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0" Click="BtnRevogarAcesso_Click" ToolTip="Bloqueia imediatamente a execução do SPARC nesta máquina" />
                                        <Button x:Name="BtnExcluirCopia" Content="🗑️ Remover Registro" Padding="10,5" Background="#450A0A" Foreground="#FCA5A5" BorderBrush="#991B1B" BorderThickness="1" FontWeight="Bold" FontSize="11.5" Cursor="Hand" Click="BtnExcluirCopia_Click" ToolTip="Exclui definitivamente este registro de teste da lista" />
                                    </StackPanel>

                                    <TextBlock x:Name="TxtCopiaSelecionadaInfo" Text="Selecione um técnico na tabela acima para gerenciar a licença" FontSize="11" Foreground="#38BDF8" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- PAINEL INFORMATIVO / SINCRONIZAÇÃO NUVEM -->
                    <Border Grid.Row="2" Background="#18181B" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Padding="12,10">
                        <DockPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="🌐 Sincronização Online com Nuvem (GitHub devices.json)" FontWeight="Bold" FontSize="12.5" Foreground="#38BDF8" />
                                <TextBlock Text="As licenças concedidas ou revogadas são salvas em C:\SPARC\beta\devices.json para sincronização automática com as cópias em campo." FontSize="11" Foreground="#A1A1AA" Margin="0,2,0,0" />
                            </StackPanel>

                            <Button Content="📁 Abrir Pasta de Licenças" Padding="12,6" HorizontalAlignment="Right" Background="#3F3F46" Foreground="White" BorderThickness="0" FontWeight="SemiBold" FontSize="11.5" Cursor="Hand" Click="BtnAbrirPastaDevices_Click" />
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ABA 3: GESTÃO DO REPOSITÓRIO DE FIRMWARES -->
            <TabItem Header="🌐 Gestão do Repositório de Firmwares">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- BARRA DE AÇÕES SUPERIOR -->
                    <Border Grid.Row="0" Background="#18181B" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="🌐 Testar Conexão com GitHub" Padding="12,6" Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="12" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0" Click="BtnTestarGitHub_Click" />
                                    <Button Content="🔄 Atualizar Lista de Modelos" Padding="10,6" Background="#0D9488" Foreground="White" FontWeight="Bold" FontSize="12" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0" Click="BtnRecarregarModelos_Click" />
                                    <Button Content="📁 Abrir C:\SPARC\firmwares" Padding="10,6" Background="#3F3F46" Foreground="White" FontWeight="SemiBold" FontSize="12" BorderThickness="0" Cursor="Hand" Click="BtnAbrirPastaFirmwares_Click" />
                                </StackPanel>

                                <TextBlock x:Name="TxtStatusRepoOnline" Text="Repositório Oficial: https://github.com/Calcmann/repo" FontSize="11.5" Foreground="#A1A1AA" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </DockPanel>

                            <!-- LINHA DE CONFIGURAÇÃO DO TOKEN PAT (REPOSITÓRIO PRIVADO) -->
                            <DockPanel Background="#27272A" Margin="0,2,0,0" LastChildFill="True">
                                <Border Background="#3F3F46" CornerRadius="4" Padding="6,4" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="🔑 Token PAT (Privado):" Foreground="#F4F4F5" FontWeight="SemiBold" FontSize="11" />
                                </Border>
                                <Button Content="💾 Salvar Token" HorizontalAlignment="Right" Padding="10,4" Background="#10B981" Foreground="White" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand" Click="BtnSalvarToken_Click" ToolTip="Salva o token PAT localmente para autenticar as consultas ao repositório privado" />
                                <TextBox x:Name="TxtGitHubToken" Margin="0,0,8,0" Height="26" Padding="6,2" Background="#18181B" Foreground="#38BDF8" BorderBrush="#52525B" FontSize="11.5" FontFamily="Consolas" VerticalContentAlignment="Center" ToolTip="Cole aqui seu Personal Access Token do GitHub (ghp_... ou github_pat_...) com permissão Contents: Read-only" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- TABELA DE MODELOS HOMOLOGADOS -->
                    <Border Grid.Row="1" Background="#18181B" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="Modelos Suportados e Firmwares Homologados em Cache Local" FontWeight="Bold" FontSize="13" Foreground="#F4F4F5" VerticalAlignment="Center" />
                                <TextBlock Text="Regra de Arquivo Único: Apenas a versão mais recente é mantida por pasta" FontSize="11" Foreground="#A1A1AA" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </DockPanel>

                            <DataGrid Grid.Row="1" x:Name="DgModelosFirmware" AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="#27272A" Foreground="#E4E4E7" RowBackground="#1F1F23" AlternatingRowBackground="#27272A"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#3F3F46" BorderBrush="#3F3F46" BorderThickness="1"
                                      SelectionMode="Single" SelectionChanged="DgModelosFirmware_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Modelo / Série" Binding="{Binding DisplayName}" FontWeight="Bold" Width="180" />
                                    <DataGridTextColumn Header="Pasta no Repo" Binding="{Binding FolderName}" Width="120" FontFamily="Consolas" />
                                    <DataGridTextColumn Header="Arquivo Local Homologado" Binding="{Binding LocalFileName}" Width="260" FontFamily="Consolas" />
                                    <DataGridTextColumn Header="Versão" Binding="{Binding LocalVersion}" Width="100" />
                                    <DataGridTextColumn Header="Tamanho" Binding="{Binding LocalDisplaySize}" Width="90" />
                                    <DataGridTextColumn Header="Status Local" Binding="{Binding StatusDescription}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- AÇÕES DO MODELO SELECIONADO -->
                            <Border Grid.Row="2" Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,8,0,0">
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Ações para o Modelo:" FontWeight="Bold" FontSize="11.5" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <Button x:Name="BtnImportarFirmware" Content="📂 Importar / Substituir Homologação..." Padding="10,5" Background="#16A34A" Foreground="White" FontWeight="Bold" FontSize="11.5" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0" Click="BtnImportarFirmware_Click" ToolTip="Substitui o arquivo homologado desta pasta pela nova versão fornecida" />
                                        <Button x:Name="BtnPublicarModeloNuvem" Content="⬆️ Publicar este Modelo no GitHub" Padding="10,5" Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="11.5" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0" Click="BtnPublicarModeloNuvem_Click" ToolTip="Envia o firmware deste modelo diretamente para a Release no GitHub via API (sem navegador)" />
                                        <Button x:Name="BtnInspecionarChecksum" Content="🔍 Checksum &amp; Detalhes" Padding="10,5" Background="#3F3F46" Foreground="White" FontWeight="SemiBold" FontSize="11.5" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0" Click="BtnInspecionarChecksum_Click" />
                                        <Button x:Name="BtnLimparModelo" Content="🗑️ Limpar Pasta" Padding="10,5" Background="#7F1D1D" Foreground="White" FontWeight="SemiBold" FontSize="11.5" BorderThickness="0" Cursor="Hand" Click="BtnLimparModelo_Click" />
                                    </StackPanel>

                                    <TextBlock x:Name="TxtModeloSelecionadoInfo" Text="Selecione um modelo na tabela acima para gerenciar" FontSize="11" Foreground="#38BDF8" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- PAINEL DE DISTRIBUIÇÃO VIA GITHUB RELEASES -->
                    <Border Grid.Row="2" Background="#18181B" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Padding="12,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="🌐 Distribuição Oficial via GitHub Releases (CDN de Alta Velocidade)" FontWeight="Bold" FontSize="12.5" Foreground="#38BDF8" />
                                    <TextBlock Text="Hospedagem oficial dos arquivos homologados com suporte nativo a até 2 GB por arquivo (sem restrição de 100 MB)." FontSize="11" Foreground="#A1A1AA" Margin="0,2,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="BtnPublicarTodosNuvem" Content="🚀 Publicar Todos no GitHub (1 Clique)" Padding="12,6" Background="#16A34A" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="12" Cursor="Hand" Margin="0,0,8,0" Click="BtnPublicarTodosNuvem_Click" ToolTip="Envia todos os firmwares homologados em C:\SPARC\firmwares diretamente para a Release no GitHub via API" />
                                    <Button x:Name="BtnChecarReleases" Content="🔄 Consultar Release Ativa" Padding="12,6" Background="#0D9488" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="12" Cursor="Hand" Margin="0,0,8,0" Click="BtnChecarReleases_Click" ToolTip="Verifica a release ativa no GitHub e lista todos os firmwares disponíveis no CDN" />
                                    <Button x:Name="BtnAbrirCriarRelease" Content="🌐 Abrir no Navegador" Padding="10,6" Background="#3F3F46" Foreground="White" BorderThickness="0" FontWeight="SemiBold" FontSize="12" Cursor="Hand" Click="BtnAbrirCriarRelease_Click" ToolTip="Abre a tela de Releases no GitHub no navegador caso deseje inspecionar" />
                                </StackPanel>
                            </DockPanel>

                            <ProgressBar x:Name="PbUploadFirmware" Height="6" Margin="0,0,0,6" Minimum="0" Maximum="100" Visibility="Collapsed" Foreground="#38BDF8" Background="#27272A" BorderThickness="0" />

                            <TextBox x:Name="TxtLogGit" Height="85" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Background="#09090B" Foreground="#4ADE80" BorderBrush="#3F3F46" BorderThickness="1" Padding="8,6" FontSize="11" FontFamily="Consolas"
                                     Text="[SPARC Admin] Clique em '🚀 Publicar Todos no GitHub (1 Clique)' para fazer o upload automático de todos os modelos sem abrir o navegador." />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ABA 4: PUBLICAR VERSÃO HOMOLOGADA (SPARC UPDATE) -->
            <TabItem Header="🚀 Publicar Versão SPARC (Update)">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- CABEÇALHO DA ABA -->
                    <Border Grid.Row="0" Background="#18181B" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#065F46" CornerRadius="8" Width="38" Height="38" Margin="0,0,12,0">
                                    <TextBlock Text="🚀" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Central de Distribuição e Publicação de Versões Homologadas do SPARC" FontWeight="Bold" FontSize="13.5" Foreground="#34D399" />
                                    <TextBlock Text="Envie binários Windows (.exe) e Android (.apk) diretamente para o repositório oficial. Os clientes em campo detectarão a nova versão e poderão atualizar online." FontSize="11" Foreground="#A1A1AA" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- FORMULÁRIO DE PUBLICAÇÃO -->
                    <Border Grid.Row="1" Background="#18181B" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- SELETOR DE PLATAFORMA -->
                                <TextBlock Text="1. Plataforma de Destino:" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <RadioButton x:Name="RbPlataformaWindows" Content="🪟 Windows (SPARC-Beta-Testes-&lt;versão&gt;.exe)" IsChecked="True" Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="0,0,24,0" Checked="RbPlataformaUpdate_Checked" />
                                    <RadioButton x:Name="RbPlataformaAndroid" Content="📱 Android (SPARC-Mobile-v&lt;versão&gt;.apk)" Foreground="White" FontSize="12" FontWeight="SemiBold" Checked="RbPlataformaUpdate_Checked" />
                                </StackPanel>

                                <!-- SELEÇÃO DO ARQUIVO BINÁRIO -->
                                <TextBlock Text="2. Arquivo Binário Compilado Homologado:" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtCaminhoArquivoUpdate" Grid.Column="0" Height="32" Padding="8,6" Background="#27272A" Foreground="#38BDF8" BorderBrush="#52525B" FontSize="11.5" FontFamily="Consolas" />
                                    <Button x:Name="BtnProcurarArquivoUpdate" Grid.Column="1" Content="📁 Procurar..." Padding="12,6" Margin="8,0,0,0" Background="#3F3F46" Foreground="White" FontWeight="SemiBold" FontSize="11.5" Cursor="Hand" Click="BtnProcurarArquivoUpdate_Click" />
                                    <Button x:Name="BtnDetectarUltimoBuild" Grid.Column="2" Content="🔍 Detectar Último Build (dist-beta)" Padding="12,6" Margin="8,0,0,0" Background="#0D9488" Foreground="White" FontWeight="Bold" FontSize="11.5" Cursor="Hand" Click="BtnDetectarUltimoBuild_Click" />
                                </Grid>

                                <!-- NÚMERO DA VERSÃO E DATA -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="3. Número da Versão (ex: 0.8.34):" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,6" />
                                        <TextBox x:Name="TxtVersaoUpdate" Height="32" Padding="8,6" Background="#27272A" Foreground="#4ADE80" BorderBrush="#52525B" FontSize="12" FontWeight="Bold" FontFamily="Consolas" Text="0.8.34" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Nome do Arquivo no Repositório:" FontSize="12" FontWeight="Bold" Foreground="#A1A1AA" Margin="0,0,0,6" />
                                        <TextBox x:Name="TxtNomeArquivoDestino" Height="32" Padding="8,6" Background="#27272A" Foreground="#A1A1AA" BorderBrush="#3F3F46" FontSize="12" FontFamily="Consolas" IsReadOnly="True" Text="SPARC-Beta-Testes.exe" />
                                    </StackPanel>
                                </Grid>

                                <!-- NOTAS DA VERSÃO (CHANGELOG) -->
                                <TextBlock Text="4. Notas de Lançamento / O que mudou nesta versão:" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,6" />
                                <TextBox x:Name="TxtNotasUpdate" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                         Background="#27272A" Foreground="White" BorderBrush="#52525B" Padding="8,6" FontSize="11.5" Margin="0,0,0,16"
                                         Text="Versão homologada com atualização automática online, sanitização unificada e controle de licenças centralizado." />

                                <!-- BOTÃO PUBLICAR -->
                                <Button x:Name="BtnPublicarVersaoHomologada" Content="⬆️ PUBLICAR VERSÃO HOMOLOGADA NO REPOSITÓRIO OFICIAL" Height="44" Background="#16A34A" Foreground="White" FontWeight="Black" FontSize="13" BorderThickness="0" Cursor="Hand" Click="BtnPublicarVersaoHomologada_Click" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- LOG E STATUS DA PUBLICAÇÃO -->
                    <Border Grid.Row="2" Background="#18181B" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Padding="12,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock x:Name="TxtStatusPublicacaoUpdate" Text="Aguardando publicação..." FontSize="11" Foreground="#A1A1AA" FontWeight="SemiBold" />
                                <Button Content="🌐 Consultar Manifesto version.json" Padding="8,3" Background="#3F3F46" Foreground="White" BorderThickness="0" FontSize="10.5" Cursor="Hand" HorizontalAlignment="Right" Click="BtnConsultarManifesto_Click" />
                            </DockPanel>
                            <ProgressBar x:Name="PbUploadUpdate" Height="6" Minimum="0" Maximum="100" Visibility="Collapsed" Foreground="#34D399" Background="#27272A" BorderThickness="0" Margin="0,0,0,6" />
                            <TextBox x:Name="TxtLogUpdate" Height="65" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Background="#09090B" Foreground="#38BDF8" BorderBrush="#3F3F46" BorderThickness="1" Padding="8,4" FontSize="11" FontFamily="Consolas"
                                     Text="[SPARC Update] Selecione o binário compilado e clique em Publicar para liberar a versão homologada a todos os técnicos." />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- RODAPÉ -->
        <Border Grid.Row="2" Margin="0,10,0,0">
            <DockPanel>
                <TextBlock Text="SPARC Suite • Módulo de Governança Criptográfica e Distribuição de Firmwares" FontSize="11" Foreground="#71717A" VerticalAlignment="Center" />
                <Button Content="Fechar" HorizontalAlignment="Right" Padding="14,4" Background="#3F3F46" Foreground="White" BorderThickness="0" FontWeight="SemiBold" FontSize="11.5" Cursor="Hand" Click="BtnFechar_Click" />
            </DockPanel>
        </Border>
    </Grid>
</Window>

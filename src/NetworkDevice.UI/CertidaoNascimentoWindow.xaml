<Window x:Class="NetworkDevice.UI.CertidaoNascimentoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SPARC — Certidão de Nascimento Oficial (ITU-T Y.1564)"
        Icon="Assets/sparc.ico"
        Height="780" Width="960"
        MinHeight="660" MinWidth="840"
        WindowStartupLocation="CenterOwner"
        Background="#0B0F19">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto" />
            <!-- 1: Conteúdo Principal -->
            <RowDefinition Height="*" />
            <!-- 2: Rodapé e Ações -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= 0: HEADER DA CERTIDÃO ================= -->
        <Border Grid.Row="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Image Source="Assets/sparc_logo_horizontal.png" Height="38" Margin="0,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                    <Border Background="#DC2626" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                        <TextBlock Text="📜 CERTIDÃO DE NASCIMENTO" FontWeight="Black" FontSize="11.5" Foreground="#FFFFFF" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="TxtHeaderTitulo" Text="Homologação e Entrega de Circuito (ITU-T Y.1564)" FontWeight="Bold" FontSize="13.5" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="Aferição Oficial de Banda e SLA para Certidão de Nascimento Embratel / Claro (MTS-5800 &amp; QT-600)" FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Border Grid.Column="2" x:Name="BadgeStatus" Background="#334155" CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatusGeral" Text="⚪ AGUARDANDO REFLETOR" FontWeight="Black" FontSize="12" Foreground="#FFFFFF" TextAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- ================= 1: CONTEÚDO PRINCIPAL ================= -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,0,6">

                <!-- CARD 1: DADOS DO CIRCUITO (IMPORTADOS DA SAIP) -->
                <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="📋 DADOS DO CIRCUITO (FICHA SAIP)" FontWeight="Black" FontSize="12.5" Foreground="#38BDF8" DockPanel.Dock="Left" />
                            <Border Background="#1E293B" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                <TextBlock Text="✓ Ficha SAIP Reconhecida" FontSize="10.5" FontWeight="Bold" Foreground="#4ADE80" />
                            </Border>
                        </DockPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.2*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.4*" />
                            </Grid.ColumnDefinitions>

                            <!-- Cliente -->
                            <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="Cliente / Razão Social:" FontSize="10.5" Foreground="#94A3B8" />
                                    <TextBlock x:Name="TxtClienteNome" Text="Identificando..." FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Designação -->
                            <Border Grid.Column="1" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="Designação IP:" FontSize="10.5" Foreground="#94A3B8" />
                                    <TextBlock x:Name="TxtDesignacao" Text="—" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Velocidade CIR -->
                            <Border Grid.Column="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="Velocidade (CIR):" FontSize="10.5" Foreground="#94A3B8" />
                                    <TextBlock x:Name="TxtVelocidadeCir" Text="— Mbps" FontSize="13" FontWeight="Bold" Foreground="#F59E0B" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Gateway WAN / Destino -->
                            <Border Grid.Column="3" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,6">
                                <StackPanel>
                                    <TextBlock Text="Gateway PE / Destino:" FontSize="10.5" Foreground="#94A3B8" />
                                    <TextBlock x:Name="TxtDestinoIp" Text="—" FontSize="13" FontWeight="Bold" Foreground="#34D399" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Linha 2: Endereçamento MAC para Amarração de Equipamentos & IP QT-600 Alvo -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.2*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.4*" />
                            </Grid.ColumnDefinitions>

                            <!-- MAC Local (Dispositivo de Rede) -->
                            <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,6,0">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="Endereço MAC Dispositivo Local:" FontSize="10.5" Foreground="#94A3B8" DockPanel.Dock="Left" />
                                        <Button x:Name="BtnCopiarMac" Content="📋 Copiar" Padding="5,1" FontSize="9.5" Background="#1E293B" Foreground="#38BDF8" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right" Click="BtnCopiarMac_Click" ToolTip="Copiar endereço MAC local para a área de transferência" />
                                    </DockPanel>
                                    <TextBox x:Name="TxtMacDispositivo" Text="Detectando MAC..." FontSize="12.5" FontWeight="Bold" FontFamily="Consolas" Foreground="#38BDF8" Background="#182234" BorderBrush="#334155" Padding="4,2" Margin="0,3,0,0" ToolTip="Endereço MAC físico da interface de rede (NIC). Em alguns testes L2/L3 é necessário amarrar os MACs dos equipamentos." />
                                </StackPanel>
                            </Border>

                            <!-- MAC Destino (Amarração Remota) -->
                            <Border Grid.Column="1" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="MAC Remoto / Amarração L2:" FontSize="10.5" Foreground="#94A3B8" />
                                    <TextBox x:Name="TxtMacDestino" Text="FF:FF:FF:FF:FF:FF" FontSize="12" FontFamily="Consolas" Foreground="#F8FAFC" Background="#182234" BorderBrush="#334155" Padding="4,2" Margin="0,3,0,0" ToolTip="MAC do equipamento alvo/remoto para testes com amarração L2 (MTS-5800 / QT-600)" />
                                </StackPanel>
                            </Border>

                            <!-- IP do QT-600 Alvo (Central / NOC) -->
                            <Border Grid.Column="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="IP QT-600 Alvo (NOC):" FontSize="10.5" Foreground="#94A3B8" />
                                    <TextBox x:Name="TxtIpQt600Alvo" Text="—" FontSize="12" FontFamily="Consolas" FontWeight="Bold" Foreground="#34D399" Background="#182234" BorderBrush="#334155" Padding="4,2" Margin="0,3,0,0" ToolTip="Endereço IP do elemento remoto QT-600 (conforme OT-ENG-053 Passo 6.8)" />
                                </StackPanel>
                            </Border>

                            <!-- Sinalização / Tecnologia de Acesso -->
                            <Border Grid.Column="3" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,6">
                                <StackPanel>
                                    <TextBlock Text="Acesso / Sinalização:" FontSize="10.5" Foreground="#94A3B8" />
                                    <TextBlock x:Name="TxtTecnologiaSinalizacao" Text="FO EDD / Padrão" FontSize="12" FontWeight="SemiBold" Foreground="#A78BFA" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- CARD DE GESTÃO DE DHCP DA LAN (BANCADA & TESTES) -->
                <Border Background="#0C1322" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🛡️ DHCP LAN do Roteador:" FontWeight="Bold" FontSize="11.5" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Mantido ativo para testes com MTS-5800 / Smartphone." FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnAtivarDhcpNaCertidao" Content="📶 Reativar DHCP LAN (3s)" Padding="8,4" Margin="0,0,8,0" Background="#0D9488" Foreground="White" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand" Click="BtnAtivarDhcpNaCertidao_Click" ToolTip="Reativa sob demanda o servidor DHCP temporário no roteador via console serial em 3 segundos" />
                            <Button x:Name="BtnRemoverDhcpNaCertidao" Content="🔒 Remover DHCP e Gravar NVRAM" Padding="8,4" Background="#7F1D1D" Foreground="#FCA5A5" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand" Click="BtnRemoverDhcpNaCertidao_Click" ToolTip="Remove o DHCP temporário e grava a NVRAM estática homologada para entrega ao cliente" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- CARD 2: CONFIGURAÇÃO SIMPLIFICADA DO TESTE -->
                <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="⚙️ PARÂMETROS DO TESTE (SIMPLIFICADO)" FontWeight="Black" FontSize="12.5" Foreground="#38BDF8" Margin="0,0,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.2*" />
                                <ColumnDefinition Width="1.8*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="1.4*" />
                            </Grid.ColumnDefinitions>

                            <!-- Tipo de Serviço Oficial (Descritivo Embratel) -->
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Serviço Homologado (Descritivo Técnico):" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4" />
                                <ComboBox x:Name="CmbTipoServico" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="8,5" FontSize="11.5" FontWeight="SemiBold" SelectionChanged="CmbTipoServico_SelectionChanged">
                                    <ComboBoxItem Content="🌐 BLD — Business Link Direct (Internet Simétrica - Padrão)" Tag="BLD" IsSelected="True" ToolTip="Padrão Embratel BLD: S-VLAN 100, DSCP CS1 (8), Quadro 1518B, MEF Low" />
                                    <ComboBoxItem Content="🛡️ MPLS — IPVPN Corporativa (LAN temporária / sem SpeedTest)" Tag="MPLS" ToolTip="Padrão Embratel MPLS: S-VLAN 400 (ou 300), classes Voz/Vídeo/BE, MEF Medium" />
                                    <ComboBoxItem Content="📞 VOZ — Tronco Digital (R2D / ISDN - E1) (LAN temporária)" Tag="VOZ_E1" ToolTip="Padrão Embratel E1: Tronco Digital R2D / ISDN entregue em interface E1 no roteador, LAN temporária arbitrada" />
                                    <ComboBoxItem Content="📞 VOZ — Tronco SIP / PABX IP (SIP com WAN/LAN Padrão)" Tag="VOZ_SIP" ToolTip="Padrão Embratel SIP: Sinalização SIP / PABX IP, S-VLAN 200, DSCP EF (46), Quadro 64B/256B, MEF High" />
                                </ComboBox>
                            </StackPanel>

                            <!-- Modo de Operação -->
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Modo de Operação:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4" />
                                <ComboBox x:Name="CmbModoOperacao" Background="#0F172A" Foreground="#38BDF8" BorderBrush="#334155" Padding="8,5" FontSize="11.5" FontWeight="SemiBold" SelectionChanged="CmbModoOperacao_SelectionChanged">
                                    <ComboBoxItem Content="🔄 Modo Refletor (Aguardar Central QT-600)" Tag="Loopback" IsSelected="True" ToolTip="O SPARC entra em modo Refletor LLB (MTS-5800 na porta 5001) para que a Central/NOC execute o teste." />
                                    <ComboBoxItem Content="⚡ Teste pelo Notebook (SPARC Master)" Tag="Master" ToolTip="O SPARC gera a carga de teste contra o Gateway/PE e afere o circuito." />
                                </ComboBox>
                            </StackPanel>

                            <!-- Distância / Perfil MEF -->
                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="Distância MEF 23.1:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4" />
                                <ComboBox x:Name="CmbDistanciaMef" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="8,5" FontSize="11.5" SelectionChanged="CmbDistanciaMef_SelectionChanged">
                                    <ComboBoxItem Content="≤ 1200 Km (Regional)" Tag="1200" IsSelected="True" />
                                    <ComboBoxItem Content="≤ 250 Km (Metropolitano)" Tag="250" />
                                    <ComboBoxItem Content="≤ 7000 Km (Nacional)" Tag="7000" />
                                </ComboBox>
                            </StackPanel>

                            <!-- Duração do Teste -->
                            <StackPanel Grid.Column="3">
                                <TextBlock x:Name="LblDuracaoTitulo" Text="Tempo do Refletor:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4" />
                                <Grid>
                                    <Border x:Name="BorderDuracaoIndefinida" Background="#0F172A" BorderBrush="#059669" BorderThickness="1" CornerRadius="4" Padding="8,5" Visibility="Visible">
                                        <TextBlock Text="⏱️ Indefinida (QT-600)" FontSize="11.5" FontWeight="SemiBold" Foreground="#34D399" VerticalAlignment="Center" />
                                    </Border>
                                    <ComboBox x:Name="CmbDuracao" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="8,5" FontSize="11.5" Visibility="Collapsed">
                                        <ComboBoxItem Content="⚡ 1 Minuto (Expresso)" Tag="1" />
                                        <ComboBoxItem Content="⏱️ 5 Minutos (Recomendado)" Tag="5" IsSelected="True" />
                                        <ComboBoxItem Content="📜 15 Minutos (Oficial Claro)" Tag="15" />
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- Banner explicativo dos parâmetros selecionados -->
                        <Border Background="#090D16" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,10,0,0">
                            <TextBlock x:Name="TxtResumoParametros" Text="Parâmetros: S-VLAN 100 | Quadro: 1518 Bytes | DSCP: CS1 (8) | SLA: Perda &lt;= 0.02%, Latência &lt;= 40ms, Jitter &lt;= 16ms" FontSize="11" Foreground="#94A3B8" FontFamily="Consolas" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- CARD 3: RESULTADOS E MÉTRICAS EM TEMPO REAL -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Métrica 1: Velocidade -->
                    <Border Grid.Column="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Velocidade Atingida" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" TextAlignment="Center" />
                            <TextBlock x:Name="TxtMetricaVelocidade" Text="— Mbps" FontSize="22" FontWeight="Black" Foreground="#FFFFFF" TextAlignment="Center" Margin="0,4,0,2" />
                            <TextBlock x:Name="TxtMetricaVelocidadeSub" Text="Alvo: — Mbps" FontSize="10.5" Foreground="#94A3B8" TextAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Métrica 2: Perda de Pacotes -->
                    <Border Grid.Column="1" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Perda de Pacotes (FLR)" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" TextAlignment="Center" />
                            <TextBlock x:Name="TxtMetricaPerda" Text="— %" FontSize="22" FontWeight="Black" Foreground="#FFFFFF" TextAlignment="Center" Margin="0,4,0,2" />
                            <TextBlock x:Name="TxtMetricaPerdaSub" Text="SLA: &lt;= 0.02%" FontSize="10.5" Foreground="#94A3B8" TextAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Métrica 3: Latência (Atraso) -->
                    <Border Grid.Column="2" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Latência / Atraso (FTD)" FontSize="11" FontWeight="Bold" Foreground="#34D399" TextAlignment="Center" />
                            <TextBlock x:Name="TxtMetricaLatencia" Text="— ms" FontSize="22" FontWeight="Black" Foreground="#FFFFFF" TextAlignment="Center" Margin="0,4,0,2" />
                            <TextBlock x:Name="TxtMetricaLatenciaSub" Text="SLA: &lt;= 40 ms" FontSize="10.5" Foreground="#94A3B8" TextAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Métrica 4: Variação / Jitter -->
                    <Border Grid.Column="3" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="Variação / Jitter (IFDV)" FontSize="11" FontWeight="Bold" Foreground="#A78BFA" TextAlignment="Center" />
                            <TextBlock x:Name="TxtMetricaJitter" Text="— ms" FontSize="22" FontWeight="Black" Foreground="#FFFFFF" TextAlignment="Center" Margin="0,4,0,2" />
                            <TextBlock x:Name="TxtMetricaJitterSub" Text="SLA: &lt;= 16 ms" FontSize="10.5" Foreground="#94A3B8" TextAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- CARD 4: PROGRESSO E LOG SIMPLIFICADO -->
                <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock x:Name="TxtEtapaProgresso" Text="Modo Refletor (compatível MTS-5800 LLB): pronto para responder ao QT-600." FontSize="12" FontWeight="Bold" Foreground="#F8FAFC" DockPanel.Dock="Left" />
                            <TextBlock x:Name="TxtTempoRestante" Text="00:00 (Indefinido)" FontSize="11.5" Foreground="#94A3B8" HorizontalAlignment="Right" FontFamily="Consolas" />
                        </DockPanel>
                        <ProgressBar x:Name="PbProgresso" Height="10" Minimum="0" Maximum="100" Value="0" Foreground="#DC2626" Background="#1E293B" BorderThickness="0" Margin="0,0,0,8" />
                        <Border Background="#030712" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="6" Padding="8" MaxHeight="130">
                            <ScrollViewer x:Name="ScrollLog" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="TxtLogSimplificado" Text="• Clique em 'ATIVAR REFLETOR MTS-5800' para aguardar o disparo da Central QT-600." FontFamily="Consolas, Cascadia Mono" FontSize="11" Foreground="#38BDF8" TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= 2: RODAPÉ E AÇÕES ================= -->
        <Border Grid.Row="2" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="14,10">
            <DockPanel LastChildFill="True">
                <!-- Ações da Esquerda (Iniciar / Parar) -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button x:Name="BtnIniciarCertidao" Content="🟢 ATIVAR REFLETOR MTS-5800 (LOOPBACK LLB)" Padding="16,8" Margin="0,0,8,0" Background="#059669" Foreground="White" FontWeight="Black" FontSize="13" BorderThickness="0" Cursor="Hand" Click="BtnIniciarCertidao_Click" ToolTip="Ativa o modo Refletor LLB na porta 5001 para que a Central/NOC dispare o teste padrão de 15 minutos do QT-600" />
                    <Button x:Name="BtnInterromper" Content="⏹ Interromper" Padding="12,8" Margin="0,0,8,0" Background="#B91C1C" Foreground="White" FontWeight="Bold" FontSize="12" BorderThickness="0" Cursor="Hand" IsEnabled="False" Click="BtnInterromper_Click" />
                    <Button x:Name="BtnZerar" Content="🧹 Limpar" Padding="10,8" Margin="0,0,10,0" Background="#334155" Foreground="White" FontWeight="Bold" FontSize="11.5" BorderThickness="0" Cursor="Hand" Click="BtnZerar_Click" />
                </StackPanel>

                <!-- Ações da Direita (PDF e Fechar) -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button x:Name="BtnVisualizarPdf" Content="📄 Abrir Certidão (PDF)" Padding="13,8" Margin="0,0,8,0" Background="#059669" Foreground="White" FontWeight="Black" FontSize="12.5" BorderThickness="0" Cursor="Hand" Visibility="Collapsed" Click="BtnVisualizarPdf_Click" ToolTip="Visualiza o relatório oficial da Certidão de Nascimento gerado" />
                    <Button x:Name="BtnSalvarPdf" Content="💾 Salvar Certidão (.pdf)" Padding="12,8" Margin="0,0,8,0" Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="12" BorderThickness="0" Cursor="Hand" Visibility="Collapsed" Click="BtnSalvarPdf_Click" ToolTip="Salva a certidão renomeada automaticamente no padrão oficial Embratel (ex.: SPO-IP-47287.pdf)" />
                    <Button x:Name="BtnAbrirPasta" Content="📁 Abrir Pasta" Padding="10,8" Margin="0,0,12,0" Background="#3F3F46" Foreground="White" FontWeight="Bold" FontSize="11.5" BorderThickness="0" Cursor="Hand" Visibility="Collapsed" Click="BtnAbrirPasta_Click" />
                    <Button x:Name="BtnAbrirAvancado" Content="⚙️ Analisador Avançado" Padding="8,8" Margin="0,0,8,0" Background="Transparent" Foreground="#94A3B8" BorderBrush="#334155" BorderThickness="1" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Click="BtnAbrirAvancado_Click" ToolTip="Abre o Analisador Técnico Detalhado Y.1564 com suporte a frames IMIX, Jumbo e Npcap" />
                    <Button Content="Fechar" Padding="14,8" Background="#27272A" Foreground="#E4E4E7" FontSize="12" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnFechar_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>

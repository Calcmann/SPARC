<Window x:Class="NetworkDevice.UI.SetupWorkspaceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SPARC — Configuração de Instalação e Espaço de Trabalho"
        Icon="Assets/sparc.ico"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#18181B"
        FontFamily="Segoe UI"
        Foreground="#E4E4E7">

    <Border Padding="22" Background="#18181B" BorderBrush="#3F3F46" BorderThickness="1">
        <StackPanel>
            <!-- CABEÇALHO -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Border Background="#991B1B" CornerRadius="8" Width="48" Height="48" Margin="0,0,14,0">
                    <TextBlock Text="🚀" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Instalação e Espaço de Trabalho" FontWeight="Black" FontSize="16" Foreground="#F87171" />
                    <TextBlock Text="Defina a pasta onde o SPARC e seus dados ficarão centralizados." FontSize="11.5" Foreground="#A1A1AA" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- CARD EXPLICATIVO -->
            <Border Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Esta pasta será a base permanente para:" FontSize="11.5" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,6" />
                    <TextBlock Text="• O executável oficial do SPARC (SPARC.exe)" FontSize="11.5" Foreground="#D4D4D8" Margin="4,1" />
                    <TextBlock Text="• Repositório de firmwares de roteadores (.bin / .out / .ipe)" FontSize="11.5" Foreground="#D4D4D8" Margin="4,1" />
                    <TextBlock Text="• Relatórios técnicos de homologação em PDF e HTML" FontSize="11.5" Foreground="#D4D4D8" Margin="4,1" />
                    <TextBlock Text="• Certidões de homologação Y.1564 e backups de configuração" FontSize="11.5" Foreground="#D4D4D8" Margin="4,1" />
                </StackPanel>
            </Border>

            <!-- CAMPO DE SELEÇÃO DE PASTA -->
            <TextBlock Text="Pasta de Trabalho / Repositório:" FontSize="11.5" FontWeight="Bold" Foreground="#A1A1AA" Margin="0,0,0,6" />
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TxtWorkspacePath" Grid.Column="0" Height="34" VerticalContentAlignment="Center"
                         Background="#18181B" Foreground="#FFFFFF" BorderBrush="#52525B" BorderThickness="1"
                         Padding="10,0" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,8,0" />

                <Button x:Name="BtnProcurarPasta" Grid.Column="1" Content="📁 Alterar..." Height="34" Padding="14,0"
                        Background="#3F3F46" Foreground="#FFFFFF" BorderThickness="0" FontWeight="SemiBold"
                        FontSize="11.5" Cursor="Hand" Click="BtnProcurarPasta_Click" />
            </Grid>

            <!-- OPÇÃO DE ATALHO NO DESKTOP -->
            <CheckBox x:Name="ChkCriarAtalhoDesktop" IsChecked="True" Margin="0,0,0,18" Cursor="Hand">
                <TextBlock Text="Criar atalho 'SPARC' na Área de Trabalho (Desktop)" FontSize="12" Foreground="#E4E4E7" FontWeight="SemiBold" />
            </CheckBox>

            <!-- BOTÕES DE AÇÃO -->
            <DockPanel Margin="0,4,0,0">
                <Button x:Name="BtnModoPortatil" Content="⚡ Executar sem Instalar (Portátil)" HorizontalAlignment="Left"
                        Padding="14,8" Background="#3F3F46" Foreground="#E4E4E7" BorderThickness="0"
                        FontWeight="SemiBold" FontSize="11.5" Cursor="Hand" Click="BtnModoPortatil_Click" />

                <Button x:Name="BtnInstalarEIniciar" Content="🚀 Instalar e Iniciar" HorizontalAlignment="Right"
                        Padding="18,8" Background="#16A34A" Foreground="#FFFFFF" BorderThickness="0"
                        FontWeight="Black" FontSize="12" Cursor="Hand" Click="BtnInstalarEIniciar_Click" />
            </DockPanel>
        </StackPanel>
    </Border>
</Window>

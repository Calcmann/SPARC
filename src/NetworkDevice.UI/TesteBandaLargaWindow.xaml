<Window x:Class="NetworkDevice.UI.TesteBandaLargaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SPARC — Módulo Avançado de Telemetria de Banda Larga &amp; Qualidade de Link"
        Icon="Assets/sparc.ico"
        Height="870" Width="1060"
        MinHeight="740" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Background="#080C15">

    <Window.Resources>
        <!-- Estilo dos Botões Primários com Efeito Visual Moderno -->
        <Style x:Key="ModernGradientButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.80" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.40" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo dos Cards HUD Escuros -->
        <Style x:Key="HudCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="BorderBrush" Value="#1E293B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
    </Window.Resources>

    <Grid Margin="16,14">
        <Grid.RowDefinitions>
            <!-- 0: Header Executivo -->
            <RowDefinition Height="Auto" />
            <!-- 1: Conteúdo Rolável Principal -->
            <RowDefinition Height="*" />
            <!-- 2: Rodapé de Ações -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= 0: HEADER DA JANELA (EXECUTIVE SLATE) ================= -->
        <Border Grid.Row="0" Style="{StaticResource HudCardStyle}" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Identidade Visual SPARC & Tag de Certificação -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Image Source="Assets/sparc_logo_horizontal.png" Height="38" Margin="0,0,14,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                    <Border Background="#6366F1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                        <TextBlock Text="⚡ BANDA LARGA &amp; QUALIDADE" FontWeight="Black" FontSize="11" Foreground="#FFFFFF" />
                    </Border>
                </StackPanel>

                <!-- Título e Subtítulo Tecnológico -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Telemetria de Vazão, Jitter, Bufferbloat &amp; Física de Fibra Óptica" FontWeight="Bold" FontSize="13.5" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="Speed.Cloudflare Engine • Multi-Datacenter Anycast • Fallback Resiliente • ITU-T / RFC 6349" FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Badge de Status Executivo -->
                <Border Grid.Column="2" x:Name="BadgeStatus" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14,7" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtStatusDot" Text="●" FontSize="12" Foreground="#38BDF8" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtStatusGeral" Text="PRONTO PARA TESTAR" FontWeight="Black" FontSize="11.5" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ================= 1: CONTEÚDO PRINCIPAL (ROLÁVEL) ================= -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,0,4">

                <!-- CARD 1: SELEÇÃO DE SERVIDOR & PRÉ-TESTE AUTOMÁTICO -->
                <Border Style="{StaticResource HudCardStyle}" Padding="16,14" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock Text="🌐 SELEÇÃO DE SERVIDOR &amp; PROVEDOR" FontWeight="Black" FontSize="12" Foreground="#38BDF8" />
                                <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                    <TextBlock Text="PRÉ-TESTE AUTOMÁTICO ATIVO" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8" />
                                </Border>
                            </StackPanel>

                            <Button x:Name="BtnRecarregarServidores" Content="🔄 Re-sondar Servidores" Padding="10,4" FontSize="11" FontWeight="Bold" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#334155" BorderThickness="1" Cursor="Hand" HorizontalAlignment="Right" Click="BtnRecarregarServidores_Click" />
                        </DockPanel>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Servidor Alvo / PoP de Destino:" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4" />
                                <ComboBox x:Name="CbServidores" FontSize="12" FontWeight="Bold" Padding="8,6" Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1" SelectionChanged="CbServidores_SelectionChanged" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Interface de Rede Local (Isolamento):" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4" />
                                <ComboBox x:Name="CbAdaptadoresRede" FontSize="12" FontWeight="Bold" Padding="8,6" Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1" />
                            </StackPanel>
                        </Grid>

                        <Border Background="#090D16" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="12,8">
                            <TextBlock x:Name="TxtInfoProximidade" Text="✦ Pré-teste habilitado: sondagem concorrente de latência e micro-vazão elegerá automaticamente o melhor servidor e preparará fallback em cascata." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- CARD 2: PAINEL DE INDICADORES DIGITAIS (HUD KPIs COM TOPO COLORIDO) -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- KPI 1: DOWNLOAD -->
                    <Border Grid.Column="0" Style="{StaticResource HudCardStyle}" Margin="0,0,8,0">
                        <Grid>
                            <Border Height="3" Background="#10B981" VerticalAlignment="Top" CornerRadius="10,10,0,0" />
                            <StackPanel Margin="14,14,14,12">
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="⬇ DOWNLOAD" FontWeight="Black" FontSize="11" Foreground="#10B981" DockPanel.Dock="Left" />
                                    <Border Background="#064E3B" CornerRadius="4" Padding="5,2" DockPanel.Dock="Right">
                                        <TextBlock Text="FASE 1" FontSize="9" FontWeight="Black" Foreground="#6EE7B7" />
                                    </Border>
                                </DockPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                    <TextBlock x:Name="TxtDownloadMbps" Text="0.0" FontWeight="Black" FontSize="30" Foreground="#FFFFFF" />
                                    <TextBlock Text=" Mbps" FontSize="13" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Bottom" Margin="4,0,0,5" />
                                </StackPanel>

                                <ProgressBar x:Name="PbDownload" Height="6" Background="#1E293B" Foreground="#10B981" BorderThickness="0" Value="0" Maximum="100" Margin="0,2,0,6" />
                                <TextBlock x:Name="TxtDownloadPico" Text="Pico: 0.0 Mbps" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- KPI 2: UPLOAD -->
                    <Border Grid.Column="1" Style="{StaticResource HudCardStyle}" Margin="0,0,8,0">
                        <Grid>
                            <Border Height="3" Background="#3B82F6" VerticalAlignment="Top" CornerRadius="10,10,0,0" />
                            <StackPanel Margin="14,14,14,12">
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="⬆ UPLOAD" FontWeight="Black" FontSize="11" Foreground="#3B82F6" DockPanel.Dock="Left" />
                                    <Border Background="#1E3A8A" CornerRadius="4" Padding="5,2" DockPanel.Dock="Right">
                                        <TextBlock Text="FASE 2" FontSize="9" FontWeight="Black" Foreground="#93C5FD" />
                                    </Border>
                                </DockPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                    <TextBlock x:Name="TxtUploadMbps" Text="0.0" FontWeight="Black" FontSize="30" Foreground="#FFFFFF" />
                                    <TextBlock Text=" Mbps" FontSize="13" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Bottom" Margin="4,0,0,5" />
                                </StackPanel>

                                <ProgressBar x:Name="PbUpload" Height="6" Background="#1E293B" Foreground="#3B82F6" BorderThickness="0" Value="0" Maximum="100" Margin="0,2,0,6" />
                                <TextBlock x:Name="TxtUploadPico" Text="Pico: 0.0 Mbps" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- KPI 3: LATÊNCIA & JITTER -->
                    <Border Grid.Column="2" Style="{StaticResource HudCardStyle}" Margin="0,0,8,0">
                        <Grid>
                            <Border Height="3" Background="#06B6D4" VerticalAlignment="Top" CornerRadius="10,10,0,0" />
                            <StackPanel Margin="14,14,14,12">
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="📶 LATÊNCIA &amp; RTT" FontWeight="Black" FontSize="11" Foreground="#06B6D4" DockPanel.Dock="Left" />
                                    <Border Background="#164E63" CornerRadius="4" Padding="5,2" DockPanel.Dock="Right">
                                        <TextBlock Text="TEMPO REAL" FontSize="9" FontWeight="Black" Foreground="#67E8F9" />
                                    </Border>
                                </DockPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                    <TextBlock x:Name="TxtLatenciaMs" Text="0" FontWeight="Black" FontSize="30" Foreground="#FFFFFF" />
                                    <TextBlock Text=" ms" FontSize="13" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Bottom" Margin="4,0,0,5" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                    <TextBlock Text="Jitter: " FontSize="10.5" Foreground="#64748B" />
                                    <TextBlock x:Name="TxtJitterMs" Text="0.0 ms" FontSize="10.5" FontWeight="Bold" Foreground="#E2E8F0" />
                                    <TextBlock Text=" • Perda: " FontSize="10.5" Foreground="#64748B" Margin="4,0,0,0" />
                                    <TextBlock x:Name="TxtPacketLoss" Text="0%" FontSize="10.5" FontWeight="Bold" Foreground="#E2E8F0" />
                                </StackPanel>

                                <TextBlock x:Name="TxtEficienciaRota" Text="Piso Fibra: ~1ms • Efic: 100%" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- KPI 4: BUFFERBLOAT -->
                    <Border Grid.Column="3" Style="{StaticResource HudCardStyle}">
                        <Grid>
                            <Border Height="3" Background="#A855F7" VerticalAlignment="Top" CornerRadius="10,10,0,0" />
                            <StackPanel Margin="14,14,14,12">
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="⚖ BUFFERBLOAT" FontWeight="Black" FontSize="11" Foreground="#A855F7" DockPanel.Dock="Left" />
                                    <Border Background="#581C87" CornerRadius="4" Padding="5,2" DockPanel.Dock="Right">
                                        <TextBlock Text="QUALIDADE" FontSize="9" FontWeight="Black" Foreground="#D8B4FE" />
                                    </Border>
                                </DockPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                    <TextBlock x:Name="TxtBufferbloatGrade" Text="—" FontWeight="Black" FontSize="30" Foreground="#10B981" />
                                    <TextBlock Text=" Grade" FontSize="13" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Bottom" Margin="4,0,0,5" />
                                </StackPanel>

                                <Border Background="#1E293B" CornerRadius="4" Padding="6,3" Margin="0,2,0,0">
                                    <TextBlock x:Name="TxtBufferbloatDesc" Text="Sob carga contínua" FontSize="10" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- CARD 3: GRÁFICO DINÂMICO DE VAZÃO COM PREENCHIMENTO EM GRADIENTE -->
                <Border Style="{StaticResource HudCardStyle}" Padding="16,12" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock Text="📈 CURVA TEMPORAL DE VAZÃO (TELEMETRIA EM TEMPO REAL)" FontWeight="Black" FontSize="11.5" Foreground="#38BDF8" />
                                <TextBlock Text="• Amostragem Contínua" FontSize="10.5" Foreground="#64748B" Margin="8,0,0,0" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border Background="#10B981" Width="9" Height="9" CornerRadius="4.5" Margin="0,0,5,0" />
                                <TextBlock Text="Download" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,14,0" />
                                <Border Background="#3B82F6" Width="9" Height="9" CornerRadius="4.5" Margin="0,0,5,0" />
                                <TextBlock Text="Upload" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                            </StackPanel>
                        </DockPanel>

                        <!-- CANVAS DO GRÁFICO COM ÁREA EM GRADIENTE -->
                        <Border Background="#060911" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Height="145" ClipToBounds="True">
                            <Grid>
                                <!-- Linhas de Grade e Escala -->
                                <Line X1="0" Y1="36" X2="1200" Y2="36" Stroke="#161F30" StrokeDashArray="3,3" StrokeThickness="1" />
                                <Line X1="0" Y1="72" X2="1200" Y2="72" Stroke="#161F30" StrokeDashArray="3,3" StrokeThickness="1" />
                                <Line X1="0" Y1="108" X2="1200" Y2="108" Stroke="#161F30" StrokeDashArray="3,3" StrokeThickness="1" />

                                <!-- Divisor Visual Download / Upload -->
                                <Rectangle HorizontalAlignment="Center" Width="1" Fill="#1E293B" StrokeDashArray="2,2" />

                                <!-- Superfície do Gráfico (Polígonos de Área + Linhas Neon) -->
                                <Canvas x:Name="CanvasGrafico">
                                    <!-- Área de Download preenchida com gradiente esmeralda -->
                                    <Polygon x:Name="PolygonDownloadArea" Opacity="0.32">
                                        <Polygon.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#10B981" Offset="0"/>
                                                <GradientStop Color="#0010B981" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Polygon.Fill>
                                    </Polygon>

                                    <!-- Área de Upload preenchida com gradiente azul elétrico -->
                                    <Polygon x:Name="PolygonUploadArea" Opacity="0.32">
                                        <Polygon.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#3B82F6" Offset="0"/>
                                                <GradientStop Color="#003B82F6" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Polygon.Fill>
                                    </Polygon>

                                    <!-- Curvas Neon de Alta Definição -->
                                    <Polyline x:Name="PolylineDownload" Stroke="#10B981" StrokeThickness="3.0" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <Polyline x:Name="PolylineUpload" Stroke="#38BDF8" StrokeThickness="3.0" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Canvas>

                                <!-- Text Overlay Centrado -->
                                <Border x:Name="OverlayContainer" Background="#99060911" CornerRadius="6" Padding="12,6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtOverlayGrafico" Text="Aguardando disparo do teste..." FontSize="12" Foreground="#64748B" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- CARD 4: TOPOLOGIA DE ROTA & FÍSICA DA FIBRA ÓPTICA -->
                <Border Style="{StaticResource HudCardStyle}" Padding="16,12" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="📍 TOPOLOGIA DE REDE &amp; PROPAGAÇÃO EM FIBRA ÓPTICA" FontWeight="Black" FontSize="11.5" Foreground="#38BDF8" DockPanel.Dock="Left" />
                            <TextBlock Text="Piso Teórico: 1 ms RTT a cada ~78 km de Fibra Sílica" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Right" />
                        </DockPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Origem (Cliente / Link Testado) -->
                            <Border Grid.Column="0" Background="#090D16" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="💻 CLIENTE (LINK TESTADO)" FontWeight="Black" FontSize="10.5" Foreground="#38BDF8" DockPanel.Dock="Left" />
                                        <Border Background="#1E293B" CornerRadius="4" Padding="5,2" DockPanel.Dock="Right">
                                            <TextBlock Text="ORIGEM" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" />
                                        </Border>
                                    </DockPanel>
                                    <TextBlock x:Name="TxtGeoIpPublico" Text="IP: Identificando..." FontSize="11.5" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,2" />
                                    <TextBlock x:Name="TxtGeoAsn" Text="ASN: ..." FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2" />
                                    <TextBlock x:Name="TxtGeoLocalidade" Text="Localidade: ..." FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2" />
                                    <TextBlock x:Name="TxtGeoCoordenadas" Text="GPS: ..." FontSize="10.5" Foreground="#64748B" />
                                </StackPanel>
                            </Border>

                            <!-- Barra Central: Propagação Óptica e Distância -->
                            <Border Grid.Column="1" Background="#090D16" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14,8" VerticalAlignment="Center" Margin="12,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="⚡" FontSize="18" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,0,0,2" />
                                    <TextBlock x:Name="TxtDistanciaKm" Text="~ km" FontSize="12.5" FontWeight="Black" Foreground="#38BDF8" HorizontalAlignment="Center" />
                                    <TextBlock Text="Distância Haversine" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Destino (Datacenter / Servidor Alvo) -->
                            <Border Grid.Column="2" Background="#090D16" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="🏢 SERVIDOR ALVO / POP" FontWeight="Black" FontSize="10.5" Foreground="#A855F7" DockPanel.Dock="Left" />
                                        <Border Background="#1E293B" CornerRadius="4" Padding="5,2" DockPanel.Dock="Right">
                                            <TextBlock Text="DESTINO" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" />
                                        </Border>
                                    </DockPanel>
                                    <TextBlock x:Name="TxtGeoServidor" Text="Servidor: ..." FontSize="11.5" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,2" />
                                    <TextBlock x:Name="TxtGeoPoP" Text="PoP Datacenter: ..." FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2" />
                                    <TextBlock x:Name="TxtGeoServidorLocal" Text="Cidade: ..." FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2" />
                                    <TextBlock x:Name="TxtGeoTecnologia" Text="Protocolo: Cloudflare Speed / HTTP Stream" FontSize="10.5" Foreground="#64748B" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- CARD 5: LOG DE EXECUÇÃO & RESILIÊNCIA EM CADEIA -->
                <Border Style="{StaticResource HudCardStyle}" Padding="14,10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="📜 LOG DE RESILIÊNCIA &amp; AUDITORIA TÉCNICA" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" DockPanel.Dock="Left" />
                            <TextBlock x:Name="TxtLogStatus" Text="Sistema em espera" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right" />
                        </DockPanel>
                        <TextBox x:Name="TxtLog" Height="85" Background="#060911" Foreground="#94A3B8" FontFamily="Consolas, 'Courier New', monospace" FontSize="11" BorderThickness="1" BorderBrush="#1E293B" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Padding="6" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ================= 2: RODAPÉ DE AÇÕES MODERNIZADO ================= -->
        <Border Grid.Row="2" Style="{StaticResource HudCardStyle}" Padding="16,12" Margin="0,12,0,0">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <!-- Botão Primário com Gradiente Roxo/Índigo -->
                    <Button x:Name="BtnIniciarTeste" Content="🚀 INICIAR TESTE DE BANDA LARGA" Style="{StaticResource ModernGradientButtonStyle}" Padding="20,10" FontSize="13" Click="BtnIniciarTeste_Click">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#7C3AED" Offset="0"/>
                                <GradientStop Color="#4F46E5" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>

                    <Button x:Name="BtnCancelar" Content="🛑 Cancelar" Style="{StaticResource ModernGradientButtonStyle}" Padding="14,10" Margin="10,0,0,0" Background="#334155" FontSize="12" IsEnabled="False" Click="BtnCancelar_Click" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <!-- Botão de Relatório com Gradiente Ciano/Azul -->
                    <Button x:Name="BtnGerarRelatorioPdf" Content="📄 Emitir Relatório PDF Executivo" Style="{StaticResource ModernGradientButtonStyle}" Padding="16,10" FontSize="12" IsEnabled="False" Click="BtnGerarRelatorioPdf_Click" ToolTip="Gera o laudo oficial em PDF com gráficos vetoriais de vazão e física da fibra">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#0284C7" Offset="0"/>
                                <GradientStop Color="#0369A1" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>

                    <Button x:Name="BtnAbrirPasta" Content="📂 Abrir Pasta" Style="{StaticResource ModernGradientButtonStyle}" Padding="12,10" Margin="10,0,0,0" Background="#1E293B" Foreground="#F8FAFC" FontSize="12" Click="BtnAbrirPasta_Click" />
                    <Button x:Name="BtnFechar" Content="Fechar" Style="{StaticResource ModernGradientButtonStyle}" Padding="14,10" Margin="10,0,0,0" Background="#1E293B" Foreground="#94A3B8" FontSize="12" Click="BtnFechar_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

    </Grid>
</Window>
